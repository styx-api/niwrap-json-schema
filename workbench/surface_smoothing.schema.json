{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SURFACE SMOOTHING",
  "description": "Smooths a surface by averaging vertex coordinates with those of the neighboring vertices.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/surface_smoothing"
    },
    "surface_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the surface file to smooth"
    },
    "smoothing_strength": {
      "type": "number",
      "description": "smoothing strength (ranges [0.0 - 1.0])"
    },
    "smoothing_iterations": {
      "type": "integer",
      "description": "smoothing iterations"
    },
    "surface_out": {
      "type": "string",
      "description": "output surface file"
    }
  },
  "required": [
    "@type",
    "surface_in",
    "smoothing_strength",
    "smoothing_iterations",
    "surface_out"
  ]
}