{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MERGE TWO SPEC FILES INTO ONE",
  "description": "The output spec file contains every file that is in either of the input spec files.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/spec_file_merge"
    },
    "spec_1": {
      "type": "string",
      "description": "first spec file to merge"
    },
    "spec_2": {
      "type": "string",
      "description": "second spec file to merge"
    },
    "out_spec": {
      "type": "string",
      "description": "output - output spec file"
    }
  },
  "required": [
    "@type",
    "spec_1",
    "spec_2",
    "out_spec"
  ]
}