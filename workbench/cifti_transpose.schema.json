{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRANSPOSE A CIFTI FILE",
  "description": "The input must be a 2-dimensional cifti file.  The output is a cifti file where every row in the input is a column in the output.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/cifti_transpose"
    },
    "cifti_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the input cifti file"
    },
    "cifti_out": {
      "type": "string",
      "description": "the output cifti file"
    },
    "mem_limit": {
      "type": "number",
      "description": "restrict memory usage"
    }
  },
  "required": [
    "@type",
    "cifti_in",
    "cifti_out"
  ]
}