{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "OUTPUT VERTEX NORMALS AS METRIC FILE",
  "description": "Computes the normal vectors of the surface file, and outputs them as a 3 column metric file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "metric_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the normal vectors"
    }
  },
  "required": [
    "root",
    "metric_out"
  ]
}