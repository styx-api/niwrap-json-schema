{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FILL HOLES IN AN ROI VOLUME",
  "description": "Finds all face-connected parts that are not included in the ROI, and fills all but the largest one with ones.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/volume_fill_holes"
    },
    "volume_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the input ROI volume"
    },
    "volume_out": {
      "type": "string",
      "description": "the output ROI volume"
    }
  },
  "required": [
    "@type",
    "volume_in",
    "volume_out"
  ]
}