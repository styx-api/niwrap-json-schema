{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MEASURE SURFACE AREA EACH VERTEX IS RESPONSIBLE FOR",
  "description": "Each vertex gets one third of the area of each triangle it is a part of.  Units are mm^2.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/surface_vertex_areas"
    },
    "surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the surface to measure"
    },
    "metric": {
      "type": "string",
      "description": "the output metric"
    }
  },
  "required": [
    "@type",
    "surface",
    "metric"
  ]
}