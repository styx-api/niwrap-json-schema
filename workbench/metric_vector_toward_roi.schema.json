{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FIND IF VECTORS POINT TOWARD AN ROI",
  "description": "At each vertex, compute the vector along the start of the shortest path to the ROI.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/metric_vector_toward_roi"
    },
    "surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the surface to compute on"
    },
    "target_roi": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the roi to find the shortest path to"
    },
    "metric_out": {
      "type": "string",
      "description": "the output metric"
    },
    "roi": {
      "type": "string",
      "x-styx-type": "path",
      "description": "don't compute for vertices outside an roi"
    }
  },
  "required": [
    "@type",
    "surface",
    "target_roi",
    "metric_out"
  ]
}