{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADD PREFIX TO ALL LABEL NAMES IN A GIFTI LABEL FILE",
  "description": "For each label other than '???', prepend <prefix> to the label name.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/gifti_label_add_prefix"
    },
    "label_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the input label file"
    },
    "prefix": {
      "type": "string",
      "description": "the prefix string to add"
    },
    "label_out": {
      "type": "string",
      "description": "the output label file"
    }
  },
  "required": [
    "@type",
    "label_in",
    "prefix",
    "label_out"
  ]
}