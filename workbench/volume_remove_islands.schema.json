{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REMOVE ISLANDS FROM AN ROI VOLUME",
  "description": "Finds all face-connected parts of the ROI, and zeros out all but the largest one.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/volume_remove_islands"
    },
    "volume_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the input ROI volume"
    },
    "volume_out": {
      "type": "string",
      "description": "the output ROI volume"
    }
  },
  "required": [
    "@type",
    "volume_in",
    "volume_out"
  ]
}