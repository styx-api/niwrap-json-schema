{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "CREATE A BLANK VOLUME FILE",
  "description": "Creates a volume file full of zeros.  Exactly one of -plumb or -sform must be specified.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "volume_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the output volume"
    }
  },
  "required": [
    "root",
    "volume_out"
  ]
}