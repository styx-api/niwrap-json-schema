{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REPLACE A STRING IN ALL METADATA OF A FILE",
  "description": "Replaces all occurrences of <find-string> in the metadata and map names of <input-file> with <replace-string>.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/metadata_string_replace"
    },
    "input_file": {
      "type": "string",
      "description": "the file to replace metadata in"
    },
    "find_string": {
      "type": "string",
      "description": "the string to find"
    },
    "replace_string": {
      "type": "string",
      "description": "the string to replace <find-string> with"
    },
    "output_file": {
      "type": "string",
      "description": "output - the name to save the modified file as"
    },
    "case_insensitive": {
      "type": "boolean",
      "description": "match with case variation also",
      "default": false
    }
  },
  "required": [
    "@type",
    "input_file",
    "find_string",
    "replace_string",
    "output_file"
  ]
}