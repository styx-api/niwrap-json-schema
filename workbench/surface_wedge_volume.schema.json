{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MEASURE PER-VERTEX VOLUME BETWEEN SURFACES",
  "description": "Compute the volume of each vertex's area from one surface to another.  The surfaces must have vertex correspondence, and have consistent triangle orientation.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/surface_wedge_volume"
    },
    "inner_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the inner surface"
    },
    "outer_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the outer surface"
    },
    "metric": {
      "type": "string",
      "description": "the output metric"
    }
  },
  "required": [
    "@type",
    "inner_surface",
    "outer_surface",
    "metric"
  ]
}