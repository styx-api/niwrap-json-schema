{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "MAKE METRIC FILE OF SURFACE COORDINATES",
  "description": "Puts the coordinates of the surface into a 3-map metric file, as x, y, z.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "metric_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the output metric"
    }
  },
  "required": [
    "root",
    "metric_out"
  ]
}