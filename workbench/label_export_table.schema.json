{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXPORT LABEL TABLE FROM GIFTI AS TEXT",
  "description": "Takes the label table from the gifti label file, and writes it to a text format matching what is expected by -metric-label-import.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/label_export_table"
    },
    "label_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the input label file"
    },
    "table_out": {
      "type": "string",
      "description": "output - the output text file"
    },
    "hierarchy": {
      "type": "string",
      "description": "export the hierarchy as json"
    }
  },
  "required": [
    "@type",
    "label_in",
    "table_out"
  ]
}