{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ADD PREFIX TO ALL LABEL NAMES IN A GIFTI LABEL FILE",
  "description": "For each label other than '???', prepend <prefix> to the label name.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "label_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the output label file"
    }
  },
  "required": [
    "root",
    "label_out"
  ]
}