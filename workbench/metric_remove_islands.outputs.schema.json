{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "REMOVE ISLANDS FROM AN ROI METRIC",
  "description": "Finds all connected areas in the ROI, and zeros out all but the largest one, in terms of surface area.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "metric_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the output ROI metric"
    }
  },
  "required": [
    "root",
    "metric_out"
  ]
}