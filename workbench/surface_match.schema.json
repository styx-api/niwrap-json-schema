{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SURFACE MATCH",
  "description": "The Input Surface File will be transformed so that its coordinate ranges (bounding box) match that of the Match Surface File",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/surface_match"
    },
    "match_surface_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Match (Reference) Surface"
    },
    "input_surface_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing surface that will be transformed"
    },
    "output_surface_name": {
      "type": "string",
      "description": "Surface File after transformation"
    }
  },
  "required": [
    "@type",
    "match_surface_file",
    "input_surface_file",
    "output_surface_name"
  ]
}