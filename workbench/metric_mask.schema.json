{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MASK A METRIC FILE",
  "description": "By default, the output metric is a copy of the input metric, but with zeros wherever the mask metric is zero or negative.  if -column is specified, the output contains only one column, the masked version of the specified input column.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/metric_mask"
    },
    "metric": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the input metric"
    },
    "mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the mask metric"
    },
    "metric_out": {
      "type": "string",
      "description": "the output metric"
    },
    "column": {
      "type": "string",
      "description": "select a single column"
    }
  },
  "required": [
    "@type",
    "metric",
    "mask",
    "metric_out"
  ]
}