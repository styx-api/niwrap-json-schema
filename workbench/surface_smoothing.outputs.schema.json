{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "SURFACE SMOOTHING",
  "description": "Smooths a surface by averaging vertex coordinates with those of the neighboring vertices.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "surface_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "output surface file"
    }
  },
  "required": [
    "root",
    "surface_out"
  ]
}