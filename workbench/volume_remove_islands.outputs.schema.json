{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "REMOVE ISLANDS FROM AN ROI VOLUME",
  "description": "Finds all face-connected parts of the ROI, and zeros out all but the largest one.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "volume_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the output ROI volume"
    }
  },
  "required": [
    "root",
    "volume_out"
  ]
}