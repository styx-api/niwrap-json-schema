{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAKE METRIC ROIS FROM BORDERS",
  "description": "By default, draws ROIs inside all borders in the border file, as separate metric columns.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/border_to_rois"
    },
    "surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the surface the borders are drawn on"
    },
    "border_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the border file"
    },
    "metric_out": {
      "type": "string",
      "description": "the output metric file"
    },
    "border": {
      "type": "string",
      "description": "create ROI for only one border"
    },
    "inverse": {
      "type": "boolean",
      "description": "use inverse selection (outside border)",
      "default": false
    },
    "include_border": {
      "type": "boolean",
      "description": "include vertices the border is closest to",
      "default": false
    }
  },
  "required": [
    "@type",
    "surface",
    "border_file",
    "metric_out"
  ]
}