{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXPORT LABEL TABLE FROM CIFTI AS TEXT",
  "description": "Takes the label table from the cifti label map, and writes it to a text format matching what is expected by -cifti-label-import.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "workbench/cifti_label_export_table"
    },
    "label_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "the input cifti label file"
    },
    "map": {
      "type": "string",
      "description": "the number or name of the label map to use"
    },
    "table_out": {
      "type": "string",
      "description": "output - the output text file"
    },
    "hierarchy": {
      "type": "string",
      "description": "export the hierarchy as json"
    }
  },
  "required": [
    "@type",
    "label_in",
    "map",
    "table_out"
  ]
}