{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "antsBrainExtraction.sh",
  "description": "antsBrainExtraction.sh performs template-based brain extraction using N4 bias correction, registration, and Atropos segmentation.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "brain_extracted_image": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Brain extracted image"
    },
    "brain_mask": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Brain extraction mask"
    },
    "brain_segmentation": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Brain segmentation (tissue classification)"
    },
    "csf_segmentation": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Cerebrospinal fluid segmentation"
    },
    "gm_segmentation": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Gray matter segmentation"
    },
    "wm_segmentation": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "White matter segmentation"
    },
    "generic_affine": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Generic affine transform from registration"
    },
    "warp_field": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Warp field from registration"
    },
    "inverse_warp_field": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Inverse warp field from registration"
    }
  },
  "required": [
    "root",
    "brain_extracted_image",
    "brain_mask",
    "brain_segmentation",
    "csf_segmentation",
    "gm_segmentation",
    "wm_segmentation",
    "generic_affine",
    "warp_field",
    "inverse_warp_field"
  ]
}