{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "CreateWarpedGridImage",
  "description": "Create a warped grid image based on the specified deformation field.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "warped_grid_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The resultant warped grid image."
    }
  },
  "required": [
    "root",
    "warped_grid_image"
  ]
}