{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "antsAI",
  "description": "Program to calculate the optimal linear transform parameters for aligning two images.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_transform": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The output transform file."
    }
  },
  "required": [
    "root",
    "output_transform"
  ]
}