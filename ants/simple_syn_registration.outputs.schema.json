{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "simpleSynRegistration",
  "description": "A simple SyN registration tool.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "registered_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The output registered image."
    },
    "transform_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The output transformation matrix."
    }
  },
  "required": [
    "root",
    "registered_image",
    "transform_matrix"
  ]
}