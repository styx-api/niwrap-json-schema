{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "antsRegistrationSyN.sh",
  "description": "Script for simplified symmetric image registration using ANTs.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "affine_transform": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Affine transformation matrix for registration"
    },
    "inverse_warp": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Inverse warp field for registration"
    },
    "forward_warp": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Forward warp field for registration"
    }
  },
  "required": [
    "root",
    "affine_transform",
    "inverse_warp",
    "forward_warp"
  ]
}