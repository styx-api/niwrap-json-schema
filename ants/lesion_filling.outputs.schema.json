{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "LesionFilling",
  "description": "A tool for filling lesions in T1 images using a mask.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "lesion_filled_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output image with filled lesions."
    }
  },
  "required": [
    "root",
    "lesion_filled_output"
  ]
}