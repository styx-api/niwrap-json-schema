{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ConvertToJpg",
  "description": "A tool to convert NIfTI images to JPG format.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_jpg": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The converted JPG image."
    }
  },
  "required": [
    "root",
    "output_jpg"
  ]
}