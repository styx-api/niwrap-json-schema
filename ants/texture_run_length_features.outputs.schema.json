{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "TextureRunLengthFeatures",
  "description": "A tool to calculate texture run length features on an input image.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "short_run_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Short Run Emphasis."
    },
    "long_run_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Long Run Emphasis."
    },
    "grey_level_nonuniformity": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Grey Level Nonuniformity."
    },
    "run_length_nonuniformity": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Run Length Nonuniformity."
    },
    "low_grey_level_run_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Low Grey Level Run Emphasis."
    },
    "high_grey_level_run_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: High Grey Level Run Emphasis."
    },
    "short_run_low_grey_level_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Short Run Low Grey Level Emphasis."
    },
    "short_run_high_grey_level_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Short Run High Grey Level Emphasis."
    },
    "long_run_low_grey_level_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Long Run Low Grey Level Emphasis."
    },
    "long_run_high_grey_level_emphasis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output feature: Long Run High Grey Level Emphasis."
    }
  },
  "required": [
    "root",
    "short_run_emphasis",
    "long_run_emphasis",
    "grey_level_nonuniformity",
    "run_length_nonuniformity",
    "low_grey_level_run_emphasis",
    "high_grey_level_run_emphasis",
    "short_run_low_grey_level_emphasis",
    "short_run_high_grey_level_emphasis",
    "long_run_low_grey_level_emphasis",
    "long_run_high_grey_level_emphasis"
  ]
}