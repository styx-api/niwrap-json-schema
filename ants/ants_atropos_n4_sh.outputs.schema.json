{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "antsAtroposN4.sh",
  "description": "antsAtroposN4.sh iterates between N4 <-> Atropos to improve segmentation results.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "n4_corrected": {
      "type": "string",
      "x-styx-type": "path",
      "description": "N4 corrected image."
    },
    "segmentation": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Segmentation image."
    },
    "segmentation_posteriors": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Segmentation posteriors image."
    }
  },
  "required": [
    "root",
    "n4_corrected",
    "segmentation",
    "segmentation_posteriors"
  ]
}