{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "antsNeuroimagingBattery",
  "description": "Align MR modalities to a common within-subject (and optional template) space.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_directory": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Directory containing output transform files."
    }
  },
  "required": [
    "root",
    "output_directory"
  ]
}