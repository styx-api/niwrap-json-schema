{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "simpleSynRegistration",
  "description": "A simple SyN registration tool.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "ants/simpleSynRegistration"
    },
    "fixed_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The fixed image for registration.",
      "title": "Fixed Image"
    },
    "moving_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The moving image to be registered.",
      "title": "Moving Image"
    },
    "initial_transform": {
      "type": "string",
      "description": "The initial transform for registration.",
      "title": "Initial Transform"
    },
    "output_prefix": {
      "type": "string",
      "description": "Prefix for the output file name without any extension.",
      "title": "Output Prefix"
    }
  },
  "required": [
    "@type",
    "fixed_image",
    "moving_image",
    "initial_transform",
    "output_prefix"
  ]
}