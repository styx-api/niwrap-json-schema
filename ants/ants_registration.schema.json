                  "gradient_step": {
                    "type": "number"
                  }
                },
                "required": [
                  "@type",
                  "gradient_step"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "@type": {
                    "const": "transform_bspline"
                  },
                  "gradient_step": {
                    "type": "number"
                  },
                  "mesh_size_at_base_level": {
                    "type": "number"
                  }
                },
                "required": [
                  "@type",
                  "gradient_step",
                  "mesh_size_at_base_level"
                ]
              },
              {
                "type": "object",
                "properties": {
