              },
              {
                "type": "object",
                "properties": {
                  "@type": {
                    "const": "transform_affine"
                  },
                  "gradient_step": {
                    "type": "number"
                  }
                },
                "required": [
                  "@type",
                  "gradient_step"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "@type": {
                    "const": "transform_composite_affine"
                  },
                  "gradient_step": {
                    "type": "number"
                  }
                },
                "required": [
                  "@type",
                  "gradient_step"
                ]
              },
              {
