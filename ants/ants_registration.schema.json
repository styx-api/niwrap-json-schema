              },
              {
                "type": "object",
                "properties": {
                  "@type": {
                    "const": "transform_syn"
                  },
                  "gradient_step": {
                    "type": "number"
                  },
                  "update_field_variance_in_voxel_space": {
                    "type": "object",
                    "properties": {
                      "update_field_variance_in_voxel_space_value": {
                        "type": "number"
                      },
                      "total_field_variance_in_voxel_space": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "update_field_variance_in_voxel_space_value"
                    ]
                  }
                },
                "required": [
                  "@type",
                  "gradient_step"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "@type": {
                    "const": "transform_bspline_syn"
