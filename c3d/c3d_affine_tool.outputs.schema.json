{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "c3d_affine_tool",
  "description": "RAS affine transform tool",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "itk_transform_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output ITK transform file."
    },
    "irtk_transform_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output IRTK transform file."
    },
    "matrix_transform_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Write output matrix."
    }
  },
  "required": [
    "root",
    "itk_transform_outfile",
    "irtk_transform_outfile",
    "matrix_transform_outfile"
  ]
}