{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mrdump",
  "description": "Print out the values within an image.\n\nIf no destination file is specified, the voxel locations will be printed to stdout.\n\nReferences:\n\n",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "the (optional) output text file."
    }
  },
  "required": [
    "root",
    "output"
  ]
}