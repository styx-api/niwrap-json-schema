{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "histo_compute_joint_density",
  "description": "A tool to compute the joint density of two volumes.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/histo_compute_joint_density"
    },
    "volume1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume 1",
      "title": "Volume 1"
    },
    "volume2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume 2",
      "title": "Volume 2"
    },
    "joint_density_file": {
      "type": "string",
      "description": "Output joint density file",
      "title": "Joint Density File"
    }
  },
  "required": [
    "@type",
    "volume1",
    "volume2",
    "joint_density_file"
  ]
}