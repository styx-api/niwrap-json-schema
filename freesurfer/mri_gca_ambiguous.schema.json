{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_gca_ambiguous",
  "description": "This program computes an ambiguity measure across a GCA and outputs an MR image of it",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_gca_ambiguous"
    },
    "gca_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The input GCA file",
      "title": "GCA file"
    },
    "output_volume": {
      "type": "string",
      "description": "The output MR image file",
      "title": "Output volume"
    }
  },
  "required": [
    "@type",
    "gca_file",
    "output_volume"
  ]
}