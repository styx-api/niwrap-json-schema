{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "label2flat",
  "description": "A tool used in FreeSurfer to process labeling and patch files.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/label2flat"
    },
    "subject_name": {
      "type": "string",
      "description": "The name of the subject.",
      "title": "Subject Name"
    },
    "label_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The label file path.",
      "title": "Label File"
    },
    "patch_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The patch file path.",
      "title": "Patch File"
    },
    "output_file": {
      "type": "string",
      "description": "The output file path.",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "subject_name",
    "label_file",
    "patch_file",
    "output_file"
  ]
}