{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "labels_intersect",
  "description": "Tool to find the intersection of two label files",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/labels_intersect"
    },
    "label1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First input label file",
      "title": "Label 1"
    },
    "label2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Second input label file",
      "title": "Label 2"
    },
    "outputname": {
      "type": "string",
      "description": "Output label file name",
      "title": "Output Name"
    }
  },
  "required": [
    "@type",
    "label1",
    "label2",
    "outputname"
  ]
}