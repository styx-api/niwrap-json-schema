{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_convert",
  "description": "This program will convert MRI-surface data formats.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "converted_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output converted surface file"
    }
  },
  "required": [
    "root",
    "converted_surface"
  ]
}