{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_xvolavg",
  "description": "Tool to average multiple volumes together (including 4D volumes).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "averaged_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The averaged output volume."
    }
  },
  "required": [
    "root",
    "averaged_output"
  ]
}