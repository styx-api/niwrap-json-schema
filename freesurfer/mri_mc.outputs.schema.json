{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_mc",
  "description": "Extract a surface from a label volume using Marching Cubes algorithm.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "extracted_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The extracted surface output file."
    }
  },
  "required": [
    "root",
    "extracted_surface"
  ]
}