{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_z2p",
  "description": "Converts Z-statistic volumes to P-value volumes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_p_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output P volume file."
    },
    "output_sig_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output significance volume file."
    }
  },
  "required": [
    "root",
    "output_p_volume",
    "output_sig_volume"
  ]
}