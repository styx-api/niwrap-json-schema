{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_log_likelihood",
  "description": "MRI log likelihood calculation tool for brain images.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_log_likelihood"
    },
    "input_brain_images": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "List of input brain images",
      "title": "Input Brain Images"
    },
    "atlas_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Atlas image file",
      "title": "Atlas File"
    },
    "transform_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transform file for registration",
      "title": "Transform File"
    }
  },
  "required": [
    "@type",
    "input_brain_images",
    "atlas_file",
    "transform_file"
  ]
}