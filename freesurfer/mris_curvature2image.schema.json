{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_curvature2image",
  "description": "Tool to convert surface curvature data to an image using FreeSurfer.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_curvature2image"
    },
    "surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file.",
      "title": "Surface File"
    },
    "mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input mask file.",
      "title": "Mask File"
    },
    "output_overlay": {
      "type": "string",
      "description": "Output overlay image file.",
      "title": "Output Overlay Image"
    },
    "output_distance": {
      "type": "string",
      "description": "Output distance image file.",
      "title": "Output Distance Image"
    },
    "overlay": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Overlay file.",
      "title": "Overlay File"
    },
    "label": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Label file.",
      "title": "Label File"
    },
    "invert_flag": {
      "type": "boolean",
      "description": "Flag to invert the curvature values.",
      "title": "Invert Flag",
      "default": false
    },
    "radius": {
      "type": "number",
      "description": "Radius value for processing.",
      "title": "Radius"
    }
  },
  "required": [
    "@type",
    "surface",
    "mask",
    "output_overlay",
    "output_distance",
    "overlay",
    "label",
    "radius"
  ]
}