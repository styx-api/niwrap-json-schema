{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "seg2filled",
  "description": "Creates a filled.mgz from an aseg-style segmentation using SAMSEG segmentation.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_filled_mgz": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The output filled MGZ file."
    }
  },
  "required": [
    "root",
    "out_filled_mgz"
  ]
}