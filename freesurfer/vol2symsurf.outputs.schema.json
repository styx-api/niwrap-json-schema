{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "vol2symsurf",
  "description": "A tool that samples a volume onto the surface of the left-right symmetric subject (fsaverage_sym).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_lh": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output for left hemisphere"
    },
    "output_rh": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output for right hemisphere"
    },
    "output_lh_rh_difference": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output for left-right hemisphere difference"
    },
    "output_li_difference": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output for laterality index"
    }
  },
  "required": [
    "root",
    "output_lh",
    "output_rh",
    "output_lh_rh_difference",
    "output_li_difference"
  ]
}