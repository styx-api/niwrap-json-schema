{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_thickness_diff",
  "description": "Computes the difference of two surface data sets defined on two surface meshes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_difference": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file with the difference mapped onto the surface"
    },
    "output_resampled": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Resampled output thickness file"
    }
  },
  "required": [
    "root",
    "output_difference",
    "output_resampled"
  ]
}