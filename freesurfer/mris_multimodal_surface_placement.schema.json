{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_multimodal_surface_placement",
  "description": "FreeSurfer command for multimodal surface placement",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_multimodal_surface_placement"
    },
    "input_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file",
      "title": "Input Surface"
    },
    "output_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output surface file",
      "title": "Output Surface"
    },
    "sphere_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Sphere surface file",
      "title": "Sphere Surface"
    },
    "normals": {
      "type": "string",
      "description": "Normals file in VTK format",
      "title": "Normals VTK"
    },
    "values": {
      "type": "string",
      "description": "Values file in VTK format",
      "title": "Values VTK"
    },
    "debug_vertex": {
      "type": "number",
      "description": "Debug vertex index",
      "title": "Debug Vertex"
    },
    "step_size": {
      "type": "number",
      "description": "Step size",
      "title": "Step Size"
    },
    "number_of_steps": {
      "type": "number",
      "description": "Number of steps",
      "title": "Number of Steps"
    },
    "gradient_sigma": {
      "type": "number",
      "description": "Gradient sigma value",
      "title": "Gradient Sigma"
    },
    "aseg_aparc": {
      "type": "string",
      "x-styx-type": "path",
      "description": "ASEG APARC image file",
      "title": "ASEG APARC"
    },
    "white_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "White surface file",
      "title": "White Surface"
    },
    "prob_of_csf": {
      "type": "number",
      "description": "Probability of CSF",
      "title": "Probability of CSF"
    },
    "t1_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "T1-weighted image file",
      "title": "T1 Image"
    },
    "t2_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "T2-weighted image file",
      "title": "T2 Image"
    },
    "flair_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "FLAIR image file",
      "title": "FLAIR Image"
    },
    "min_max": {
      "type": "boolean",
      "description": "Toggle between min or max operation",
      "title": "Min/Max Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "input_surface",
    "output_surface",
    "sphere_surface",
    "normals",
    "values",
    "step_size",
    "number_of_steps",
    "gradient_sigma",
    "aseg_aparc",
    "white_surface",
    "prob_of_csf",
    "t1_image",
    "t2_image",
    "flair_image"
  ]
}