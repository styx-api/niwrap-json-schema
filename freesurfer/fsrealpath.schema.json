{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fsrealpath",
  "description": "Resolve symbolic links in a path.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/fsrealpath"
    },
    "path": {
      "type": "string",
      "description": "The path to resolve",
      "title": "Path"
    },
    "help": {
      "type": "boolean",
      "description": "Show this help message and exit",
      "title": "Help flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "path"
  ]
}