{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_segment_thalamic_nuclei_dti_cnn",
  "description": "Thalamic segmentation tool providing 0.7mm isotropic thalamus segmentation from registered T1, FA, and V1 volumes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "segmentation_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Path to the segmentation output."
    },
    "volume_csv": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "CSV file with volumes for all structures."
    },
    "posteriors": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Path to the posteriors output."
    }
  },
  "required": [
    "root",
    "segmentation_output",
    "volume_csv",
    "posteriors"
  ]
}