{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "xcorr",
  "description": "Computes the voxel-for-voxel correlation coefficient between two volumes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_xcorrfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output xcorr file"
    },
    "log_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Log of xcorr execution"
    }
  },
  "required": [
    "root",
    "out_xcorrfile",
    "log_output"
  ]
}