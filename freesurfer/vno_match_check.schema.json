{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vno_match_check",
  "description": "Checks that all surfaces and surface data files for a subject have the same number of vertices.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/vno_match_check"
    },
    "subjid": {
      "type": "string",
      "description": "Subject ID for which the vertex number check is performed",
      "title": "Subject ID"
    },
    "debug": {
      "type": "boolean",
      "description": "Prints progress text",
      "title": "Debug Flag",
      "default": false
    },
    "right_hemi": {
      "type": "boolean",
      "description": "Checks only the right hemisphere",
      "title": "Right Hemisphere Flag",
      "default": false
    },
    "left_hemi": {
      "type": "boolean",
      "description": "Checks only the left hemisphere",
      "title": "Left Hemisphere Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "subjid"
  ]
}