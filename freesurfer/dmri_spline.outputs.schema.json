{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dmri_spline",
  "description": "Tool for interpolating and analyzing splines within a defined mask",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output volume of the interpolated spline"
    },
    "out_points_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output text file with interpolated spline points"
    },
    "out_tangent_vectors": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output text file containing tangent vectors"
    },
    "out_normal_vectors": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output text file containing normal vectors"
    },
    "out_curvature": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output text file containing curvatures"
    }
  },
  "required": [
    "root",
    "out_volume",
    "out_points_file",
    "out_tangent_vectors",
    "out_normal_vectors",
    "out_curvature"
  ]
}