{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_map_cuts",
  "description": "Tool for mapping cortical surface data onto cuts.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_map_cuts"
    },
    "input_patch": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input patch file",
      "title": "Input Patch"
    },
    "output_patch": {
      "type": "string",
      "description": "Output patch file",
      "title": "Output Patch"
    }
  },
  "required": [
    "@type",
    "input_patch",
    "output_patch"
  ]
}