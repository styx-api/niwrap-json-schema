{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "applyMorph",
  "description": "A tool for applying a morph to a volume using a template and a transform",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/applyMorph"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "Input files.",
      "title": "Inputs"
    },
    "template": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Template volume.",
      "title": "Template"
    },
    "transform": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transform file.",
      "title": "Transform"
    },
    "zlib_buffer": {
      "type": "number",
      "description": "Zlib buffer pre-allocation multiplier.",
      "title": "Zlib Buffer Multiplier"
    },
    "dbg_coords": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Debugging coordinates.",
      "title": "Debugging Coordinates"
    }
  },
  "required": [
    "@type",
    "inputs",
    "template",
    "transform"
  ]
}