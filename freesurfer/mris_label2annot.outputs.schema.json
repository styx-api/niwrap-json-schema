{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_label2annot",
  "description": "Converts a set of surface labels to an annotation file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "annot_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated annotation file"
    }
  },
  "required": [
    "root",
    "annot_file"
  ]
}