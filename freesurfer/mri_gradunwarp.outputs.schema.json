{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_gradunwarp",
  "description": "Tool to correct gradient non-linearity distortions in MRI images.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "unwarped_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Unwarped output volume or surface"
    },
    "output_transform_table": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved unwarp transform table in m3z format"
    }
  },
  "required": [
    "root",
    "unwarped_output",
    "output_transform_table"
  ]
}