{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "t4img_4dfp",
  "description": "Transforms a 4dfp image using a specified t4 file.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/t4img_4dfp"
    },
    "t4file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformation matrix file (t4 file format).",
      "title": "T4 File"
    },
    "imgfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input image file (4dfp format).",
      "title": "Input Image File"
    },
    "outfile": {
      "type": "string",
      "description": "Output image file (optional, defaults to <imgfile>t if not provided).",
      "title": "Output Image File"
    }
  },
  "required": [
    "@type",
    "t4file",
    "imgfile"
  ]
}