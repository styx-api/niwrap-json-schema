{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tksurfer",
  "description": "3D visualization tool for cortical surface models (part of FreeSurfer)",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/tksurfer"
    },
    "subject_id": {
      "type": "string",
      "description": "Subject identifier",
      "title": "Subject ID"
    },
    "hemisphere": {
      "type": "string",
      "description": "Cortical hemisphere (e.g., lh or rh)",
      "title": "Hemisphere"
    },
    "surface_name": {
      "type": "string",
      "description": "Surface name (e.g., inflated, sphere, white)",
      "title": "Surface Name"
    },
    "options": {
      "type": "string",
      "description": "Optional flags and parameters",
      "title": "Options"
    }
  },
  "required": [
    "@type",
    "subject_id",
    "hemisphere",
    "surface_name"
  ]
}