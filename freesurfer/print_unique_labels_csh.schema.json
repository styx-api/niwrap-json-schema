{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "print_unique_labels.csh",
  "description": "Prints the list of unique labels (with structure name) in the input volume.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/print_unique_labels.csh"
    },
    "label_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Label volume to be analyzed",
      "title": "Label Volume"
    },
    "output_file": {
      "type": "string",
      "description": "Text file where the results are written",
      "title": "Output File"
    },
    "list_only": {
      "type": "boolean",
      "description": "Only list the labels",
      "title": "List Only",
      "default": false
    },
    "version": {
      "type": "boolean",
      "description": "Print version and exit",
      "title": "Print Version",
      "default": false
    },
    "help": {
      "type": "boolean",
      "description": "Print help and exit",
      "title": "Print Help",
      "default": false
    }
  },
  "required": [
    "@type",
    "label_volume"
  ]
}