{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_reposition_surface",
  "description": "Reposition a surface based on the given control points (in JSON format)",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output surface file"
    }
  },
  "required": [
    "root",
    "output_surface"
  ]
}