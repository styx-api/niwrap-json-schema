{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dmri_neighboringRegions",
  "description": "A tool for diffusion MRI analysis involving neighboring regions.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/dmri_neighboringRegions"
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input image file (e.g. img.nii.gz)",
      "title": "Input file"
    },
    "output_file": {
      "type": "string",
      "description": "Output result file (e.g. result.nii.gz)",
      "title": "Output file"
    }
  },
  "required": [
    "@type",
    "input_file",
    "output_file"
  ]
}