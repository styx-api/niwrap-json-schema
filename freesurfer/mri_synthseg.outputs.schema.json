{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_synthseg",
  "description": "SynthSeg is a tool for brain image segmentation.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_segmentation_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Segmentation output(s)"
    },
    "output_volume_csv": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "CSV file with volumes for all structures and subjects"
    },
    "output_qc_csv": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "CSV file with QC scores for all subjects"
    },
    "output_posteriors_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Posteriors output(s)"
    },
    "resampled_images_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Resampled image(s)"
    }
  },
  "required": [
    "root",
    "output_segmentation_file",
    "output_volume_csv",
    "output_qc_csv",
    "output_posteriors_file",
    "resampled_images_file"
  ]
}