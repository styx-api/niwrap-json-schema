{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recon-all-exvivo",
  "description": "A script to perform an ex vivo reconstruction with FreeSurfer.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/recon-all-exvivo"
    },
    "subject_id": {
      "type": "string",
      "description": "Subject identifier",
      "title": "Subject ID"
    },
    "hemisphere": {
      "type": "string",
      "description": "Specify hemisphere: -lh for left, -rh for right hemisphere",
      "title": "Hemisphere"
    },
    "nocerebellum": {
      "type": "boolean",
      "description": "Do not process cerebellum",
      "title": "No Cerebellum",
      "default": false
    }
  },
  "required": [
    "@type",
    "subject_id"
  ]
}