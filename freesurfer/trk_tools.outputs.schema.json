{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "trk_tools",
  "description": "Tool for processing TRK files",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "trk_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "The processed output TRK file"
    },
    "image_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Image exported from TRK file"
    },
    "vtk_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "VTK file containing streamlines"
    }
  },
  "required": [
    "root",
    "trk_output_file",
    "image_output_file",
    "vtk_output_file"
  ]
}