{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_strip_subject_info",
  "description": "A tool to strip subject information from MRI data files",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_strip_subject_info"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "Input file(s) containing MRI data",
      "title": "Input Files"
    },
    "output_directory": {
      "type": "string",
      "description": "Directory where stripped files will be saved",
      "title": "Output Directory"
    }
  },
  "required": [
    "@type",
    "input_files",
    "output_directory"
  ]
}