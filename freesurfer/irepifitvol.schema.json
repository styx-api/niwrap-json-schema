{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "irepifitvol",
  "description": "A tool for 3D volume fitting",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/irepifitvol"
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume file for fitting",
      "title": "Input file"
    },
    "output_file": {
      "type": "string",
      "description": "Output volume file after fitting",
      "title": "Output file",
      "default": "fitted_output"
    }
  },
  "required": [
    "@type",
    "input_file"
  ]
}