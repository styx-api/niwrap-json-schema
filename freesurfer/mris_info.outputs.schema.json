{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_info",
  "description": "Prints out information about a surface file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output file containing saved data"
    },
    "output_edge_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File containing edge info"
    }
  },
  "required": [
    "root",
    "output_file",
    "output_edge_file"
  ]
}