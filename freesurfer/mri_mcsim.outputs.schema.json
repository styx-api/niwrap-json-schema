{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_mcsim",
  "description": "Monte Carlo simulation tool for surface-based multiple comparisons",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "csd_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output CSD files based on the base name"
    },
    "done_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Done file created upon completion"
    },
    "iteration_save": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Iteration save file"
    },
    "log_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Log file generated during execution"
    }
  },
  "required": [
    "root",
    "csd_output",
    "done_output",
    "iteration_save",
    "log_output"
  ]
}