{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "label_subject_mixed",
  "description": "Automatic labeling of brain regions using a Gaussian classifier array.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/label_subject_mixed"
    },
    "brain_mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Brain mask to be used for final labeling",
      "title": "Brain Mask"
    },
    "norm_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Normalized volume",
      "title": "Normalized Volume"
    },
    "transform": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transform file in LTA format",
      "title": "Transform File"
    },
    "gca_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Gaussian classifier array (GCA) file",
      "title": "GCA File"
    },
    "aseg_output": {
      "type": "string",
      "description": "Output aseg file",
      "title": "Aseg Output"
    }
  },
  "required": [
    "@type",
    "brain_mask",
    "norm_volume",
    "transform",
    "gca_file",
    "aseg_output"
  ]
}