{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_rigid_register",
  "description": "Rigid registration tool for MRI volumes",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_rigid_register"
    },
    "source_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Source volume file for registration",
      "title": "Source Volume"
    },
    "target_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Target volume file for registration",
      "title": "Target Volume"
    },
    "transform_output": {
      "type": "string",
      "description": "Output file name for the transform",
      "title": "Transform Output"
    }
  },
  "required": [
    "@type",
    "source_volume",
    "target_volume",
    "transform_output"
  ]
}