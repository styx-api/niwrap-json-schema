{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslregister",
  "description": "Registers a volume to its FreeSurfer anatomical using FSL's FLIRT and creates a FreeSurfer register.dat file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_reg_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registration file."
    },
    "output_resliced_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Resliced output volume."
    },
    "output_fsl_matrix": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "FSL format output registration matrix."
    },
    "lta_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Registration output in LTA format."
    },
    "output_template": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output template."
    }
  },
  "required": [
    "root",
    "output_reg_file",
    "output_resliced_volume",
    "output_fsl_matrix",
    "lta_output",
    "output_template"
  ]
}