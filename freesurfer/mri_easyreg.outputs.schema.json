{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_easyreg",
  "description": "EasyReg: deep learning registration simple and easy",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "registered_reference_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registered reference image"
    },
    "registered_floating_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registered floating image"
    },
    "forward_field_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output forward field file"
    },
    "inverse_field_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output inverse field file"
    }
  },
  "required": [
    "root",
    "registered_reference_output",
    "registered_floating_output",
    "forward_field_output",
    "inverse_field_output"
  ]
}