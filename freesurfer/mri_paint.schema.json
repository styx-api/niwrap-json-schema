{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_paint",
  "description": "This program will paint average Talairach stats onto a surface",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_paint"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The input volume file",
      "title": "Input Volume"
    },
    "input_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The input surface file",
      "title": "Input Surface"
    },
    "registration_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The registration file",
      "title": "Registration File"
    },
    "output_float_file": {
      "type": "string",
      "description": "The output .float file",
      "title": "Output Float File"
    },
    "image_offset": {
      "type": "number",
      "description": "Set offset to use",
      "title": "Image Offset"
    },
    "paint_surf_coords": {
      "type": "boolean",
      "description": "Paint using surface coordinates",
      "title": "Paint Using Surface Coordinates",
      "default": false
    }
  },
  "required": [
    "@type",
    "input_volume",
    "input_surface",
    "registration_file",
    "output_float_file"
  ]
}