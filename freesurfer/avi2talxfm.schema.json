{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "avi2talxfm",
  "description": "Convert voxel-to-voxel transform to MNI transform.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/avi2talxfm"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume file",
      "title": "Input volume"
    },
    "target_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Target volume file",
      "title": "Target volume"
    },
    "vox2vox_transform": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Voxel-to-voxel transform file",
      "title": "Voxel-to-voxel transform"
    },
    "output_xfm": {
      "type": "string",
      "description": "Output MNI transform file",
      "title": "Output XFM file"
    }
  },
  "required": [
    "@type",
    "input_volume",
    "target_volume",
    "vox2vox_transform",
    "output_xfm"
  ]
}