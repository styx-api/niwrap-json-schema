{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fsdcmdecompress",
  "description": "A tool for decompressing DICOM files using GDCM or DCMTK.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The decompressed DICOM file"
    }
  },
  "required": [
    "root",
    "out_file"
  ]
}