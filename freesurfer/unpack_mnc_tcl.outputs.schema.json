{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "unpack_mnc.tcl",
  "description": "A tool for unpacking MINC format images",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "unpacked_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Unpacked output MINC file"
    }
  },
  "required": [
    "root",
    "unpacked_file"
  ]
}