{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_hires_register",
  "description": "A tool for high-resolution registration for Freesurfer images",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_hires_register"
    },
    "hires_labeling": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The high resolution labeling input file",
      "title": "High Resolution Labeling"
    },
    "input_intensity": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The input intensity file",
      "title": "Input Intensity"
    },
    "input_aseg": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The input aseg file",
      "title": "Input Aseg"
    },
    "output_xform": {
      "type": "string",
      "description": "The output transform file",
      "title": "Output Transform"
    }
  },
  "required": [
    "@type",
    "hires_labeling",
    "input_intensity",
    "input_aseg",
    "output_xform"
  ]
}