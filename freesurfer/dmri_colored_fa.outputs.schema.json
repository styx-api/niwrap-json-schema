{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dmri_coloredFA",
  "description": "Tool for generating colored FA maps from diffusion MRI data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_colored_fa": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The output colored FA image."
    }
  },
  "required": [
    "root",
    "output_colored_fa"
  ]
}