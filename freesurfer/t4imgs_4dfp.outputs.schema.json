{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "t4imgs_4dfp",
  "description": "Freesurfer tool for transforming images according to a specified T4 file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "transformed_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformed 4dfp image as output."
    }
  },
  "required": [
    "root",
    "transformed_image"
  ]
}