{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_synthstrip",
  "description": "Robust, universal skull-stripping for brain images of any type.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_image_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Stripped brain image output."
    },
    "output_mask_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Binary brain mask output."
    }
  },
  "required": [
    "root",
    "output_image_file",
    "output_mask_file"
  ]
}