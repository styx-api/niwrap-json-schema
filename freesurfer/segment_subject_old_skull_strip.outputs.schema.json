{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "segment_subject_old_skull_strip",
  "description": "Front-end for MINCs mritotal for computing the talairach transform that maps the input volume to the MNI305.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_xfm_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resulting output xfm file"
    },
    "log_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Generated log file"
    }
  },
  "required": [
    "root",
    "output_xfm_file",
    "log_output_file"
  ]
}