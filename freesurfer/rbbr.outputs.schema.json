{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "rbbr",
  "description": "Robust version of bbregister",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_reg_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output registration file"
    },
    "output_lta_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output LTA file"
    },
    "output_template_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved template output file"
    }
  },
  "required": [
    "root",
    "output_reg_file",
    "output_lta_file",
    "output_template_file"
  ]
}