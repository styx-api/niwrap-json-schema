{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dmri_coloredFA",
  "description": "Tool for generating colored FA maps from diffusion MRI data.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/dmri_coloredFA"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input diffusion MRI volume.",
      "title": "Input Volume"
    },
    "output_volume": {
      "type": "string",
      "description": "Output colored FA image.",
      "title": "Output Volume",
      "default": "colored_FA"
    }
  },
  "required": [
    "@type",
    "input_volume"
  ]
}