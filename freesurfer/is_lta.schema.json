{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IsLTA",
  "description": "Determines if a given file is an LTA (Linear Transform Array) file. Outputs 1 if true, otherwise outputs 0.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/IsLTA"
    },
    "candidate_file": {
      "type": "string",
      "x-styx-type": "path"
    }
  },
  "required": [
    "@type",
    "candidate_file"
  ]
}