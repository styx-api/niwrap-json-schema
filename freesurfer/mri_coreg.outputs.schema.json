{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_coreg",
  "description": "mri_coreg performs a linear registration between two volumes using the method compatible with spm_coreg.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_registration": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registration (LTA format)"
    },
    "out_params": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with output parameters"
    },
    "out_cost": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Final cost value file"
    },
    "saved_init_reg": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved initial registration"
    },
    "saved_init_reg_only": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved initial registration (exit after save)"
    },
    "movout_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Preprocessed moving volume"
    },
    "mov_idither_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Moving intensity dither volume"
    }
  },
  "required": [
    "root",
    "out_registration",
    "out_params",
    "out_cost",
    "saved_init_reg",
    "saved_init_reg_only",
    "movout_volume",
    "mov_idither_volume"
  ]
}