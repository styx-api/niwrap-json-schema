{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_segment",
  "description": "Segments white matter from the input volume.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Segmented white matter output volume"
    },
    "log_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Log file from segmentation process"
    }
  },
  "required": [
    "root",
    "output_volume",
    "log_file"
  ]
}