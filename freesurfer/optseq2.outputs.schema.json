{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "optseq2",
  "description": "Optseq2 is a tool for automatically scheduling events for rapid-presentation event-related (RPER) fMRI experiments.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_schedules": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output schedules"
    },
    "output_design_matrices": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output FIR design matrices"
    },
    "output_contrast_matrix": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output contrast matrix"
    },
    "output_summary": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output search summary"
    },
    "output_log": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output log file"
    },
    "output_sviter": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output per-iteration information"
    }
  },
  "required": [
    "root",
    "output_schedules",
    "output_design_matrices",
    "output_contrast_matrix",
    "output_summary",
    "output_log",
    "output_sviter"
  ]
}