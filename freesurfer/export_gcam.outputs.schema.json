{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "exportGcam",
  "description": "A tool for exporting GCAM (Geodesic Coordinate-based Anatomic Mapping) morphs.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_gcam_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output GCAM file."
    }
  },
  "required": [
    "root",
    "output_gcam_file"
  ]
}