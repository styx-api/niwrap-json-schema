{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_volcluster",
  "description": "A tool for finding clusters in a volume, useful for analyzing MRI data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output volume after clustering."
    },
    "output_cluster_number_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output cluster number volume."
    },
    "output_binary_mask": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Final binary mask output."
    },
    "output_label_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved cluster as label file."
    }
  },
  "required": [
    "root",
    "output_volume",
    "output_cluster_number_volume",
    "output_binary_mask",
    "output_label_file"
  ]
}