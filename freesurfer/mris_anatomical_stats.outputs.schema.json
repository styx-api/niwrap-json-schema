{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_anatomical_stats",
  "description": "This program computes a number of anatomical properties.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_log_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output log file of the statistics"
    },
    "output_table_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Tabular output stored in a table file"
    },
    "output_ctab_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output annotation color table file"
    }
  },
  "required": [
    "root",
    "output_log_file",
    "output_table_file",
    "output_ctab_file"
  ]
}