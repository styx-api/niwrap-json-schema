{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_relabel_hypointensities",
  "description": "Tool for relabeling hypointensities in FreeSurfer's aseg files.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_aseg_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The relabeled output aseg file"
    }
  },
  "required": [
    "root",
    "output_aseg_file"
  ]
}