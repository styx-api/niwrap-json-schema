{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_rotate",
  "description": "Rotate a surface given three angles.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "rotated_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The rotated output surface."
    }
  },
  "required": [
    "root",
    "rotated_surface"
  ]
}