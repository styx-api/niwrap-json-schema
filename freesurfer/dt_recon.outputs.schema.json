{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dt_recon",
  "description": "Performs DTI reconstruction from the raw DWI input files.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "dwi_nifti": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Converted input to NIFTI format."
    },
    "dwi_eddy_corrected": {
      "type": "string",
      "x-styx-type": "path",
      "description": "DWI after eddy-current correction."
    },
    "tensor_map": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Tensor map."
    },
    "fa_map": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Fractional anisotropy (FA) map."
    },
    "fa_tal_map": {
      "type": "string",
      "x-styx-type": "path",
      "description": "FA map in Talairach space."
    },
    "register_file_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Registration file."
    },
    "mask_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mask file."
    }
  },
  "required": [
    "root",
    "dwi_nifti",
    "dwi_eddy_corrected",
    "tensor_map",
    "fa_map",
    "fa_tal_map",
    "register_file_output",
    "mask_file"
  ]
}