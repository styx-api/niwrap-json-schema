{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_ribbon",
  "description": "MRI Ribbon tool to create ribbon volumes from surface files",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "ribbon_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output ribbon volume"
    }
  },
  "required": [
    "root",
    "ribbon_output"
  ]
}