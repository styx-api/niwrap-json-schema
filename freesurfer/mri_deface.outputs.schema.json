{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_deface",
  "description": "MRI Deface utility for removing facial features from MRI images.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "defaced_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The resulting defaced MRI volume."
    }
  },
  "required": [
    "root",
    "defaced_output_file"
  ]
}