{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_interpolate_warp",
  "description": "Interpolate warp on cortical surfaces",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_interpolate_warp"
    },
    "start_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The starting surface file.",
      "title": "Start Surface"
    },
    "end_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The ending surface file.",
      "title": "End Surface"
    },
    "warp_field": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The warp field file with .m3z extension.",
      "title": "Warp Field"
    }
  },
  "required": [
    "@type",
    "start_surface",
    "end_surface",
    "warp_field"
  ]
}