{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "swi_process",
  "description": "Process the Susceptibility-weighted images. Ensure the inputs are post-phase unwrapping using PRELUDE.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "swi_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "SWI processed output image"
    }
  },
  "required": [
    "root",
    "swi_output_file"
  ]
}