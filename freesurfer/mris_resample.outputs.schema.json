{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_resample",
  "description": "Resample cortical surfaces in FreeSurfer",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "resampled_surface_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resampled surface output"
    },
    "resampled_annotation_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output annotation for the resampled atlas"
    }
  },
  "required": [
    "root",
    "resampled_surface_output",
    "resampled_annotation_output"
  ]
}