{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fs_spmreg.glnxa64",
  "description": "fs_spmreg is a tool for registration using SPM within FreeSurfer.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/fs_spmreg.glnxa64"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input anatomical volume",
      "title": "Input Volume"
    },
    "output_matrix": {
      "type": "string",
      "description": "Output registration matrix",
      "title": "Output Matrix",
      "default": "output.mat"
    }
  },
  "required": [
    "@type",
    "input_volume"
  ]
}