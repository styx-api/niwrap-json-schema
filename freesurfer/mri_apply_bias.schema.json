{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_apply_bias",
  "description": "A tool for applying a bias volume to an input volume to produce an output volume.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_apply_bias"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The input volume file",
      "title": "Input Volume"
    },
    "bias_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The bias volume file",
      "title": "Bias Volume"
    },
    "output_volume": {
      "type": "string",
      "description": "The output volume file",
      "title": "Output Volume"
    }
  },
  "required": [
    "@type",
    "input_volume",
    "bias_volume",
    "output_volume"
  ]
}