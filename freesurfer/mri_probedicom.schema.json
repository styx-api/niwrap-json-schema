{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_probedicom",
  "description": "Utility to probe DICOM files for information.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_probedicom"
    },
    "dicom_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "DICOM file to be probed.",
      "title": "DICOM file"
    },
    "option1": {
      "type": "string",
      "description": "Description for option1",
      "title": "Option 1"
    },
    "option2": {
      "type": "string",
      "description": "Description for option2",
      "title": "Option 2"
    }
  },
  "required": [
    "@type",
    "dicom_file"
  ]
}