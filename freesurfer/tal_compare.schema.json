{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tal_compare",
  "description": "Tool for comparing TAL databases",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/tal_compare"
    },
    "ref_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Reference TAL database file.",
      "title": "Reference File"
    },
    "moving_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Moving TAL database file to compare against the reference.",
      "title": "Moving File"
    },
    "output_file": {
      "type": "string",
      "description": "Output file to store comparison results.",
      "title": "Output File"
    },
    "verbose": {
      "type": "boolean",
      "description": "Enable verbose output.",
      "title": "Verbose Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "ref_file",
    "moving_file",
    "output_file"
  ]
}