{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "gauss_4dfp",
  "description": "Applies a Gaussian filter to 4dfp or conc input files.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output file in 4dfp format."
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}