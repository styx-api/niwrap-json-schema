{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_dist_surf_label",
  "description": "Computes distances from input surface to label points or waypoints.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_dist_surf_label"
    },
    "surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file.",
      "title": "Surface"
    },
    "label_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input label file.",
      "title": "Label File"
    },
    "output": {
      "type": "string",
      "description": "Output file for distances.",
      "title": "Output"
    }
  },
  "required": [
    "@type",
    "surface",
    "label_file",
    "output"
  ]
}