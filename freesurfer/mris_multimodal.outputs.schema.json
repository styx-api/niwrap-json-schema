{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_multimodal",
  "description": "A FreeSurfer tool for processing multimodal surface data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "processed_output_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Processed output surface file."
    },
    "annotation_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file containing annotation data."
    },
    "overlay_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file containing overlay data."
    },
    "csv_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output CSV file."
    }
  },
  "required": [
    "root",
    "processed_output_surface",
    "annotation_output_file",
    "overlay_output_file",
    "csv_output_file"
  ]
}