{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_reposition_surface",
  "description": "Reposition a surface based on the given control points (in JSON format)",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_reposition_surface"
    },
    "surf": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface",
      "title": "Input surface"
    },
    "volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume",
      "title": "Input volume"
    },
    "points": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input points",
      "title": "Input points"
    },
    "output": {
      "type": "string",
      "description": "Output surface filename",
      "title": "Output surface"
    },
    "size": {
      "type": "number",
      "description": "Size parameter for repositioning. Default is 1.",
      "title": "Size"
    },
    "sigma": {
      "type": "number",
      "description": "Sigma. Default is 2.0.",
      "title": "Sigma"
    },
    "iterations": {
      "type": "number",
      "description": "Number of iterations. Default is 1.",
      "title": "Iterations"
    }
  },
  "required": [
    "@type",
    "surf",
    "volume",
    "points",
    "output"
  ]
}