{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_remove_intersection",
  "description": "Tool to remove intersections in surface files.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_corrected_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Corrected surface output file."
    },
    "out_map_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Binary map of intersections."
    }
  },
  "required": [
    "root",
    "out_corrected_surface",
    "out_map_file"
  ]
}