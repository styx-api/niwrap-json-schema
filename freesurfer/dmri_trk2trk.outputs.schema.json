{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dmri_trk2trk",
  "description": "A tool for transforming and analyzing tractography data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_trk_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Transformed output .trk file"
    },
    "out_asc_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Transformed output ASCII text file"
    },
    "out_vol_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Transformed output volume"
    }
  },
  "required": [
    "root",
    "out_trk_file",
    "out_asc_file",
    "out_vol_file"
  ]
}