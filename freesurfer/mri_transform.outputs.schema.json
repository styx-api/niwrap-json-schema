{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_transform",
  "description": "Applies a linear transform to an MRI volume and writes out the result.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "transformed_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformed output volume"
    }
  },
  "required": [
    "root",
    "transformed_output"
  ]
}