{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "slicedelay",
  "description": "Creates an FSL custom slice delay file for use with slicetimer for slice-time correction of fMRI",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "slicedelayfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The generated slice delay file"
    }
  },
  "required": [
    "root",
    "slicedelayfile"
  ]
}