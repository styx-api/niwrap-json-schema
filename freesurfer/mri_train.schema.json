{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_train",
  "description": "Tool for training with MRI data in FreeSurfer.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_train"
    },
    "training_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input training file name",
      "title": "Training File"
    },
    "output_file": {
      "type": "string",
      "description": "Output file",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "training_file",
    "output_file"
  ]
}