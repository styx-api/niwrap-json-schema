{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_nudge",
  "description": "A tool to nudge vertex positions on a surface using a volume.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output surface file after nudging"
    }
  },
  "required": [
    "root",
    "output_surface"
  ]
}