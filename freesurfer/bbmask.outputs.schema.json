{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "bbmask",
  "description": "Tool to create a volume with a smaller field of view by creating a bounding box that encompasses a mask.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "mask_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output mask volume"
    },
    "src_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output reduced volume(s)"
    },
    "registration_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registration file"
    },
    "regheader_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registration file from regheader"
    },
    "sub2src_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file for sub2src registration"
    }
  },
  "required": [
    "root",
    "mask_output_file",
    "src_output_file",
    "registration_output_file",
    "regheader_output_file",
    "sub2src_output_file"
  ]
}