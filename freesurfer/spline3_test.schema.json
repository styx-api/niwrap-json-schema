{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spline3_test",
  "description": "A tool for cubic spline interpolation.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/Spline3_test"
    },
    "x_values": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Original x values for interpolation.",
      "title": "X values"
    },
    "y_values": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Original y values corresponding to x values.",
      "title": "Y values"
    },
    "x_new_values": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "New x values where interpolation is evaluated.",
      "title": "X new values"
    }
  },
  "required": [
    "@type",
    "x_values",
    "y_values",
    "x_new_values"
  ]
}