{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_gtmpvc",
  "description": "mri_gtmpvc performs partial volume correction on PET data using anatomical segmentation.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "synthesized_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Synthesized volume"
    },
    "rescaled_input": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Rescaled input volume"
    },
    "eresiduals": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Residual errors volume"
    },
    "yhat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Yhat volume"
    },
    "yhat_with_noise": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Yhat with noise volume"
    },
    "yhat_full_fov": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Yhat full FoV volume"
    },
    "yhat_prior": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Yhat prior to smoothing volume"
    },
    "x_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "X matrix in matlab4 format"
    },
    "y_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Y matrix in matlab4 format"
    },
    "beta_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Beta matrix in matlab4 format"
    },
    "x0_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "X0 matrix in matlab4 format"
    },
    "gtm_values_text": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Demeaned GTM values as text file"
    }
  },
  "required": [
    "root",
    "synthesized_volume",
    "rescaled_input",
    "eresiduals",
    "yhat",
    "yhat_with_noise",
    "yhat_full_fov",
    "yhat_prior",
    "x_matrix",
    "y_matrix",
    "beta_matrix",
    "x0_matrix",
    "gtm_values_text"
  ]
}