{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_remove_neck",
  "description": "Tool for removing neck from MRI volumes.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_remove_neck"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input MRI volume.",
      "title": "Input Volume"
    },
    "transform": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformation matrix to register the volume.",
      "title": "Transform"
    },
    "gca": {
      "type": "string",
      "x-styx-type": "path",
      "description": "GCA file needed for processing.",
      "title": "GCA"
    },
    "output_volume": {
      "type": "string",
      "description": "Output MRI volume with the neck removed.",
      "title": "Output Volume"
    }
  },
  "required": [
    "@type",
    "input_volume",
    "transform",
    "gca",
    "output_volume"
  ]
}