{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_compute_volume_fractions",
  "description": "Computes partial volume fractions for cortex, subcortical GM, WM and CSF",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_cortex": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output cortex volume file."
    },
    "output_subcort_gm": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output subcortical gray matter volume file."
    },
    "output_wm": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output white matter volume file."
    },
    "output_csf": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output cerebrospinal fluid volume file."
    }
  },
  "required": [
    "root",
    "output_cortex",
    "output_subcort_gm",
    "output_wm",
    "output_csf"
  ]
}