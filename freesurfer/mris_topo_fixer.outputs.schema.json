{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_topo_fixer",
  "description": "FreeSurfer tool for fixing topological defects in cortical surface meshes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "fixed_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Surface file with fixed topology."
    }
  },
  "required": [
    "root",
    "fixed_surface"
  ]
}