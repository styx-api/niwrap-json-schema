{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_segment",
  "description": "A command-line tool for segmenting surfaces in FreeSurfer",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_segment"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "A list of input subjects",
      "title": "Input Subjects"
    },
    "output_subject": {
      "type": "string",
      "description": "Output subject name",
      "title": "Output Subject"
    },
    "output_file": {
      "type": "string",
      "description": "Output file path",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "subjects",
    "output_subject",
    "output_file"
  ]
}