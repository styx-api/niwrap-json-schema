{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mideface",
  "description": "Minimally invasive defacing tool",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "defaced_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Defaced output volume"
    },
    "facemask_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Applied facemask file"
    }
  },
  "required": [
    "root",
    "defaced_output",
    "facemask_output"
  ]
}