{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "grad_unwarp",
  "description": "Convert, dewarp, and resample DICOM files to MGH files.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "mgh_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file in MGH format"
    },
    "cor_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output directory in COR format"
    }
  },
  "required": [
    "root",
    "mgh_output",
    "cor_output"
  ]
}