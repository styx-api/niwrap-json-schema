{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_exvivo_strip",
  "description": "Tool for processing MRI volumes for ex vivo data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Processed output MRI volume"
    },
    "prediction_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Prediction volume if specified"
    },
    "normalized_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Normalized volume if specified"
    }
  },
  "required": [
    "root",
    "output_file",
    "prediction_output",
    "normalized_output"
  ]
}