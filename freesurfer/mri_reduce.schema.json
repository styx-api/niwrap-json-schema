{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_reduce",
  "description": "A tool to reduce MRI file dimensions",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_reduce"
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input MRI file",
      "title": "Input File"
    },
    "output_file": {
      "type": "string",
      "description": "Output filename for the reduced MRI file",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "input_file",
    "output_file"
  ]
}