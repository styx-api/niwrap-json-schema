{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_robust_template",
  "description": "Constructs an unbiased robust template for longitudinal volumes using an iterative method.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "template_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output template volume (final mean/median image)."
    },
    "conform_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output conformed template volume."
    }
  },
  "required": [
    "root",
    "template_output",
    "conform_output"
  ]
}