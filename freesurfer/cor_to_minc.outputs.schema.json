{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cor_to_minc",
  "description": "Converts a directory of COR files to a MINC file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_minc": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Converted MINC file"
    }
  },
  "required": [
    "root",
    "output_minc"
  ]
}