{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3dvolreg.afni",
  "description": "AFNI program for volume registration",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/3dvolreg.afni"
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dataset to be registered",
      "title": "Input file"
    },
    "output_file": {
      "type": "string",
      "description": "Output dataset with applied registration",
      "title": "Output file"
    },
    "options": {
      "type": "string",
      "description": "Options for 3dvolreg (consult AFNI documentation for details)",
      "title": "Options"
    }
  },
  "required": [
    "@type",
    "input_file",
    "output_file"
  ]
}