{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "label_elderly_subject",
  "description": "Tool for labeling brain structures in MRI images of elderly subjects using Freesurfer.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/label_elderly_subject"
    },
    "norm_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Normalized input volume (e.g. norm.mgz)",
      "title": "Norm Volume"
    },
    "transform_lta": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformation file (e.g. talairach.lta)",
      "title": "Transform LTA"
    },
    "classifier_array": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Classifier array file (e.g. mixed.gca)",
      "title": "Classifier Array"
    },
    "aseg_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Asegmentation volume file (e.g. aseg.mgz)",
      "title": "Aseg Volume"
    }
  },
  "required": [
    "@type",
    "norm_volume",
    "transform_lta",
    "aseg_volume"
  ]
}