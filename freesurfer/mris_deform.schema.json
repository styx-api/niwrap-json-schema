{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_deform",
  "description": "A tool for deforming surface meshes using volumetric information from an auxiliary volume.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_deform"
    },
    "input_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file (e.g., lh.white)",
      "title": "Input Surface"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume file (e.g., brain.mgz)",
      "title": "Input Volume"
    },
    "xform": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformation file (e.g., talairach.xfm)",
      "title": "Transformation File"
    },
    "output_surface": {
      "type": "string",
      "description": "Output surface file (e.g., lh.white.deformed)",
      "title": "Output Surface"
    }
  },
  "required": [
    "@type",
    "input_surface",
    "input_volume",
    "xform",
    "output_surface"
  ]
}