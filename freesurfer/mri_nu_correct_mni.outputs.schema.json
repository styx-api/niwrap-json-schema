{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_nu_correct.mni",
  "description": "Wrapper for nu_correct, used for correcting intensity non-uniformity (bias fields).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "corrected_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Corrected output volume."
    }
  },
  "required": [
    "root",
    "corrected_output"
  ]
}