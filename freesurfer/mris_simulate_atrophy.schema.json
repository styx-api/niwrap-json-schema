{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_simulate_atrophy",
  "description": "Simulate atrophy on brain structures.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_simulate_atrophy"
    },
    "subject": {
      "type": "string",
      "description": "Subject identifier",
      "title": "Subject"
    },
    "hemi": {
      "type": "string",
      "description": "Hemisphere (e.g. lh or rh)",
      "title": "Hemisphere"
    },
    "label": {
      "type": "string",
      "description": "Label of the brain region",
      "title": "Label"
    },
    "atrophy_fraction": {
      "type": "number",
      "description": "Target atrophy fraction",
      "title": "Atrophy Fraction"
    },
    "output_volume": {
      "type": "string",
      "description": "Output volume file",
      "title": "Output Volume"
    },
    "atrophy_percent": {
      "type": "number",
      "description": "Percentage atrophy to simulate of structure",
      "title": "Atrophy Percentage"
    },
    "noise_level": {
      "type": "number",
      "description": "Gaussian noise level to add",
      "title": "Noise Level"
    }
  },
  "required": [
    "@type",
    "subject",
    "hemi",
    "label",
    "atrophy_fraction",
    "output_volume"
  ]
}