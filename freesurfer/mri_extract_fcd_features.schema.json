{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_extract_fcd_features",
  "description": "A tool for extracting focal cortical dysplasia features.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_extract_fcd_features"
    },
    "subject": {
      "type": "string",
      "description": "The subject identifier.",
      "title": "Subject"
    },
    "hemi": {
      "type": "string",
      "description": "The hemisphere (e.g., lh or rh).",
      "title": "Hemisphere"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file path.",
      "title": "Output File"
    },
    "subjects_dir": {
      "type": "string",
      "description": "Specify SUBJECTS_DIR on the command line instead of in the environment.",
      "title": "Subjects Directory"
    }
  },
  "required": [
    "@type",
    "subject",
    "hemi",
    "output_file"
  ]
}