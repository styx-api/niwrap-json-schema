{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "defect2seg",
  "description": "Converts surface defect labels into a segmentation volume and pointsets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_segmentation": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resulting defect segmentation volume"
    }
  },
  "required": [
    "root",
    "output_segmentation"
  ]
}