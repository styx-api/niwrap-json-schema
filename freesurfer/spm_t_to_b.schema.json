{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spm_t_to_b",
  "description": "Converts SPM format to Bshort format.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/spm_t_to_b"
    },
    "spm_stem_format": {
      "type": "string",
      "description": "Input SPM stem format.",
      "title": "SPM Stem Format"
    },
    "bshort_stem": {
      "type": "string",
      "description": "Output bshort stem.",
      "title": "Bshort Stem"
    }
  },
  "required": [
    "@type",
    "spm_stem_format",
    "bshort_stem"
  ]
}