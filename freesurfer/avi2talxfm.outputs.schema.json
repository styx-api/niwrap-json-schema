{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "avi2talxfm",
  "description": "Convert voxel-to-voxel transform to MNI transform.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_xfm_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resulting MNI transform file"
    }
  },
  "required": [
    "root",
    "output_xfm_file"
  ]
}