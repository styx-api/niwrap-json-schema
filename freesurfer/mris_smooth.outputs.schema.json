{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_smooth",
  "description": "This program smooths the tessellation of a cortical surface and writes out the mean curvature and area files.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_surface_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output smoothed surface file."
    },
    "curvature_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output curvature file (if written)."
    },
    "area_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output area file (if written)."
    }
  },
  "required": [
    "root",
    "output_surface_file",
    "curvature_file",
    "area_file"
  ]
}