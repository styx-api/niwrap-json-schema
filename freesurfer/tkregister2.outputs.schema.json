{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "tkregister2",
  "description": "tkregister2 is a tool from FreeSurfer used for registration of MRI images.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_reg_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resulting registration file"
    }
  },
  "required": [
    "root",
    "output_reg_file"
  ]
}