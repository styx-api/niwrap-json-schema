{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "reg-feat2anat",
  "description": "Registers FSL-Feat example_func to FreeSurfer anatomical data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "anat2std_register": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Init FS reg from anat to FSL-standard"
    },
    "std2anat_fsl_mat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Init FSL reg from FSL-standard to anat"
    },
    "exf2anat_init_fsl_mat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Init FSL reg from example_func to anat"
    },
    "exf2anat_fsl_mat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Final FSL reg from example_func to anat"
    },
    "anat2exf_register": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Final FS reg from example_func to anat"
    },
    "register_dat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Same as anat2exf.register.dat"
    },
    "example_func2standard_mat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Replacement for feat-generated"
    },
    "log_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Log file for registration"
    }
  },
  "required": [
    "root",
    "anat2std_register",
    "std2anat_fsl_mat",
    "exf2anat_init_fsl_mat",
    "exf2anat_fsl_mat",
    "anat2exf_register",
    "register_dat",
    "example_func2standard_mat",
    "log_file"
  ]
}