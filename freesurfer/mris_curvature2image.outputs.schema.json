{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_curvature2image",
  "description": "Tool to convert surface curvature data to an image using FreeSurfer.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_overlay_img": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated overlay image file."
    },
    "output_distance_img": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated distance image file."
    }
  },
  "required": [
    "root",
    "output_overlay_img",
    "output_distance_img"
  ]
}