{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ventfix",
  "description": "Tool for fixing ventricles in MRI scans",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "fixed_ventricles": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output image with fixed ventricles"
    }
  },
  "required": [
    "root",
    "fixed_ventricles"
  ]
}