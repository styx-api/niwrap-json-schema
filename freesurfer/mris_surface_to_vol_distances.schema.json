{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_surface_to_vol_distances",
  "description": "Tool from FreeSurfer to calculate surface-to-volume distances",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_surface_to_vol_distances"
    },
    "average_subject": {
      "type": "string",
      "description": "The average subject.",
      "title": "Average Subject"
    },
    "hemisphere": {
      "type": "string",
      "description": "Hemisphere identifier (e.g., lh or rh).",
      "title": "Hemisphere"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of subjects for distance calculation.",
      "title": "Subjects"
    },
    "output_prefix": {
      "type": "string",
      "description": "Prefix for output files.",
      "title": "Output Prefix"
    }
  },
  "required": [
    "@type",
    "average_subject",
    "hemisphere",
    "subjects",
    "output_prefix"
  ]
}