{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "labels_union",
  "description": "Utility to create the union of two label files.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/labels_union"
    },
    "label1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First label file (e.g., rh.BA3a.label)",
      "title": "Label 1"
    },
    "label2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Second label file (e.g., rh.BA3b.label)",
      "title": "Label 2"
    },
    "outputname": {
      "type": "string",
      "description": "Output name for the union label file (e.g., rh.BA3ab.union.label)",
      "title": "Output Name"
    }
  },
  "required": [
    "@type",
    "label1",
    "label2",
    "outputname"
  ]
}