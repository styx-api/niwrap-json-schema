{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SegmentSubfieldsT1Longitudinal",
  "description": "FreeSurfer tool for segmenting subfields in longitudinal T1-weighted images.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/SegmentSubfieldsT1Longitudinal"
    },
    "subject_id": {
      "type": "string",
      "description": "Subject ID for the longitudinal analysis",
      "title": "Subject ID"
    },
    "input_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input T1-weighted image",
      "title": "Input Image"
    },
    "output_dir": {
      "type": "string",
      "description": "Directory to save the output",
      "title": "Output Directory"
    }
  },
  "required": [
    "@type",
    "subject_id",
    "input_image",
    "output_dir"
  ]
}