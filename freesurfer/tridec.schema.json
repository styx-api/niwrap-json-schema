{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tridec",
  "description": "Tridec tool for processing brain images.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/tridec"
    },
    "subject_name": {
      "type": "string",
      "description": "Name of the subject being processed.",
      "title": "Subject Name"
    },
    "fine_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Fine file input for tridec.",
      "title": "Fine File"
    },
    "ico_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "ICO file input for tridec.",
      "title": "ICO File"
    },
    "out_file": {
      "type": "string",
      "description": "Output file for tridec processing result.",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "subject_name",
    "fine_file",
    "ico_file",
    "out_file"
  ]
}