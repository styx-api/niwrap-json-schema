{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "reregister_subject_mixed",
  "description": "Tool for re-registering a subject's MRI volumes using Freesurfer.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "control_points": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformed control points"
    },
    "intensity_normalized": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Intensity normalized output"
    },
    "log_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Log file for talairach processing"
    }
  },
  "required": [
    "root",
    "control_points",
    "intensity_normalized",
    "log_file"
  ]
}