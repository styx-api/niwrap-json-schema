{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wfilemask",
  "description": "Zero-out regions of a surface value file (.w file) using a label.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/wfilemask"
    },
    "w_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input w file",
      "title": "Input W file"
    },
    "label_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Label file to use as a mask",
      "title": "Label File"
    },
    "output_file": {
      "type": "string",
      "description": "Output w file",
      "title": "Output W file"
    },
    "permission_mask": {
      "type": "string",
      "description": "Set Unix file permission mask",
      "title": "Permission Mask"
    },
    "help_flag": {
      "type": "boolean",
      "description": "Display help message and exit",
      "title": "Help Flag",
      "default": false
    },
    "version_flag": {
      "type": "boolean",
      "description": "Print version and exit",
      "title": "Version Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "w_file",
    "label_file",
    "output_file"
  ]
}