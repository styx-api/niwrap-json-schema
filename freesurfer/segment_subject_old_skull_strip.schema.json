{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "segment_subject_old_skull_strip",
  "description": "Front-end for MINCs mritotal for computing the talairach transform that maps the input volume to the MNI305.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/segment_subject_old_skull_strip"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume file",
      "title": "Input Volume"
    },
    "output_xfm": {
      "type": "string",
      "description": "Output xfm file",
      "title": "Output XFM File"
    },
    "log_file": {
      "type": "string",
      "description": "Log file. Default is outdir/talarach.log",
      "title": "Log File"
    },
    "help_flag": {
      "type": "boolean",
      "description": "Print help and exit",
      "title": "Help",
      "default": false
    },
    "debug_flag": {
      "type": "boolean",
      "description": "Turn on debugging",
      "title": "Debug",
      "default": false
    },
    "version_flag": {
      "type": "boolean",
      "description": "Print version and exit",
      "title": "Version",
      "default": false
    }
  },
  "required": [
    "@type",
    "input_volume",
    "output_xfm"
  ]
}