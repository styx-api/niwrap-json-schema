{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_stats2seg",
  "description": "A command-line tool for converting MRI statistical maps to segmented volume.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "segmented_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output segmented file."
    }
  },
  "required": [
    "root",
    "segmented_output"
  ]
}