{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_relabel_hypointensities",
  "description": "Tool for relabeling hypointensities in FreeSurfer's aseg files.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_relabel_hypointensities"
    },
    "input_aseg": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input aseg file",
      "title": "Input aseg"
    },
    "surface_directory": {
      "type": "string",
      "description": "Directory containing surfaces",
      "title": "Surface directory"
    },
    "output_aseg": {
      "type": "string",
      "description": "Output aseg file",
      "title": "Output aseg"
    }
  },
  "required": [
    "@type",
    "input_aseg",
    "surface_directory",
    "output_aseg"
  ]
}