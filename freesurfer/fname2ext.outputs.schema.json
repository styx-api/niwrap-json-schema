{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fname2ext",
  "description": "Converts the name of a file to its extension.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "file_extension": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Extracted file extension"
    }
  },
  "required": [
    "root",
    "file_extension"
  ]
}