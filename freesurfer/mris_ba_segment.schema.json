{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_BA_segment",
  "description": "Segments a Brodmann area (MT currently) from a laminar intensity profile overlay.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_BA_segment"
    },
    "surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file",
      "title": "Surface file"
    },
    "profiles": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input profiles file",
      "title": "Profiles file"
    },
    "prior_label": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input prior label file",
      "title": "Prior label file"
    },
    "output_label": {
      "type": "string",
      "description": "Output label file",
      "title": "Output label"
    }
  },
  "required": [
    "@type",
    "surface",
    "profiles",
    "prior_label",
    "output_label"
  ]
}