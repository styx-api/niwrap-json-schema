{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_skeletonize",
  "description": "Computes the skeleton of gyri (ie, the crowns) or sulci (ie, the fundi).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "skeleton_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output skeletonized mask."
    },
    "pointset_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output point set of the skeleton."
    },
    "skeleton_label": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Label file for the skeletonized output."
    }
  },
  "required": [
    "root",
    "skeleton_output",
    "pointset_output",
    "skeleton_label"
  ]
}