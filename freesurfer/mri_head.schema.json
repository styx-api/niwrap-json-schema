{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_head",
  "description": "No description",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_head"
    },
    "identify": {
      "type": "boolean",
      "description": "Identify the MRI file",
      "title": "Identify Flag",
      "default": false
    },
    "read": {
      "type": "boolean",
      "description": "Read the MRI file",
      "title": "Read Flag",
      "default": false
    },
    "filename": {
      "type": "string",
      "description": "Filename for identification or reading",
      "title": "Filename"
    },
    "help": {
      "type": "boolean",
      "description": "Display help information",
      "title": "Help Flag",
      "default": false
    },
    "usage": {
      "type": "boolean",
      "description": "Display usage information",
      "title": "Usage Flag",
      "default": false
    },
    "question_mark_help": {
      "type": "boolean",
      "description": "Display help or usage information",
      "title": "Question Mark Help Flag",
      "default": false
    }
  },
  "required": [
    "@type"
  ]
}