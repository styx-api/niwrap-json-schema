{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_volmask_vtk",
  "description": "Computes a volume mask at the resolution of the brain.mgz file, containing labels for various brain structures using surface files.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_volume_mask": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output volume mask file."
    },
    "left_ribbon_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Left hemisphere ribbon output file."
    },
    "right_ribbon_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Right hemisphere ribbon output file."
    },
    "edited_aseg_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Edited aseg output using ribbons."
    },
    "lh_dwhite_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Signed distance output for the left hemisphere white matter."
    },
    "lh_dpial_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Signed distance output for the left hemisphere pial surface."
    },
    "rh_dwhite_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Signed distance output for the right hemisphere white matter."
    },
    "rh_dpial_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Signed distance output for the right hemisphere pial surface."
    }
  },
  "required": [
    "root",
    "output_volume_mask",
    "left_ribbon_output",
    "right_ribbon_output",
    "edited_aseg_output",
    "lh_dwhite_output",
    "lh_dpial_output",
    "rh_dwhite_output",
    "rh_dpial_output"
  ]
}