{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_annot_to_segmentation",
  "description": "Converts annotation files to segmentation volumes in FreeSurfer.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_annot_to_segmentation"
    },
    "subject_name": {
      "type": "string",
      "description": "Subject name.",
      "title": "Subject Name"
    },
    "hemi": {
      "type": "string",
      "description": "Hemisphere (e.g., lh or rh).",
      "title": "Hemisphere"
    },
    "surface": {
      "type": "string",
      "description": "Surface file.",
      "title": "Surface"
    },
    "annot_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Annotation file.",
      "title": "Annotation File"
    },
    "color_table": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Color table file.",
      "title": "Color Table"
    },
    "output_volume": {
      "type": "string",
      "description": "Output volume file.",
      "title": "Output Volume"
    }
  },
  "required": [
    "@type",
    "subject_name",
    "hemi",
    "surface",
    "annot_file",
    "color_table",
    "output_volume"
  ]
}