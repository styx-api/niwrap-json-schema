  "description": "Converts annotation files to segmentation volumes in FreeSurfer.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_volume_file": {
      "type": "string",
      "x-styx-type": "path",
