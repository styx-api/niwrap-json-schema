{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_warp_convert",
  "description": "This program converts non-linear deformation field warp file formats.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outwarp": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Converted output warp file"
    }
  },
  "required": [
    "root",
    "outwarp"
  ]
}