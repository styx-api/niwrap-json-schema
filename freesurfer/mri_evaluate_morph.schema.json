{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_evaluate_morph",
  "description": "This program computes the overlap of a set of segmentations for a given morph using an xform file.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_evaluate_morph"
    },
    "xform_name": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Transformation file name.",
      "title": "Xform Name"
    },
    "segmentation_files": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "Input segmentation files.",
      "title": "Segmentation Files"
    },
    "output_file": {
      "type": "string",
      "description": "Output file.",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "xform_name",
    "segmentation_files",
    "output_file"
  ]
}