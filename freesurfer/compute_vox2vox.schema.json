{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compute_vox2vox",
  "description": "Tool for computing voxel-to-voxel transformations.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/compute_vox2vox"
    },
    "source": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input 4dfp source file.",
      "title": "Source File"
    },
    "t4file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "T4 transformation matrix file.",
      "title": "T4 File"
    },
    "target": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input 4dfp target file.",
      "title": "Target File"
    }
  },
  "required": [
    "@type",
    "source",
    "t4file",
    "target"
  ]
}