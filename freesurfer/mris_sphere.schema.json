{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_sphere",
  "description": "This program will add a template into an average surface.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_sphere"
    },
    "surface_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file.",
      "title": "Surface file"
    },
    "patch_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input patch file name.",
      "title": "Patch file"
    },
    "output_patch": {
      "type": "string",
      "description": "Output patch file name.",
      "title": "Output patch"
    }
  },
  "required": [
    "@type",
    "surface_file",
    "patch_file",
    "output_patch"
  ]
}