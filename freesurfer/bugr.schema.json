{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bugr",
  "description": "Utility for generating and reporting FreeSurfer bugs",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/bugr"
    },
    "subject_name": {
      "type": "string",
      "description": "Subject name to include in the bug report",
      "title": "Subject Name"
    },
    "command_line": {
      "type": "string",
      "description": "The entire command-line executed",
      "title": "Command Line"
    },
    "error_message": {
      "type": "string",
      "description": "The error message generated",
      "title": "Error Message"
    },
    "log_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Log file path of the subject's recon-all process",
      "title": "Log File"
    }
  },
  "required": [
    "@type",
    "subject_name",
    "command_line",
    "error_message"
  ]
}