{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "talsegprob",
  "description": "Tool to create a binary probability volume from aseg.mgz based on segmentation numbers, resliced to talirach/MNI305/fsaverage space.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "probability_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Probability output file."
    },
    "vote_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Vote output file."
    },
    "concat_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Concatenated output file."
    }
  },
  "required": [
    "root",
    "probability_output_file",
    "vote_output_file",
    "concat_output_file"
  ]
}