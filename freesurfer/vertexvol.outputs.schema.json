{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "vertexvol",
  "description": "Computes vertex-wise volume (and mid.area)",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_volume_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output file containing vertex-wise volume"
    }
  },
  "required": [
    "root",
    "output_volume_file"
  ]
}