{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_warp",
  "description": "This program will warp a surface using a specified deformation field.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_surface": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output surface file"
    }
  },
  "required": [
    "root",
    "output_surface"
  ]
}