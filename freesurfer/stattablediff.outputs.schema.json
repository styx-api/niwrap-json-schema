  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_diff_table": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated table of differences"
    }
  },
  "required": [
    "root",
    "output_diff_table"
  ]
}