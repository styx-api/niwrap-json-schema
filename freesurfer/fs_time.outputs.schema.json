{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fs_time",
  "description": "A frontend for the unix /usr/bin/time program to track resource usage by a process.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "resource_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File containing resource usage information."
    }
  },
  "required": [
    "root",
    "resource_output"
  ]
}