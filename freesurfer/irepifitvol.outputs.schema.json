{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "irepifitvol",
  "description": "A tool for 3D volume fitting",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "fitted_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The resulting volume file after fitting"
    }
  },
  "required": [
    "root",
    "fitted_output"
  ]
}