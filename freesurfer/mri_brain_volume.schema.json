{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_brain_volume",
  "description": "Tool to calculate brain volume from MRI scans",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_brain_volume"
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input MRI file",
      "title": "Input file"
    },
    "output_file": {
      "type": "string",
      "description": "Output file for brain volume",
      "title": "Output file"
    },
    "force_param": {
      "type": "number",
      "description": "Change pushout force (default 1.0)",
      "title": "Pushout force"
    },
    "version": {
      "type": "boolean",
      "description": "Show the current version",
      "title": "Version flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "input_file"
  ]
}