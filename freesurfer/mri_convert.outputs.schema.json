{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_convert",
  "description": "A general purpose utility for converting between different file formats supported by FreeSurfer",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "converted_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Converted volume output file"
    }
  },
  "required": [
    "root",
    "converted_volume"
  ]
}