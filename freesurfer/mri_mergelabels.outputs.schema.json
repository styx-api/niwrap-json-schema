{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_mergelabels",
  "description": "A tool to merge two or more label files by concatenating them together.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "merged_label_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Merged label output file"
    }
  },
  "required": [
    "root",
    "merged_label_file"
  ]
}