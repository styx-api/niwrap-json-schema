{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_remesh",
  "description": "Remeshes a surface to a desired edge length, number of vertices, or average face area.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "remeshed_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Remeshed output surface file"
    }
  },
  "required": [
    "root",
    "remeshed_output"
  ]
}