{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_cor2label",
  "description": "Converts values in a volume or surface overlay to a label. Designed to convert parcellation volumes stored in mri format.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_label_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated label file."
    },
    "output_volume_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Written volume label if specified."
    }
  },
  "required": [
    "root",
    "output_label_file",
    "output_volume_file"
  ]
}