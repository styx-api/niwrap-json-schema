{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_extract_label",
  "description": "Extracts a set of labeled voxels from an image.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Extracted labeled voxels output volume."
    }
  },
  "required": [
    "root",
    "output_volume"
  ]
}