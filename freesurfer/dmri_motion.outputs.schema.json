{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dmri_motion",
  "description": "A tool for calculating motion measures from DWI scans.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "motion_measures_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file of motion measures"
    },
    "frame_by_frame_out": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output frame-by-frame motion measures file"
    }
  },
  "required": [
    "root",
    "motion_measures_out",
    "frame_by_frame_out"
  ]
}