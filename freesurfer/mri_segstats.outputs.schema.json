{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_segstats",
  "description": "Calculates measures and stats derived from brain segmentation data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "summary_output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file for summary statistics."
    },
    "avg_waveform_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Average waveform output text file."
    },
    "sum_waveform_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Sum waveform output text file."
    },
    "avg_waveform_vol_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Average waveform volume output file."
    },
    "spatial_frame_avg_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Spatial frame average output file."
    },
    "ctab_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output color table with the reported segmentations."
    }
  },
  "required": [
    "root",
    "summary_output_file",
    "avg_waveform_output",
    "sum_waveform_output",
    "avg_waveform_vol_output",
    "spatial_frame_avg_output",
    "ctab_output_file"
  ]
}