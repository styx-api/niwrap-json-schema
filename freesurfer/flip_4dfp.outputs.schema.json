{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "flip_4dfp",
  "description": "A tool to flip 4dfp images along specified axes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "flipped_image": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Flipped output 4dfp image"
    }
  },
  "required": [
    "root",
    "flipped_image"
  ]
}