{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_vessel_segment",
  "description": "MRI vessel segmentation tool",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_vessel_segment"
    },
    "t1_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "T1-weighted input image",
      "title": "T1 Image"
    },
    "t2_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "T2-weighted input image",
      "title": "T2 Image"
    },
    "aseg_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Anatomical segmentation file",
      "title": "ASEG File"
    },
    "output_file": {
      "type": "string",
      "description": "Output file",
      "title": "Output File"
    },
    "shape_flag": {
      "type": "boolean",
      "description": "Use shape constraints during segmentation",
      "title": "Shape Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "t1_image",
    "t2_image",
    "aseg_file",
    "output_file"
  ]
}