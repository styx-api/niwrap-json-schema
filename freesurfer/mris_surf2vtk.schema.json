{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_surf2vtk",
  "description": "Conversion tool to convert surface files to VTK format",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_surf2vtk"
    },
    "input_surface": {
      "type": "string",
      "x-styx-type": "path"
    }
  },
  "required": [
    "@type",
    "input_surface"
  ]
}