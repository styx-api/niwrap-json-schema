{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_expand",
  "description": "Expand a given surface by a specified distance",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_surface_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Expanded output surface file"
    }
  },
