{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_dct_align",
  "description": "MRI DCT alignment tool from FreeSurfer",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_dct_align"
    },
    "source": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Source image file",
      "title": "Source"
    },
    "destination": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Destination image file",
      "title": "Destination"
    },
    "output_xform": {
      "type": "string",
      "description": "Output transformation file",
      "title": "Output Transformation"
    }
  },
  "required": [
    "@type",
    "source",
    "destination",
    "output_xform"
  ]
}