{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "spmregister",
  "description": "Registers a volume to its FreeSurfer anatomical using SPM's spm_coreg",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "registration_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registration file."
    },
    "resampled_mov": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Resampled mov volume."
    }
  },
  "required": [
    "root",
    "registration_file",
    "resampled_mov"
  ]
}