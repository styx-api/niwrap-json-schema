{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dmri_bset",
  "description": "This tool extracts a subset of volumes, b-values, and gradient directions from a diffusion MRI data set.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dwi_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output DWI series"
    },
    "output_b_table_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output b-value table"
    },
    "output_g_table_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output gradient table"
    }
  },
  "required": [
    "root",
    "output_dwi_file",
    "output_b_table_file",
    "output_g_table_file"
  ]
}