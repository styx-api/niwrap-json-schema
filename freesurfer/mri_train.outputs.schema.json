{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_train",
  "description": "Tool for training with MRI data in FreeSurfer.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file_generated": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file generated by mri_train."
    }
  },
  "required": [
    "root",
    "output_file_generated"
  ]
}