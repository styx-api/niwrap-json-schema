{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_map_cpdat",
  "description": "Maps a control.dat file to a different space using an LTA",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_ctrl_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output control point text file"
    }
  },
  "required": [
    "root",
    "output_ctrl_file"
  ]
}