{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_modify",
  "description": "Tool for modifying MRI image headers",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_modify"
    },
    "x_ras": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "X direction cosines (xr, xa, xs)",
      "title": "X RAS Cosines"
    },
    "y_ras": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Y direction cosines (yr, ya, ys)",
      "title": "Y RAS Cosines"
    },
    "z_ras": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Z direction cosines (zr, za, zs)",
      "title": "Z RAS Cosines"
    },
    "cras": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Center RAS coordinates (cr, ca, cs)",
      "title": "Center RAS"
    },
    "x_size": {
      "type": "number",
      "description": "Size of voxel in X dimension",
      "title": "X Size"
    },
    "y_size": {
      "type": "number",
      "description": "Size of voxel in Y dimension",
      "title": "Y Size"
    },
    "z_size": {
      "type": "number",
      "description": "Size of voxel in Z dimension",
      "title": "Z Size"
    },
    "tr": {
      "type": "number",
      "description": "Repetition time (TR)",
      "title": "Repetition Time"
    },
    "te": {
      "type": "number",
      "description": "Echo time (TE)",
      "title": "Echo Time"
    },
    "ti": {
      "type": "number",
      "description": "Inversion time (TI)",
      "title": "Inversion Time"
    },
    "fa": {
      "type": "number",
      "description": "Flip angle (degrees)",
      "title": "Flip Angle"
    },
    "xform": {
      "type": "string",
      "description": "New transformation file name",
      "title": "Transformation File"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume",
      "title": "Input Volume"
    },
    "output_volume": {
      "type": "string",
      "description": "Output volume",
      "title": "Output Volume"
    }
  },
  "required": [
    "@type",
    "x_ras",
    "y_ras",
    "z_ras",
    "cras",
    "x_size",
    "y_size",
    "z_size",
    "tr",
    "te",
    "ti",
    "fa",
    "xform",
    "input_volume",
    "output_volume"
  ]
}