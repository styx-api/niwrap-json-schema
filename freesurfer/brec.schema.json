{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brec",
  "description": "A description for brec tool could not be retrieved",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/brec"
    },
    "my_file": {
      "type": "string",
      "description": "Input file with .rec extension",
      "title": "My File"
    },
    "depth_limit": {
      "type": "boolean",
      "description": "Optional depth limit flag",
      "title": "Depth Limit",
      "default": false
    }
  },
  "required": [
    "@type",
    "my_file"
  ]
}