  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "aseg_outfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Automatic segmentation (aseg) output file"
    }
  },
  "required": [
    "root",
    "aseg_outfile"
  ]
}