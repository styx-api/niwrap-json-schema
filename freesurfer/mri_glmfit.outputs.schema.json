{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mri_glmfit",
  "description": "Performs general linear model (GLM) analysis in the volume or the surface.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "regression_coefs": {
      "type": "string",
      "x-styx-type": "path",
      "description": "All regression coefficients (B)."
    },
    "residual_error": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Residual error."
    },
    "residual_variance": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Residual error variance."
    },
    "residual_stddev": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Residual error standard deviation."
    },
    "fsgd_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "FSGD file if one was input."
    },
    "normalized_weights": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Normalized weights with --w or --wls."
    },
    "signal_estimate": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Signal estimate with --save-yhat."
    },
    "final_mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Final mask when a mask is used."
    },
    "design_condition": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Design matrix condition at each voxel with --save-cond."
    },
    "contrast_output_dir": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Directory for each contrast output files."
    }
  },
  "required": [
    "root",
    "regression_coefs",
    "residual_error",
    "residual_variance",
    "residual_stddev",
    "fsgd_output",
    "normalized_weights",
    "signal_estimate",
    "final_mask",
    "design_condition",
    "contrast_output_dir"
  ]
}