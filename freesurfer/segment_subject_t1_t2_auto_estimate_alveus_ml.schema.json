{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "segmentSubjectT1T2_autoEstimateAlveusML",
  "description": "Tool for automatic estimation of the alveus in MR images using T1 and T2 contrast.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/segmentSubjectT1T2_autoEstimateAlveusML"
    },
    "input_t1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input T1-weighted MR image.",
      "title": "Input T1 Image"
    },
    "input_t2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input T2-weighted MR image.",
      "title": "Input T2 Image"
    },
    "output_directory": {
      "type": "string",
      "description": "Directory to save the output files.",
      "title": "Output Directory"
    },
    "other_options": {
      "type": "string",
      "description": "Additional command-line options.",
      "title": "Other Options"
    }
  },
  "required": [
    "@type",
    "input_t1",
    "input_t2",
    "output_directory"
  ]
}