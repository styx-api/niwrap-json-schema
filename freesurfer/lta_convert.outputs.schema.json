{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "lta_convert",
  "description": "This program converts between different linear transform formats.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_transform_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output transformed file."
    }
  },
  "required": [
    "root",
    "output_transform_file"
  ]
}