{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "imgreg_4dfp",
  "description": "Image registration utility using 4dfp",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/imgreg_4dfp"
    },
    "target_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Target image",
      "title": "Target Image"
    },
    "target_mask": {
      "type": "string",
      "description": "Target mask",
      "title": "Target Mask",
      "default": "none"
    },
    "source_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Source image",
      "title": "Source Image"
    },
    "source_mask": {
      "type": "string",
      "description": "Source mask",
      "title": "Source Mask",
      "default": "none"
    },
    "t4file": {
      "type": "string",
      "description": "Transformation file",
      "title": "T4 File"
    },
    "mode": {
      "type": "string",
      "description": "Mode of operation",
      "title": "Mode"
    }
  },
  "required": [
    "@type",
    "target_image",
    "source_image",
    "t4file",
    "mode"
  ]
}