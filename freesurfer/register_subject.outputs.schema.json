{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "register_subject",
  "description": "Tool for registering brain MR volumes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "normalized_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Intensity normalized output volume."
    },
    "transformed_fsamples": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Transformed control points."
    }
  },
  "required": [
    "root",
    "normalized_output",
    "transformed_fsamples"
  ]
}