{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mri_fslmat_to_lta",
  "description": "This program creates the LTA transformation file using information from the src and target volumes and an FSL matrix file",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mri_fslmat_to_lta"
    },
    "src_vol": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Source volume file",
      "title": "Source Volume"
    },
    "target_vol": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Target volume file",
      "title": "Target Volume"
    },
    "fslmat_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "FSL transformation matrix file",
      "title": "FSL Matrix File"
    },
    "lta_file": {
      "type": "string",
      "description": "Output LTA transformation file",
      "title": "LTA File"
    }
  },
  "required": [
    "@type",
    "src_vol",
    "target_vol",
    "fslmat_file",
    "lta_file"
  ]
}