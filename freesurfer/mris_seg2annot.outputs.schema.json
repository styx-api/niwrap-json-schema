{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "mris_seg2annot",
  "description": "Converts a surface-based segmentation into a custom annotation file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "annotation_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output custom annotation file."
    }
  },
  "required": [
    "root",
    "annotation_file"
  ]
}