{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mris_nudge",
  "description": "A tool to nudge vertex positions on a surface using a volume.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "freesurfer/mris_nudge"
    },
    "input_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file for nudging",
      "title": "Input Surface"
    },
    "input_volume": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input volume file",
      "title": "Input Volume"
    },
    "vertex": {
      "type": "integer",
      "description": "Vertex to nudge",
      "title": "Vertex"
    },
    "target_val": {
      "type": "number",
      "description": "Target value for nudging",
      "title": "Target Value"
    },
    "nbhd": {
      "type": "integer",
      "description": "Neighborhood size for nudge operation",
      "title": "Neighborhood"
    }
  },
  "required": [
    "@type",
    "input_surface",
    "input_volume",
    "vertex",
    "target_val",
    "nbhd"
  ]
}