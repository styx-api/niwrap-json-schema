{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "run_fastsurfer.sh",
  "description": "run_fastsurfer.sh takes a T1 full head image and creates segmentation using FastSurferVINN and surfaces using recon-surf",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "segmentation": {
      "type": "string",
      "x-styx-type": "path",
      "description": "FastSurferVINN segmentation output"
    },
    "surface_files": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated surface files"
    },
    "cerebellum_seg": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Cerebellum segmentation output"
    },
    "qc_snapshots": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Quality control snapshot images"
    },
    "bias_corrected": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Bias field corrected image"
    }
  },
  "required": [
    "root",
    "segmentation",
    "surface_files",
    "cerebellum_seg",
    "qc_snapshots",
    "bias_corrected"
  ]
}