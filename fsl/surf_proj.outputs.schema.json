{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "surf_proj",
  "description": "Projects data onto a surface mesh using specified parameters.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "projected_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of the projection"
    },
    "output_surface": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output surface file"
    }
  },
  "required": [
    "root",
    "projected_output",
    "output_surface"
  ]
}