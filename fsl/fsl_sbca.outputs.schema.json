{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fsl_sbca",
  "description": "Performs seed-based correlation analysis on FMRI data using either a single seed coordinate or a seed mask",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_seed_mask_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output seed mask image"
    },
    "output_seed_mask_image_base": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output seed mask image"
    },
    "output_confound_time_courses": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output confound time courses"
    }
  },
  "required": [
    "root",
    "output_seed_mask_image",
    "output_seed_mask_image_base",
    "output_confound_time_courses"
  ]
}