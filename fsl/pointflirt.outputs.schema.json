{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "pointflirt",
  "description": "A tool to align point coordinates between volumes and compute affine transformation matrices.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_matrix_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Affine matrix output file"
    }
  },
  "required": [
    "root",
    "output_matrix_file"
  ]
}