{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fsl_ents",
  "description": "Extract component time series from a MELODIC .ica directory",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_time_series": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File to save time series to"
    }
  },
  "required": [
    "root",
    "out_time_series"
  ]
}