{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fsl_boxplot",
  "description": "Tool for creating boxplot images from ASCII text matrices",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/fsl_boxplot"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "Comma-separated list of input file names (ASCII text matrices, one column per boxplot)",
      "title": "Input files"
    },
    "output_image": {
      "type": "string",
      "description": "Output filename for the PNG file",
      "title": "Output image"
    },
    "help_flag": {
      "type": "boolean",
      "description": "Display this help message",
      "title": "Help flag",
      "default": false
    },
    "title": {
      "type": "string",
      "description": "Plot title",
      "title": "Title"
    },
    "legend_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File name of ASCII text file, one row per legend entry",
      "title": "Legend file"
    },
    "x_label": {
      "type": "string",
      "description": "X-axis label",
      "title": "X-axis label"
    },
    "y_label": {
      "type": "string",
      "description": "Y-axis label",
      "title": "Y-axis label"
    },
    "plot_height": {
      "type": "number",
      "description": "Plot height in pixels (default 450)",
      "title": "Plot height"
    },
    "plot_width": {
      "type": "number",
      "description": "Plot width in pixels (default 80*#boxplots)",
      "title": "Plot width"
    }
  },
  "required": [
    "@type",
    "input_files",
    "output_image"
  ]
}