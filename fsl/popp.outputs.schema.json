{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "popp",
  "description": "Physiological data processing tool of FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "processed_data_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Processed physiological data output"
    },
    "timing_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Timing and triggers output"
    },
    "rvt_data_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "RVT data output file"
    },
    "heartrate_data_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Heartrate data output file"
    }
  },
  "required": [
    "root",
    "processed_data_output",
    "timing_output",
    "rvt_data_output",
    "heartrate_data_output"
  ]
}