{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fnirtfileutils",
  "description": "FNIRT file utilities for FSL - Converts FNIRT warp field coefficients to other formats",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_field_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output field or coefficient volume"
    },
    "jacobian_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output jacobian determinant map volume"
    },
    "jacobian_matrix_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output full jacobian matrix 4D-map volume"
    }
  },
  "required": [
    "root",
    "output_field_file",
    "jacobian_output_file",
    "jacobian_matrix_file"
  ]
}