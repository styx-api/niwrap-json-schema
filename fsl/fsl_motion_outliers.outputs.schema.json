{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fsl_motion_outliers",
  "description": "FSL tool used to calculate motion outliers in 4D image data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_confound_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Main output confound file"
    },
    "metric_text_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Metric values saved as text file"
    },
    "metric_plot_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Metric values saved as graphical plot (png format)"
    }
  },
  "required": [
    "root",
    "output_confound_file",
    "metric_text_file",
    "metric_plot_file"
  ]
}