{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "applytopup",
  "description": "applytopup applies corrections to images using the field estimates produced by topup.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The output warped image."
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}