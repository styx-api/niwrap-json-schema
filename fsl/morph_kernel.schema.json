{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "morph_kernel",
  "description": "Tool to generate morphological kernels",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/morph_kernel"
    },
    "cube_side_length": {
      "type": "number",
      "description": "Side length of the cube (e.g., 11)",
      "title": "Cube side length"
    },
    "sphere_radius": {
      "type": "number",
      "description": "Radius of the sphere (e.g., 5.5)",
      "title": "Sphere radius"
    }
  },
  "required": [
    "@type",
    "cube_side_length",
    "sphere_radius"
  ]
}