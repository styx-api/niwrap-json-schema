{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "wpng",
  "description": "Simple PGM/PPM/PAM to PNG Converter",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Converted PNG file"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}