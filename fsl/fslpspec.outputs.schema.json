{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslpspec",
  "description": "Estimate the power spectrum of 4D fMRI time series data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_pspec": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output power spectrum image"
    }
  },
  "required": [
    "root",
    "output_pspec"
  ]
}