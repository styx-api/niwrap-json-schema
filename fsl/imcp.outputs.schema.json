{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "imcp",
  "description": "Copy images from one location to another",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfiles": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file or directory"
    }
  },
  "required": [
    "root",
    "outfiles"
  ]
}