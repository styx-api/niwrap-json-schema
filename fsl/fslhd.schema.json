{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fslhd",
  "description": "Display header information from a NIFTI file",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/fslhd"
    },
    "xml_flag": {
      "type": "boolean",
      "description": "Print an XML-style NIFTI header",
      "title": "XML flag",
      "default": false
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input NIFTI file",
      "title": "Input file"
    }
  },
  "required": [
    "@type",
    "input_file"
  ]
}