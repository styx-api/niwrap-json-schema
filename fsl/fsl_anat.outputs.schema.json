{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fsl_anat",
  "description": "A wrapper for FSL tools to process anatomical scans.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_anat_dir": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output anatomical directory"
    }
  },
  "required": [
    "root",
    "output_anat_dir"
  ]
}