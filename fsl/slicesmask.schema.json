{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "slicesmask",
  "description": "Tool for masking slices from an image using a mask",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/slicesmask"
    },
    "image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input image file",
      "title": "Input Image"
    },
    "mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mask file",
      "title": "Mask File"
    },
    "output": {
      "type": "string",
      "description": "Output file",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "image",
    "mask",
    "output"
  ]
}