{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "tbss_fill",
  "description": "Tool for filling skeletonized FA images in TBSS",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "filled_skeleton": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filled skeletonized FA image"
    }
  },
  "required": [
    "root",
    "filled_skeleton"
  ]
}