{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "concat_bvars",
  "description": "Concatenate multiple .bvars files into a single .bvars file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Concatenated output .bvars file"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}