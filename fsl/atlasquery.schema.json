{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "atlasquery",
  "description": "Structural lookup tool for FSL atlases.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/atlasquery"
    },
    "dumpatlases_flag": {
      "type": "boolean",
      "description": "Dump a list of available atlases",
      "title": "Dump atlases flag",
      "default": false
    },
    "atlas": {
      "type": "string",
      "description": "Name of atlas to use",
      "title": "Atlas name"
    },
    "coord": {
      "type": "string",
      "description": "Coordinate to query in the format X,Y,Z",
      "title": "Coordinate"
    },
    "mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "A mask image to use during structural lookups",
      "title": "Mask image"
    },
    "verbose_flag": {
      "type": "boolean",
      "description": "Switch on diagnostic messages",
      "title": "Verbose flag",
      "default": false
    },
    "help_flag": {
      "type": "boolean",
      "description": "Show help message and exit",
      "title": "Help flag",
      "default": false
    }
  },
  "required": [
    "@type"
  ]
}