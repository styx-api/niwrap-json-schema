{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "oxford_asl",
  "description": "Calculate perfusion maps from ASL data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dir": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Directory containing the output files"
    }
  },
  "required": [
    "root",
    "output_dir"
  ]
}