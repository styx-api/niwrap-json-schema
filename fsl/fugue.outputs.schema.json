{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fugue",
  "description": "FMRIB's Utility for Geometric Unwarping of EPIs",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "fmap_out_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Fieldmap file."
    },
    "shift_out_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Voxel shift map file."
    },
    "unwarped_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Unwarped file."
    },
    "warped_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Forward warped file."
    }
  },
  "required": [
    "root",
    "fmap_out_file_outfile",
    "shift_out_file_outfile",
    "unwarped_file_outfile",
    "warped_file_outfile"
  ]
}