{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fslinfo",
  "description": "Display information about NIFTI-1 image file",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/fslinfo"
    },
    "filename": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input NIFTI-1 image file (e.g. img.nii.gz)",
      "title": "Input file"
    }
  },
  "required": [
    "@type",
    "filename"
  ]
}