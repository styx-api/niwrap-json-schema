{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "split_parts_gpu",
  "description": "Splits parts of data for GPU processing",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/split_parts_gpu"
    },
    "datafile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input data file",
      "title": "Data file"
    },
    "maskfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input mask file",
      "title": "Mask file"
    },
    "bvals_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "bvals file",
      "title": "bvals file"
    },
    "bvecs_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "bvecs file",
      "title": "bvecs file"
    },
    "grad_file": {
      "type": "string",
      "description": "Gradient file (can be null)",
      "title": "Gradient file"
    },
    "use_grad_file": {
      "type": "integer",
      "description": "Use gradient file (0 or 1)",
      "title": "Use gradient file"
    },
    "total_num_parts": {
      "type": "integer",
      "description": "Total number of parts",
      "title": "Total number of parts"
    },
    "output_directory": {
      "type": "string",
      "description": "Output directory",
      "title": "Output directory"
    }
  },
  "required": [
    "@type",
    "datafile",
    "maskfile",
    "bvals_file",
    "bvecs_file",
    "use_grad_file",
    "total_num_parts",
    "output_directory"
  ]
}