{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feat_model",
  "description": "Generate design matrices for use by FEAT",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/feat_model"
    },
    "design_name_root": {
      "type": "string",
      "description": "Design name root",
      "title": "Design Name Root"
    },
    "confound_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Confound matrix text file",
      "title": "Confound Matrix"
    }
  },
  "required": [
    "@type",
    "design_name_root"
  ]
}