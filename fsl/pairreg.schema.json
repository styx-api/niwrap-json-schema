{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pairreg",
  "description": "Pairwise registration tool",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/pairreg"
    },
    "brain1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Brain image 1 (used as -ref internally)",
      "title": "Brain Image 1"
    },
    "brain2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Brain image 2",
      "title": "Brain Image 2"
    },
    "skull1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Skull image 1 (used as -ref internally)",
      "title": "Skull Image 1"
    },
    "skull2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Skull image 2",
      "title": "Skull Image 2"
    },
    "outputmatrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output transformation matrix file",
      "title": "Output Matrix"
    },
    "extra_flirt_args": {
      "type": "string",
      "description": "Extra arguments to pass to flirt",
      "title": "Extra FLIRT Arguments"
    }
  },
  "required": [
    "@type",
    "brain1",
    "brain2",
    "skull1",
    "skull2",
    "outputmatrix"
  ]
}