{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "tsplot",
  "description": "Time series plotting tool for FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "timeseries_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output timeseries data"
    }
  },
  "required": [
    "root",
    "timeseries_output"
  ]
}