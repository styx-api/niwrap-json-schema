{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fslinterleave",
  "description": "Interleaves two input images slice-by-slice to produce an output image.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/fslinterleave"
    },
    "infile1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First input image",
      "title": "Input file 1"
    },
    "infile2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Second input image",
      "title": "Input file 2"
    },
    "outfile": {
      "type": "string",
      "description": "Output interleaved image",
      "title": "Output file"
    },
    "reverse_slice_order_flag": {
      "type": "boolean",
      "description": "Reverse slice order",
      "title": "Reverse slice order flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "infile1",
    "infile2",
    "outfile"
  ]
}