{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "distancemap",
  "description": "A tool to calculate distance maps using FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_distancemap": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output distance map image"
    },
    "output_local_maxima": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output local maxima image"
    },
    "output_segmented_image": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output segmented distance map image"
    }
  },
  "required": [
    "root",
    "output_distancemap",
    "output_local_maxima",
    "output_segmented_image"
  ]
}