{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tbss_fill",
  "description": "Tool for filling skeletonized FA images in TBSS",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/tbss_fill"
    },
    "stats_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Stats image",
      "title": "Statistics image"
    },
    "threshold": {
      "type": "number",
      "description": "Threshold value",
      "title": "Threshold"
    },
    "mean_fa": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mean FA image",
      "title": "Mean FA image"
    },
    "output": {
      "type": "string",
      "description": "Output image",
      "title": "Output image"
    },
    "include_negative_flag": {
      "type": "boolean",
      "description": "Include negative stat values (below -threshold)",
      "title": "Include negative flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "stats_image",
    "threshold",
    "mean_fa",
    "output"
  ]
}