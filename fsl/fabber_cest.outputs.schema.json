{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fabber_cest",
  "description": "Fabber Model-based Analysis",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "logfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Log file"
    },
    "modelfit_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Model fit output as a 4d volume"
    },
    "residuals_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Residuals output as a 4d volume"
    },
    "modelextras_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Model extras output"
    },
    "mvn_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Final MVN distributions output"
    },
    "mean_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter means output"
    },
    "std_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter standard deviations output"
    },
    "var_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter variances output"
    },
    "zstat_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter Z statistics output"
    },
    "noise_mean_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Noise means output"
    },
    "noise_std_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Noise standard deviations output"
    },
    "free_energy_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Free energy output"
    }
  },
  "required": [
    "root",
    "logfile",
    "modelfit_out",
    "residuals_out",
    "modelextras_out",
    "mvn_out",
    "mean_out",
    "std_out",
    "var_out",
    "zstat_out",
    "noise_mean_out",
    "noise_std_out",
    "free_energy_out"
  ]
}