{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "maskdyads",
  "description": "Tool to mask dyads with threshold",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/maskdyads"
    },
    "dyads": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dyads file",
      "title": "Dyads file"
    },
    "fsamples": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input fsamples file",
      "title": "Fsamples file"
    },
    "threshold": {
      "type": "number",
      "description": "Threshold (default is 0.05)",
      "title": "Threshold"
    }
  },
  "required": [
    "@type",
    "dyads",
    "fsamples"
  ]
}