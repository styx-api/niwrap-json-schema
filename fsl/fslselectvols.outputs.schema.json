{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslselectvols",
  "description": "Select volumes from a 4D time series and output a subset 4D volume",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_4d_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output 4D image with selected volumes"
    }
  },
  "required": [
    "root",
    "output_4d_image"
  ]
}