{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "zeropad",
  "description": "Tool for zero-padding numbers to a specified length",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the zero-padded output"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}