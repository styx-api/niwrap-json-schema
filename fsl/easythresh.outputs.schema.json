{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "easythresh",
  "description": "Cluster-based statistical thresholding tool from FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_thresh_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output thresholded image"
    }
  },
  "required": [
    "root",
    "output_thresh_image"
  ]
}