{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "label2surf",
  "description": "Transform a group of labels into a surface",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/label2surf"
    },
    "input_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input surface file",
      "title": "Input Surface File"
    },
    "output_surface": {
      "type": "string",
      "description": "Output surface file",
      "title": "Output Surface File"
    },
    "labels": {
      "type": "string",
      "x-styx-type": "path",
      "description": "ASCII list of label files",
      "title": "Label Files"
    },
    "verbose_flag": {
      "type": "boolean",
      "description": "Switch on diagnostic messages",
      "title": "Verbose Flag",
      "default": false
    },
    "help_flag": {
      "type": "boolean",
      "description": "Display help message",
      "title": "Help Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "input_surface",
    "output_surface",
    "labels"
  ]
}