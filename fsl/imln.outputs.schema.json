{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "imln",
  "description": "Creates a link (called file2) to file1",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_link": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The created link to the input file"
    }
  },
  "required": [
    "root",
    "output_link"
  ]
}