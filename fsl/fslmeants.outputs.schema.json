{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslmeants",
  "description": "Prints average timeseries (intensities) to the screen (or saves to a file).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_text_matrix": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output text matrix from fslmeants"
    }
  },
  "required": [
    "root",
    "output_text_matrix"
  ]
}