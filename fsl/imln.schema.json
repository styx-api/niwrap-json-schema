{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "imln",
  "description": "Creates a link (called file2) to file1",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/imln"
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The source file (file1) to create a link to",
      "title": "Input File"
    },
    "link_name": {
      "type": "string",
      "description": "The name for the link (file2)",
      "title": "Link Name"
    }
  },
  "required": [
    "@type",
    "input_file",
    "link_name"
  ]
}