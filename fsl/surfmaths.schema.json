{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "surfmaths",
  "description": "A command-line tool for performing various mathematical operations on surface files.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/surfmaths"
    },
    "first_input": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First input surface file.",
      "title": "First Input"
    },
    "operations_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mathematical operations and additional inputs.",
      "title": "Operations and Inputs"
    },
    "output": {
      "type": "string",
      "description": "Output surface file.",
      "title": "Output"
    }
  },
  "required": [
    "@type",
    "first_input",
    "output"
  ]
}