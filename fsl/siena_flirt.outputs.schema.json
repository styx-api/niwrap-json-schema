{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "siena_flirt",
  "description": "Wrapper for FLIRT image registration within the SIENA framework.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_transform_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output transformation matrix file"
    },
    "output_registered_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output registered image"
    }
  },
  "required": [
    "root",
    "output_transform_matrix",
    "output_registered_image"
  ]
}