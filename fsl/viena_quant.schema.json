{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "viena_quant",
  "description": "Automated brain ventricle quantification tool",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/viena_quant"
    },
    "input1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input image 1 (e.g. img1.nii.gz)",
      "title": "Input image 1"
    },
    "input2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input image 2 (e.g. img2.nii.gz)",
      "title": "Input image 2"
    },
    "ventricle_mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Ventricle mask (e.g. mask.nii.gz)",
      "title": "Ventricle mask"
    }
  },
  "required": [
    "@type",
    "input1",
    "input2",
    "ventricle_mask"
  ]
}