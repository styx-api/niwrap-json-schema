{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslinterleave",
  "description": "Interleaves two input images slice-by-slice to produce an output image.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "interleaved_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Interleaved output image"
    }
  },
  "required": [
    "root",
    "interleaved_output"
  ]
}