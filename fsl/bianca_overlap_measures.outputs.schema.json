{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "bianca_overlap_measures",
  "description": "BIANCA overlap measures script for FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "tp_auto": {
      "type": "string",
      "x-styx-type": "path",
      "description": "True positive voxels in automatic mask"
    },
    "tp_manual": {
      "type": "string",
      "x-styx-type": "path",
      "description": "True positive voxels in manual mask"
    },
    "fp_vox_tp_overlap": {
      "type": "string",
      "x-styx-type": "path",
      "description": "False positive voxels that overlap with true positives"
    },
    "fn_vox_tp_overlap": {
      "type": "string",
      "x-styx-type": "path",
      "description": "False negative voxels that overlap with true positives"
    },
    "lesmask_idx": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Indexed lesion mask"
    },
    "manualmask_idx": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Indexed manual mask"
    },
    "lesmask_idx_tp": {
      "type": "string",
      "x-styx-type": "path",
      "description": "True positive indexed lesion mask"
    },
    "manualmask_idx_tp": {
      "type": "string",
      "x-styx-type": "path",
      "description": "True positive indexed manual mask"
    }
  },
  "required": [
    "root",
    "tp_auto",
    "tp_manual",
    "fp_vox_tp_overlap",
    "fn_vox_tp_overlap",
    "lesmask_idx",
    "manualmask_idx",
    "lesmask_idx_tp",
    "manualmask_idx_tp"
  ]
}