{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "extracttxt",
  "description": "Extracts text from a file based on a search word",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Extracted text output file"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}