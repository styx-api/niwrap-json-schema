{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fslanimate",
  "description": "Tool for creating animations from imaging data",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/fslanimate"
    },
    "input_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input image file (e.g., input.nii.gz)",
      "title": "Input file"
    },
    "output_file": {
      "type": "string",
      "description": "Output file (e.g., output.gif)",
      "title": "Output file"
    },
    "tmp_dir": {
      "type": "string",
      "description": "Temporary directory for intermediate files",
      "title": "Temporary directory"
    }
  },
  "required": [
    "@type",
    "input_file",
    "output_file"
  ]
}