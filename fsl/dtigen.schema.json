{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dtigen",
  "description": "Generate diffusion data using tensor model",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/dtigen"
    },
    "tensor": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input tensor file",
      "title": "Input tensor"
    },
    "s0": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input S0 file",
      "title": "Input S0"
    },
    "output_data": {
      "type": "string",
      "description": "Output data file",
      "title": "Output data"
    },
    "bvecs": {
      "type": "string",
      "x-styx-type": "path",
      "description": "bvecs ASCII text file",
      "title": "Bvecs file"
    },
    "bvals": {
      "type": "string",
      "x-styx-type": "path",
      "description": "bvals ASCII text file",
      "title": "Bvals file"
    },
    "brainmask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Brain mask file",
      "title": "Brain mask"
    },
    "kurtosis": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mean kurtosis map",
      "title": "Kurtosis map"
    },
    "help": {
      "type": "boolean",
      "description": "Display help message",
      "title": "Help",
      "default": false
    }
  },
  "required": [
    "@type",
    "tensor",
    "s0",
    "output_data",
    "bvecs",
    "bvals",
    "brainmask"
  ]
}