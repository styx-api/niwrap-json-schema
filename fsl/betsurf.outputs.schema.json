{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "betsurf",
  "description": "BET Surface Finder to extract brain surfaces using T1 and T2 images",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated binary mask"
    },
    "output_outline": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated surface outline"
    },
    "output_skull": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated skull mask"
    }
  },
  "required": [
    "root",
    "output_mask",
    "output_outline",
    "output_skull"
  ]
}