{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "robustfov",
  "description": "Reduce FOV of image to remove lower head and neck.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_roi_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "ROI volume output"
    },
    "output_matrix_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Matrix output (ROI to full FOV)"
    }
  },
  "required": [
    "root",
    "output_roi_volume",
    "output_matrix_file"
  ]
}