{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "label2surf",
  "description": "Transform a group of labels into a surface",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_surf": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resulting output surface file"
    }
  },
  "required": [
    "root",
    "out_surf"
  ]
}