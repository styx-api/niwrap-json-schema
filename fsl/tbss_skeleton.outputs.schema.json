{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "tbss_skeleton",
  "description": "A tool for defining a 'skeleton' of white matter tracts in the brain to help compare them across subjects.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_image_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output skeleton image"
    },
    "projected_4d_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Projected 4D data"
    },
    "alt_4d_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Alternative 4D data"
    },
    "alt_skeleton_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Alternative skeleton image"
    },
    "debug2_image_outputs": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "De-projected skelpoints points on skeleton back to all_FA space"
    }
  },
  "required": [
    "root",
    "output_image_file",
    "projected_4d_file",
    "alt_4d_file",
    "alt_skeleton_file",
    "debug2_image_outputs"
  ]
}