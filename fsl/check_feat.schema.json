{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checkFEAT",
  "description": "Perform checks on FEAT analysis results",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/checkFEAT"
    },
    "report_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Path to the HTML report",
      "title": "Report File"
    },
    "report_log_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Path to the HTML report log",
      "title": "Report Log File"
    }
  },
  "required": [
    "@type",
    "report_file",
    "report_log_file"
  ]
}