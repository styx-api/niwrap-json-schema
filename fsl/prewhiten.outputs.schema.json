{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "prewhiten",
  "description": "Prewhitening tool for FEAT directories",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_directory": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Specified output directory containing generated output files."
    }
  },
  "required": [
    "root",
    "output_directory"
  ]
}