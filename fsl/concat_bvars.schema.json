{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "concat_bvars",
  "description": "Concatenate multiple .bvars files into a single .bvars file",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/concat_bvars"
    },
    "output_bvars": {
      "type": "string",
      "description": "Output .bvars file",
      "title": "Output BVARS file"
    },
    "input_bvars": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "List of input .bvars files",
      "title": "Input BVARS files"
    }
  },
  "required": [
    "@type",
    "output_bvars",
    "input_bvars"
  ]
}