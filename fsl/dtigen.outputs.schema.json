{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dtigen",
  "description": "Generate diffusion data using tensor model",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_diffusion_data": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output diffusion data"
    },
    "output_kurtosis_map": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Mean kurtosis map"
    }
  },
  "required": [
    "root",
    "output_diffusion_data",
    "output_kurtosis_map"
  ]
}