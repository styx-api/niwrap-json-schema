{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "bedpostx",
  "description": "Bayesian Estimation of Diffusion Parameters Obtained using Sampling Techniques (BEDPOST) for modeling multiple fibers per voxel.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "xfms_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output transformations directory."
    },
    "diff_slices_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output diffusion slices directory."
    }
  },
  "required": [
    "root",
    "xfms_output",
    "diff_slices_output"
  ]
}