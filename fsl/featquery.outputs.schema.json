{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "featquery",
  "description": "Tool to extract statistics and/or time series from FEAT directories",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "query_report": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated query report file"
    }
  },
  "required": [
    "root",
    "query_report"
  ]
}