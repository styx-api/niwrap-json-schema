{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fnirt",
  "description": "FSL non-linear registration",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "field_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with warp field."
    },
    "fieldcoeff_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with field coefficients."
    },
    "jacobian_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File containing jacobian of the field."
    },
    "log_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Name of log-file."
    },
    "modulatedref_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File containing intensity modulated --ref."
    },
    "warped_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Warped image."
    }
  },
  "required": [
    "root",
    "field_file_outfile",
    "fieldcoeff_file_outfile",
    "jacobian_file_outfile",
    "log_file_outfile",
    "modulatedref_file_outfile",
    "warped_file_outfile"
  ]
}