{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dtifit",
  "description": "DTIFIT - Fit a diffusion tensor model at each voxel",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "fa_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Fractional anisotropy output"
    },
    "md_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mean diffusivity output"
    },
    "mo_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mode of the anisotropy output"
    },
    "l1_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "1st eigenvalue output"
    },
    "l2_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "2nd eigenvalue output"
    },
    "l3_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "3rd eigenvalue output"
    }
  },
  "required": [
    "root",
    "fa_output",
    "md_output",
    "mo_output",
    "l1_output",
    "l2_output",
    "l3_output"
  ]
}