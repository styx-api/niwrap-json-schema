{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "b0calc",
  "description": "B0 field calculation program",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "b0_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "B0 output volume"
    },
    "b0_output_x": {
      "type": "string",
      "x-styx-type": "path",
      "description": "B0 x-component output volume (if --xyz is specified)"
    },
    "b0_output_y": {
      "type": "string",
      "x-styx-type": "path",
      "description": "B0 y-component output volume (if --xyz is specified)"
    },
    "b0_output_z": {
      "type": "string",
      "x-styx-type": "path",
      "description": "B0 z-component output volume (if --xyz is specified)"
    }
  },
  "required": [
    "root",
    "b0_output",
    "b0_output_x",
    "b0_output_y",
    "b0_output_z"
  ]
}