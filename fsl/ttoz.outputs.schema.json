{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ttoz",
  "description": "Tool to convert a T-statistic image to a Z-statistic image",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_zvol": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output Z-statistic volume"
    }
  },
  "required": [
    "root",
    "output_zvol"
  ]
}