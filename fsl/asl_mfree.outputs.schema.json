{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "asl_mfree",
  "description": "ASL model-free analysis tool",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "result_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output results from ASL model-free analysis"
    },
    "bat_img": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Estimated tissue BAT image file"
    }
  },
  "required": [
    "root",
    "result_file",
    "bat_img"
  ]
}