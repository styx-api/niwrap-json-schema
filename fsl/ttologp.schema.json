{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ttologp",
  "description": "Tool for computing logp",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/ttologp"
    },
    "varsfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Path to the vars file",
      "title": "Vars File"
    },
    "cbsfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Path to the cbs file",
      "title": "CBS File"
    },
    "dof": {
      "type": "string",
      "description": "Degree of freedom",
      "title": "DOF"
    },
    "outputvol": {
      "type": "string",
      "description": "Output volume for logp value (default is logps)",
      "title": "Logp Output Volume"
    },
    "help_flag": {
      "type": "boolean",
      "description": "Display help information and exit",
      "title": "Help Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "varsfile",
    "cbsfile",
    "dof"
  ]
}