{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fdr",
  "description": "False Discovery Rate (FDR) correction tool from FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_adjusted": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output FDR-adjusted p-values image"
    },
    "output_thresholded": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Thresholded output p-value image"
    },
    "output_order": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output order values image"
    }
  },
  "required": [
    "root",
    "output_adjusted",
    "output_thresholded",
    "output_order"
  ]
}