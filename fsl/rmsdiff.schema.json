{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rmsdiff",
  "description": "Outputs RMS deviation between matrices (in mm)",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/rmsdiff"
    },
    "matrixfile1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First matrix file",
      "title": "Matrix file 1"
    },
    "matrixfile2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Second matrix file",
      "title": "Matrix file 2"
    },
    "refvol": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Reference volume",
      "title": "Reference volume"
    },
    "mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Optional mask",
      "title": "Mask file"
    }
  },
  "required": [
    "@type",
    "matrixfile1",
    "matrixfile2",
    "refvol"
  ]
}