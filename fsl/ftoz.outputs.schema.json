{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ftoz",
  "description": "Convert F-statistics to Z-scores.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_zscores": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File containing the converted Z-scores"
    }
  },
  "required": [
    "root",
    "output_zscores"
  ]
}