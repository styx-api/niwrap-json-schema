{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fabber_qbold",
  "description": "Fabber - a flexible BaYesian modeling framework for FMRI and MRI analysis.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "paramnames_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the names of the model parameters"
    },
    "model_fit_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "4D volume of the model prediction"
    },
    "residuals_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "4D volume of the residuals"
    },
    "model_extras_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Additional model-specific timeseries data"
    },
    "mvn_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the final MVN distributions"
    },
    "mean_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the parameter means"
    },
    "std_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the parameter standard deviations"
    },
    "var_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the parameter variances"
    },
    "zstat_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the parameter Zstats"
    },
    "noise_mean_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the noise means"
    },
    "noise_std_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the noise standard deviations"
    },
    "free_energy_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the free energy, if calculated"
    },
    "logfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Logfile of the execution"
    }
  },
  "required": [
    "root",
    "paramnames_file",
    "model_fit_file",
    "residuals_file",
    "model_extras_file",
    "mvn_file",
    "mean_file",
    "std_file",
    "var_file",
    "zstat_file",
    "noise_mean_file",
    "noise_std_file",
    "free_energy_file",
    "logfile"
  ]
}