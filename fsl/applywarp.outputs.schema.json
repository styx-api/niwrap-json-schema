{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "applywarp",
  "description": "Apply warps estimated by FNIRT (or some other software) to some image.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_file_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Warped output file."
    }
  },
  "required": [
    "root",
    "out_file_outfile"
  ]
}