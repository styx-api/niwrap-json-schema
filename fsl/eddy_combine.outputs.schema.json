{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "eddy_combine",
  "description": "Combines diffusion data sets with opposite phase encoding directions for use with FSL's EDDY.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "combined_data": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Combined positive and negative phase-encoded data"
    },
    "combined_bvals": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Combined b-values file"
    },
    "combined_bvecs": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Combined b-vectors file"
    }
  },
  "required": [
    "root",
    "combined_data",
    "combined_bvals",
    "combined_bvecs"
  ]
}