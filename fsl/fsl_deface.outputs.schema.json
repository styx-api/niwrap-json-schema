{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fsl_deface",
  "description": "Tool to deface a structural T1w image.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Defaced T1w image"
    },
    "out_defacing_mask": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Defacing mask file"
    },
    "out_cropped_struc": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Cropped structural image file"
    },
    "out_orig_to_std_mat": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Affine matrix from original struct to std"
    },
    "out_orig_to_cropped_mat": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Affine matrix from original struct to cropped struct"
    },
    "out_cropped_to_std_mat": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Affine matrix from cropped struct to std"
    },
    "qc_image_original": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "QC image for defacing (original)"
    },
    "qc_image_cropped": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "QC image for defacing (cropped)"
    }
  },
  "required": [
    "root",
    "outfile",
    "out_defacing_mask",
    "out_cropped_struc",
    "out_orig_to_std_mat",
    "out_orig_to_cropped_mat",
    "out_cropped_to_std_mat",
    "qc_image_original",
    "qc_image_cropped"
  ]
}