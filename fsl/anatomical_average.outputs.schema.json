{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AnatomicalAverage",
  "description": "Tool to create an anatomical average of input brain images",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "avg_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Averaged anatomical image"
    }
  },
  "required": [
    "root",
    "avg_output"
  ]
}