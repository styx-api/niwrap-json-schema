{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslsplit",
  "description": "Split a 4D image into separate volumes or a 3D image into separate slices",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_files": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output volumes/slices"
    }
  },
  "required": [
    "root",
    "out_files"
  ]
}