{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fabber_asl",
  "description": "Fabber is a tool for automated model fitting of time series data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "logfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Log file of Fabber output"
    },
    "modelfit": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Model fit output"
    },
    "residuals": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Residuals output"
    },
    "model_extras": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Model specific timeseries data"
    },
    "mvn": {
      "type": "string",
      "x-styx-type": "path",
      "description": "MVN distributions"
    },
    "means": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter means"
    },
    "stds": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter standard deviations"
    },
    "variances": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter variances"
    },
    "zstats": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Parameter Zstats"
    },
    "noise_means": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Noise means"
    },
    "noise_stds": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Noise standard deviations"
    },
    "free_energy": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Free energy"
    }
  },
  "required": [
    "root",
    "logfile",
    "modelfit",
    "residuals",
    "model_extras",
    "mvn",
    "means",
    "stds",
    "variances",
    "zstats",
    "noise_means",
    "noise_stds",
    "free_energy"
  ]
}