{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "sliceanimate",
  "description": "A tool for animating slices of an image using whirlgif",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "animated_gif": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated animated GIF"
    }
  },
  "required": [
    "root",
    "animated_gif"
  ]
}