  "title": "fslstats",
  "description": "FSL tool for calculating statistics on image data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_stats": {
      "type": "string",
      "x-styx-type": "path",
