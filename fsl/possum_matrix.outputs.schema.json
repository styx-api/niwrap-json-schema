{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "possum_matrix",
  "description": "Event matrix generator for POSSUM simulation in FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_main_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Main event matrix output file"
    }
  },
  "required": [
    "root",
    "output_main_matrix"
  ]
}