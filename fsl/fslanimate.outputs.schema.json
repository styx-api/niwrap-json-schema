{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslanimate",
  "description": "Tool for creating animations from imaging data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_animation": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The resulting animation file"
    }
  },
  "required": [
    "root",
    "output_animation"
  ]
}