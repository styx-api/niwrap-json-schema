{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ttologp",
  "description": "Tool for computing logp",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_logpvol": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output volume for logp value"
    }
  },
  "required": [
    "root",
    "output_logpvol"
  ]
}