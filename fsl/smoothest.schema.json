{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "smoothest",
  "description": "Tool to estimate smoothness of data from FSL",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/smoothest"
    },
    "dof": {
      "type": "number",
      "description": "Number of degrees of freedom",
      "title": "Degrees of Freedom"
    },
    "residual_fit_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filename of `residual-fit` image (use -d)",
      "title": "Residual Fit Image"
    },
    "zstat_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filename of zstat image (not with -d)",
      "title": "Zstat Image"
    },
    "mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Brain mask volume",
      "title": "Brain Mask"
    },
    "verbose_flag": {
      "type": "boolean",
      "description": "Switch on diagnostic messages",
      "title": "Verbose Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "mask"
  ]
}