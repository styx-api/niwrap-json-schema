{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sliceanimate",
  "description": "A tool for animating slices of an image using whirlgif",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/sliceanimate"
    },
    "output_file": {
      "type": "string",
      "description": "Output animated GIF file",
      "title": "Output File"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "Input image files for animation",
      "title": "Input Files"
    }
  },
  "required": [
    "@type",
    "output_file",
    "input_files"
  ]
}