{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "slices_summary",
  "description": "Generate summary PNG images for 4D neuroimaging data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "summary_images_directory": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Directory containing summary images"
    },
    "combined_summary_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Combined summary PNG image"
    }
  },
  "required": [
    "root",
    "summary_images_directory",
    "combined_summary_image"
  ]
}