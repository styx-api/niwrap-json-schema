{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "melodic",
  "description": "Multivariate Exploratory Linear Optimised Decomposition into Independent Components",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "report_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output Melodic web report"
    },
    "ics_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output IC components file"
    },
    "mix_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output mixing matrix file"
    },
    "temporal_mode_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output matrix of temporal modes"
    },
    "melodic_report_directory": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output Melodic report directory"
    }
  },
  "required": [
    "root",
    "report_file",
    "ics_output_file",
    "mix_output_file",
    "temporal_mode_file",
    "melodic_report_directory"
  ]
}