{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fslvbm_3_proc",
  "description": "Pipeline for voxel-based morphometry analysis using FSL tools",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/fslvbm_3_proc"
    },
    "arch": {
      "type": "string",
      "description": "Specify architecture",
      "title": "Architecture"
    },
    "coprocessor": {
      "type": "string",
      "description": "Specify coprocessor",
      "title": "Co-Processor"
    },
    "coprocessor_multi": {
      "type": "string",
      "description": "Specify multiple coprocessors",
      "title": "Multiple Co-Processor"
    },
    "coprocessor_class": {
      "type": "string",
      "description": "Specify coprocessor class",
      "title": "Co-Processor Class"
    },
    "coprocessor_class_strict": {
      "type": "boolean",
      "description": "Use strict class matching for coprocessor",
      "title": "Strict Co-Processor Class",
      "default": false
    },
    "coprocessor_toolkit": {
      "type": "string",
      "description": "Specify coprocessor toolkit",
      "title": "Coprocessor Toolkit"
    },
    "not_requeueable": {
      "type": "boolean",
      "description": "Do not requeue the job",
      "title": "Do Not Requeue",
      "default": false
    },
    "jobhold": {
      "type": "string",
      "description": "Job to hold",
      "title": "Job Hold"
    },
    "array_hold": {
      "type": "string",
      "description": "Array hold",
      "title": "Array Hold"
    },
    "logdir": {
      "type": "string",
      "description": "Specify log directory",
      "title": "Log Directory"
    },
    "mailoptions": {
      "type": "string",
      "description": "Specify mail options",
      "title": "Mail Options"
    },
    "mailto": {
      "type": "string",
      "description": "Specify mail recipient",
      "title": "Mail Recipient"
    },
    "name": {
      "type": "string",
      "description": "Job name",
      "title": "Job Name"
    },
    "priority": {
      "type": "string",
      "description": "Job priority",
      "title": "Job Priority"
    },
    "queue": {
      "type": "string",
      "description": "Queue to submit to",
      "title": "Queue"
    },
    "resource": {
      "type": "string",
      "description": "Resource identifier",
      "title": "Resource"
    },
    "delete_job": {
      "type": "string",
      "description": "Delete specified job",
      "title": "Delete Job"
    },
    "memory_gb": {
      "type": "number",
      "description": "Memory (GB)",
      "title": "Memory (GB)"
    },
    "parallel_env_threads": {
      "type": "string",
      "description": "Parallel environment and threads",
      "title": "Parallel Environment and Threads"
    },
    "array_task": {
      "type": "string",
      "description": "Array task file",
      "title": "Array Task File"
    },
    "array_native": {
      "type": "string",
      "description": "Array native specification",
      "title": "Array Native"
    },
    "number_jobscripts": {
      "type": "number",
      "description": "Keep number of job scripts",
      "title": "Number of Job Scripts"
    },
    "keep_jobscript": {
      "type": "boolean",
      "description": "Keep job script",
      "title": "Keep Job Script",
      "default": false
    },
    "coprocessor_name": {
      "type": "string",
      "description": "Specify coprocessor name",
      "title": "Co-Processor Name"
    },
    "has_queues": {
      "type": "boolean",
      "description": "Specify queues",
      "title": "Has Queues",
      "default": false
    },
    "project": {
      "type": "string",
      "description": "Specify project name",
      "title": "Project"
    },
    "submit_scheduler": {
      "type": "boolean",
      "description": "Submit to Scheduler",
      "title": "Submit Scheduler",
      "default": false
    },
    "runtime_limit": {
      "type": "number",
      "description": "Specify runtime limit in minutes",
      "title": "Runtime Limit (Minutes)"
    },
    "show_config": {
      "type": "boolean",
      "description": "Show configuration",
      "title": "Show Configuration",
      "default": false
    },
    "verbose": {
      "type": "boolean",
      "description": "Verbose output",
      "title": "Verbose",
      "default": false
    },
    "version": {
      "type": "boolean",
      "description": "Version information",
      "title": "Version",
      "default": false
    },
    "config_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Specify configuration file",
      "title": "Configuration File"
    }
  },
  "required": [
    "@type"
  ]
}