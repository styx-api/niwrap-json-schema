{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fsl2ascii",
  "description": "Convert NIfTI image or analyze 7.5 format file to ASCII text file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_ascii_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output ASCII text file"
    }
  },
  "required": [
    "root",
    "output_ascii_file"
  ]
}