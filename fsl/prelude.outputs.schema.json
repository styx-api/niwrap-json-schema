{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "prelude",
  "description": "Phase Region Expanding Labeller for Unwrapping Discrete Estimates",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "unwrapped_phase_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Unwrapped phase output file"
    },
    "saved_mask_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved mask volume file"
    },
    "saved_raw_phase_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved raw phase output file"
    },
    "saved_area_labels_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Saved area labels output file"
    }
  },
  "required": [
    "root",
    "unwrapped_phase_output",
    "saved_mask_volume",
    "saved_raw_phase_output",
    "saved_area_labels_output"
  ]
}