{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bianca_overlap_measures",
  "description": "BIANCA overlap measures script for FSL",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/bianca_overlap_measures"
    },
    "lesion_mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Lesion mask image file",
      "title": "Lesion Mask"
    },
    "manual_mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Manual mask image file",
      "title": "Manual Mask"
    },
    "output_dir": {
      "type": "string",
      "description": "Output directory for generated files",
      "title": "Output Directory"
    }
  },
  "required": [
    "@type",
    "lesion_mask",
    "manual_mask",
    "output_dir"
  ]
}