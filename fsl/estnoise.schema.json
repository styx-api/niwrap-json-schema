{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "estnoise",
  "description": "Estimate noise in 4D fMRI data.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/estnoise"
    },
    "input_4d_data": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input 4D fMRI data (e.g., fmri_data.nii.gz)",
      "title": "Input 4D data"
    },
    "spatial_sigma": {
      "type": "number",
      "description": "Spatial smoothing sigma",
      "title": "Spatial Sigma"
    },
    "temp_hp_sigma": {
      "type": "number",
      "description": "Temporal high-pass filter sigma",
      "title": "Temporal HP Sigma"
    },
    "temp_lp_sigma": {
      "type": "number",
      "description": "Temporal low-pass filter sigma",
      "title": "Temporal LP Sigma"
    }
  },
  "required": [
    "@type",
    "input_4d_data"
  ]
}