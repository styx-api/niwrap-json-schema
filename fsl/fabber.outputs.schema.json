{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fabber",
  "description": "Fabber is a tool for model-based Bayesian analysis of time-series data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "paramnames_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the names of the model parameters"
    },
    "model_fit_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The model fit output file"
    },
    "residuals_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The residuals output file"
    },
    "model_extras_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The model extras output file"
    },
    "mvn_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The MVN distributions output file"
    },
    "mean_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The parameter means output file"
    },
    "std_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The parameter standard deviations output file"
    },
    "var_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The parameter variances output file"
    },
    "zstat_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The parameter Zstats output file"
    },
    "noise_mean_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The noise means output file"
    },
    "noise_std_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The noise standard deviations output file"
    },
    "free_energy_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The free energy output file"
    }
  },
  "required": [
    "root",
    "paramnames_file",
    "model_fit_file",
    "residuals_file",
    "model_extras_file",
    "mvn_file",
    "mean_file",
    "std_file",
    "var_file",
    "zstat_file",
    "noise_mean_file",
    "noise_std_file",
    "free_energy_file"
  ]
}