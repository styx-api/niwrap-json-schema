{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "asl_file",
  "description": "ASL data manipulation tool for FSL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_data": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Primary output data file"
    },
    "output_mean": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mean output data file"
    }
  },
  "required": [
    "root",
    "output_data",
    "output_mean"
  ]
}