{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "pulse",
  "description": "Generates a pulse sequence matrix for a given digital brain image.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_pulse_sequence_matrix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Pulse sequence matrix output"
    }
  },
  "required": [
    "root",
    "output_pulse_sequence_matrix"
  ]
}