{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fslvbm_2_template",
  "description": "FSL-VBM is a Voxel-Based Morphometry style analysis tool for FSL.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "fsl/fslvbm_2_template"
    },
    "arch": {
      "type": "string",
      "description": "Specify architecture",
      "title": "Architecture"
    },
    "coprocessor": {
      "type": "string",
      "description": "Specify coprocessor type",
      "title": "Coprocessor"
    },
    "coprocessor_multi": {
      "type": "string",
      "description": "Specify multiple coprocessors",
      "title": "Coprocessor Multi"
    },
    "coprocessor_class": {
      "type": "string",
      "description": "Specify coprocessor class",
      "title": "Coprocessor Class"
    },
    "coprocessor_toolkit": {
      "type": "string",
      "description": "Specify coprocessor toolkit",
      "title": "Coprocessor Toolkit"
    },
    "jobhold": {
      "type": "string",
      "description": "Hold job until specified job ID is completed",
      "title": "Job Hold"
    },
    "array_hold": {
      "type": "string",
      "description": "Hold array job until specified job ID is completed",
      "title": "Array Hold"
    },
    "logdir": {
      "type": "string",
      "description": "Specify log directory",
      "title": "Log Directory"
    },
    "mailoptions": {
      "type": "string",
      "description": "Specify mail options",
      "title": "Mail Options"
    },
    "mailto": {
      "type": "string",
      "description": "Specify email address for notifications",
      "title": "Mail To"
    },
    "name": {
      "type": "string",
      "description": "Specify job name",
      "title": "Job Name"
    },
    "priority": {
      "type": "string",
      "description": "Specify job priority",
      "title": "Priority"
    },
    "queue": {
      "type": "string",
      "description": "Specify queue",
      "title": "Queue"
    },
    "resource": {
      "type": "string",
      "description": "Specify resources",
      "title": "Resource"
    },
    "delete_job": {
      "type": "string",
      "description": "Delete specified job",
      "title": "Delete Job"
    },
    "memory_gb": {
      "type": "number",
      "description": "Specify memory in GB",
      "title": "Memory (GB)"
    },
    "parallel_env": {
      "type": "string",
      "description": "Specify parallel environment and threads",
      "title": "Parallel Environment"
    },
    "array_task": {
      "type": "string",
      "description": "Specify array task",
      "title": "Array Task"
    },
    "array_native": {
      "type": "string",
      "description": "Specify array native task",
      "title": "Array Native"
    },
    "num_tasks": {
      "type": "number",
      "description": "Specify number of tasks",
      "title": "Number of Tasks"
    },
    "coprocessor_name": {
      "type": "string",
      "description": "Specify coprocessor name",
      "title": "Coprocessor Name"
    },
    "project": {
      "type": "string",
      "description": "Specify project",
      "title": "Project"
    },
    "runtime_limit": {
      "type": "number",
      "description": "Specify runtime limit in minutes",
      "title": "Runtime Limit"
    },
    "job_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Specify job script file",
      "title": "Job Script File"
    }
  },
  "required": [
    "@type"
  ]
}