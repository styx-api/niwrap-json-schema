{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fslmerge",
  "description": "FSL tool to concatenate images in various dimensions",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output concatenated image file"
    }
  },
  "required": [
    "root",
    "out_file"
  ]
}