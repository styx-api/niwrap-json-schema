{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cluster",
  "description": "Uses FSL cluster to perform clustering on statistical output",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "index_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of cluster index (in size order)."
    },
    "localmax_txt_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Local maxima text file."
    },
    "localmax_vol_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of local maxima volume."
    },
    "max_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filename for output of max image."
    },
    "mean_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filename for output of mean image."
    },
    "pval_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filename for image output of log pvals."
    },
    "size_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filename for output of size image."
    },
    "threshold_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Thresholded image."
    }
  },
  "required": [
    "root",
    "index_file",
    "localmax_txt_file",
    "localmax_vol_file",
    "max_file",
    "mean_file",
    "pval_file",
    "size_file",
    "threshold_file"
  ]
}