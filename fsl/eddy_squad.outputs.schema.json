{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "eddy_squad",
  "description": "Study-wise QC for dMRI data",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "qc_results": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "QC results in JSON format"
    }
  },
  "required": [
    "root",
    "qc_results"
  ]
}