{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ConvexHull",
  "description": "A program to find the convex hull, or perform a Delaunay triangulation of a set of points.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_surf": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output surface file"
    }
  },
  "required": [
    "root",
    "out_surf"
  ]
}