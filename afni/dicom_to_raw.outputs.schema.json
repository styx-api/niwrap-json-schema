{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dicom_to_raw",
  "description": "Reads images from DICOM file and writes them to raw file(s).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_raw_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output raw file(s)"
    }
  },
  "required": [
    "root",
    "output_raw_file"
  ]
}