{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "SurfLayers",
  "description": "Compute intermediate equi-distant surfaces between two boundary surfaces.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dir": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Directory containing output files"
    }
  },
  "required": [
    "root",
    "output_dir"
  ]
}