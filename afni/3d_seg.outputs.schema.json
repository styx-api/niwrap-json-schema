{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dSeg",
  "description": "Segments brain volumes into tissue classes with optional global and voxelwise priors.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "segmented_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Segmented brain volume output"
    },
    "bias_field": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Bias field estimate output"
    },
    "classified_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Classified volume output"
    }
  },
  "required": [
    "root",
    "segmented_volume",
    "bias_field",
    "classified_volume"
  ]
}