{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dRegAna",
  "description": "Multiple linear regression analysis for AFNI datasets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_fift": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output fift dataset"
    },
    "output_fith": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output fith dataset"
    },
    "output_fitt": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output fitt dataset"
    },
    "output_bucket": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output bucket dataset"
    },
    "output_bucket_brik": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output bucket BRIK file"
    }
  },
  "required": [
    "root",
    "output_fift",
    "output_fith",
    "output_fitt",
    "output_bucket",
    "output_bucket_brik"
  ]
}