{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dANOVA",
  "description": "Performs single-factor Analysis of Variance (ANOVA) on 3D datasets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "ftr_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output F-statistic dataset file"
    },
    "ftr_brick_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output F-statistic BRIK file"
    },
    "mean_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output mean dataset file"
    },
    "mean_brick_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output mean BRIK file"
    },
    "diff_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output difference dataset file"
    },
    "diff_brick_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output difference BRIK file"
    },
    "contr_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output contrast dataset file"
    },
    "contr_brick_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output contrast BRIK file"
    },
    "bucket_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output bucket dataset file"
    },
    "bucket_brick_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output bucket BRIK file"
    }
  },
  "required": [
    "root",
    "ftr_output",
    "ftr_brick_output",
    "mean_output",
    "mean_brick_output",
    "diff_output",
    "diff_brick_output",
    "contr_output",
    "contr_brick_output",
    "bucket_output",
    "bucket_brick_output"
  ]
}