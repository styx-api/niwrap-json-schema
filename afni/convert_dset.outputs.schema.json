{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ConvertDset",
  "description": "Converts a surface dataset from one format to another.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "converted_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Converted dataset output"
    }
  },
  "required": [
    "root",
    "converted_dataset"
  ]
}