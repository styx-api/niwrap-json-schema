{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dLocalACF",
  "description": "Estimate the spatial AutoCorrelation Function (ACF) locally in a neighborhood around each voxel",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output dataset with ACF estimates"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}