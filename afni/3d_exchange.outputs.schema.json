{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dExchange",
  "description": "Replaces voxel values using a mapping file with specified columns",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_head": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output HEAD file"
    },
    "output_brik": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output BRIK file"
    }
  },
  "required": [
    "root",
    "output_head",
    "output_brik"
  ]
}