{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dGetrow",
  "description": "Program to extract 1 row from a dataset and write it as a .1D file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output .1D ASCII file"
    }
  },
  "required": [
    "root",
    "out_file"
  ]
}