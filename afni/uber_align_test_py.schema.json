{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uber_align_test.py",
  "description": "Generate script to test anatomical/EPI alignment",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/uber_align_test.py"
    },
    "no_gui": {
      "type": "boolean",
      "description": "Run without the graphical user interface (GUI)",
      "title": "No GUI",
      "default": false
    },
    "print_script": {
      "type": "boolean",
      "description": "Print the generated script to standard output",
      "title": "Print Script",
      "default": false
    },
    "save_script": {
      "type": "string",
      "description": "Save the generated script to the specified file",
      "title": "Save Script"
    },
    "user_variable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specify user variables for alignment",
      "title": "User Variables"
    },
    "qt_opts": {
      "type": "string",
      "description": "Pass PyQt4 options directly to the GUI",
      "title": "QT Options"
    },
    "help": {
      "type": "boolean",
      "description": "Show help information",
      "title": "Help",
      "default": false
    },
    "help_gui": {
      "type": "boolean",
      "description": "Show help information for the GUI",
      "title": "GUI Help",
      "default": false
    },
    "history": {
      "type": "boolean",
      "description": "Show command history",
      "title": "History",
      "default": false
    },
    "show_valid_opts": {
      "type": "boolean",
      "description": "Show valid options",
      "title": "Show Valid Options",
      "default": false
    },
    "version": {
      "type": "boolean",
      "description": "Show version information",
      "title": "Version",
      "default": false
    }
  },
  "required": [
    "@type"
  ]
}