{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@ElectroGrid",
  "description": "Creates a mesh representation of an electrode grid for use with SUMA",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_surface": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output surface file"
    }
  },
  "required": [
    "root",
    "output_surface"
  ]
}