{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@SUMA_AlignToExperiment",
  "description": "Creates a version of Surface Anatomy that is registered to Experiment Anatomy.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "aligned_volume": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output volume after alignment."
    },
    "additional_followers": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output followers dataset after transforming."
    }
  },
  "required": [
    "root",
    "aligned_volume",
    "additional_followers"
  ]
}