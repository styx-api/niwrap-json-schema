{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dCM",
  "description": "Tool for computing the center of mass of a dataset",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "stdout": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "center of mass of the dataset"
    }
  },
  "required": [
    "root",
    "stdout"
  ]
}