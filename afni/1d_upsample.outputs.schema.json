{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "1dUpsample",
  "description": "Upsamples a 1D time series to a finer time grid.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Upsampled 1D time series output"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}