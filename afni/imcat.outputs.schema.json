{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "imcat",
  "description": "Assembles a set of images into an image matrix (IM) montage of NX by NY images.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_image_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output image file"
    }
  },
  "required": [
    "root",
    "output_image_file"
  ]
}