{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Dimon",
  "description": "Monitor real-time acquisition of DICOM image files",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "sorted_files_details": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Details about sorted files"
    }
  },
  "required": [
    "root",
    "sorted_files_details"
  ]
}