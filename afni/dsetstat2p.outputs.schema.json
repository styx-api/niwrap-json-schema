{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "dsetstat2p",
  "description": "Converts a statistic to a p-value with reference to a particular dataset",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output p-value or stat value"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}