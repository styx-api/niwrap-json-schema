{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@measure_erosion_thick",
  "description": "Compute thickness of mask using erosion method.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "erosion_depth": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Depth dataset."
    },
    "erosion_thick": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Volumetric thickness dataset."
    },
    "erosion_thick_smooth": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Smoothed volumetric thickness dataset."
    },
    "erosion_thick_niml": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Unsmoothed thickness mapped to surface nodes."
    },
    "erosion_thick_smooth_niml": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Smoothed thickness mapped to surface nodes."
    },
    "maskset_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mask dataset."
    },
    "resampled_maskset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resampled mask dataset."
    },
    "anat_gii": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Surface representation of mask volume."
    },
    "quick_spec": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Simple specification file for surface to use with suma commands."
    }
  },
  "required": [
    "root",
    "erosion_depth",
    "erosion_thick",
    "erosion_thick_smooth",
    "erosion_thick_niml",
    "erosion_thick_smooth_niml",
    "maskset_output",
    "resampled_maskset",
    "anat_gii",
    "quick_spec"
  ]
}