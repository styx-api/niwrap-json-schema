{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "myget",
  "description": "A simple file downloader from a URL",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The filename to save the downloaded file"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}