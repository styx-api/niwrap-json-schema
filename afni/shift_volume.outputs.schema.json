{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@Shift_Volume",
  "description": "Tool to shift a dataset in the RAI coordinate system or between MNI anatomical space and MNI space.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Shifted output dataset."
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}