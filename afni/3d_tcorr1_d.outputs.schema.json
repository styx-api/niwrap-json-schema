{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dTcorr1D",
  "description": "Computes the correlation coefficient between each voxel time series in the input 3D+time dataset.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output filename prefix."
    }
  },
  "required": [
    "root",
    "out_file"
  ]
}