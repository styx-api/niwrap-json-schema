{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dREMLfit",
  "description": "Generalized least squares time series fit, with REML estimation of the temporal auto-correlation structure",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Main default output of 3dREMLfit"
    },
    "rvar_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "REML variance parameters"
    },
    "rbeta_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "REML beta weights"
    },
    "rbuck_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "REML estimates and statistics"
    },
    "rfitts_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "REML fitted model"
    },
    "rerrts_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "REML residuals"
    }
  },
  "required": [
    "root",
    "outfile",
    "rvar_file",
    "rbeta_file",
    "rbuck_file",
    "rfitts_file",
    "rerrts_file"
  ]
}