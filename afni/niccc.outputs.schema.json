{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "niccc",
  "description": "A program for conducting certain NIML tests on input from streamspec and write the results to stderr",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "stderr_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Results output to stderr"
    }
  },
  "required": [
    "root",
    "stderr_output"
  ]
}