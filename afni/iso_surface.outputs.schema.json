{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "IsoSurface",
  "description": "A program to perform isosurface extraction from a volume.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_surface_ply": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output isosurface in PLY format."
    },
    "output_surface_gii": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output isosurface in GIFTI format."
    },
    "output_surface_stl": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output isosurface in STL format."
    }
  },
  "required": [
    "root",
    "output_surface_ply",
    "output_surface_gii",
    "output_surface_stl"
  ]
}