{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dClusterize",
  "description": "A tool for voxelwise thresholding and clusterizing of datasets.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_map_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output map of cluster ROIs"
    },
    "out_data_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Cluster-masked version of the data volume"
    },
    "out_mask_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Utilized mask dataset"
    }
  },
  "required": [
    "root",
    "out_map_file",
    "out_data_file",
    "out_mask_file"
  ]
}