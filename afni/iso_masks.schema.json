{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@IsoMasks",
  "description": "Creates isosurfaces from isovolume envelopes.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@IsoMasks"
    },
    "input_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dataset for creating isosurfaces",
      "title": "Input Dataset"
    },
    "isovals": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Isovalue thresholds for creating isosurfaces",
      "title": "Isovalues"
    }
  },
  "required": [
    "@type",
    "input_dataset"
  ]
}