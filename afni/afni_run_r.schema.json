{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "afni_run_R",
  "description": "Run an R script with the specified arguments",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/afni_run_R"
    },
    "r_script": {
      "type": "string",
      "x-styx-type": "path",
      "description": "R script to be executed",
      "title": "R Script"
    },
    "r_args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Arguments to be passed to the R script",
      "title": "R Script Arguments"
    }
  },
  "required": [
    "@type",
    "r_script",
    "r_args"
  ]
}