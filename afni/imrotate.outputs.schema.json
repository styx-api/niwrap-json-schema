{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "imrotate",
  "description": "Shifts and rotates an image",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_image_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Path to the output image file"
    }
  },
  "required": [
    "root",
    "output_image_file"
  ]
}