{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dBrainSync",
  "description": "'Synchronizes' the -inset2 dataset to match the -inset1 dataset, using orthogonal or permutation transformation.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "qprefix_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset after orthogonal matrix transformation"
    },
    "pprefix_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset after permutation transformation"
    },
    "qprefix_sval": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Singular values from the BC' decomposition"
    },
    "qprefix_qmat": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Q matrix"
    },
    "pprefix_perm": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Permutation indexes p(i)"
    }
  },
  "required": [
    "root",
    "qprefix_output",
    "pprefix_output",
    "qprefix_sval",
    "qprefix_qmat",
    "pprefix_perm"
  ]
}