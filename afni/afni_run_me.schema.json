{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@afni.run.me",
  "description": "A tool to execute a specific command",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@afni.run.me"
    },
    "go": {
      "type": "boolean",
      "description": "Execute the work",
      "title": "Go Flag",
      "default": false
    },
    "curl": {
      "type": "boolean",
      "description": "Default to curl instead of wget",
      "title": "Curl Flag",
      "default": false
    },
    "help": {
      "type": "boolean",
      "description": "Show help message",
      "title": "Help Flag",
      "default": false
    }
  },
  "required": [
    "@type"
  ]
}