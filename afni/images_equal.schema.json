{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "images_equal",
  "description": "A simple program to test if two 2D images are identical.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/images_equal"
    },
    "file_a": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First image file to compare.",
      "title": "File A"
    },
    "file_b": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Second image file to compare.",
      "title": "File B"
    },
    "all_flag": {
      "type": "boolean",
      "description": "Compare all images in the files; all must be equal for exit status to be 1.",
      "title": "All Images Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "file_a",
    "file_b"
  ]
}