{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "SurfMeasures",
  "description": "Compute measures from surface dataset(s)",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_1D": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output in 1D format"
    },
    "output_dset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output in specified dataset format"
    }
  },
  "required": [
    "root",
    "output_1D",
    "output_dset"
  ]
}