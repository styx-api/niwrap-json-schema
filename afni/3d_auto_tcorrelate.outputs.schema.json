{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dAutoTcorrelate",
  "description": "Computes the correlation coefficient between the time series of each pair of voxels in the input dataset",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_brick": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Main output dataset"
    },
    "output_head": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Header information for main output dataset"
    },
    "out1d_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output in 1D text format"
    }
  },
  "required": [
    "root",
    "output_brick",
    "output_head",
    "out1d_file"
  ]
}