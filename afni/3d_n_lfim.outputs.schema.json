{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dNLfim",
  "description": "Nonlinear regression for each voxel of the input AFNI 3d+time data set",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "freg_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "F-test for significance of the regression"
    },
    "frsqr_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "R^2 calculation for regression"
    },
    "fsmax_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Signed maximum signal estimate"
    },
    "ftmax_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Time of signed maximum estimate"
    },
    "fpsmax_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Maximum percentage change estimate"
    },
    "farea_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Area between signal and baseline"
    },
    "fparea_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Percentage area of signal estimate"
    },
    "fscoef_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Signal parameter estimate"
    },
    "fncoef_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Noise parameter estimate"
    },
    "tscoef_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "T-test for significance of signal parameter"
    },
    "tncoef_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "T-test for significance of noise parameter"
    },
    "bucket_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "AFNI 'bucket' dataset"
    },
    "sfit_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output 3d+time signal model fit"
    },
    "snfit_outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output 3d+time signal+noise fit"
    }
  },
  "required": [
    "root",
    "freg_outfile",
    "frsqr_outfile",
    "fsmax_outfile",
    "ftmax_outfile",
    "fpsmax_outfile",
    "farea_outfile",
    "fparea_outfile",
    "fscoef_outfile",
    "fncoef_outfile",
    "tscoef_outfile",
    "tncoef_outfile",
    "bucket_outfile",
    "sfit_outfile",
    "snfit_outfile"
  ]
}