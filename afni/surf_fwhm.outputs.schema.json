{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "SurfFWHM",
  "description": "A program for calculating local and global FWHM.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "detrended_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Detrended dataset."
    },
    "main_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Main output dataset."
    },
    "histogram_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Histogram showing the distribution of local FWHM."
    },
    "mask_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Mask output dataset."
    }
  },
  "required": [
    "root",
    "detrended_output",
    "main_output",
    "histogram_output",
    "mask_output"
  ]
}