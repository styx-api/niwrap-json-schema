{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@GetAfniOrient",
  "description": "Returns the orient code of AFNI datasets",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@GetAfniOrient"
    },
    "exploratory": {
      "type": "boolean",
      "description": "Exploratory flag for additional functionalities",
      "title": "Exploratory flag",
      "default": false
    },
    "infile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input AFNI dataset (e.g. Hello+orig.HEAD)",
      "title": "Input file"
    }
  },
  "required": [
    "@type",
    "infile"
  ]
}