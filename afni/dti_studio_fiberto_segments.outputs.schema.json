{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "DTIStudioFibertoSegments",
  "description": "Convert a DTIStudio Fiber file to a SUMA segment file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_segment_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output SUMA segment file"
    }
  },
  "required": [
    "root",
    "output_segment_file"
  ]
}