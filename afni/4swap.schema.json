{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "4swap",
  "description": "Swaps byte quadruples on the listed files.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/4swap"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "List of files to process.",
      "title": "Input Files"
    },
    "quiet": {
      "type": "boolean",
      "description": "Work quietly; suppress output messages.",
      "title": "Quiet Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "files"
  ]
}