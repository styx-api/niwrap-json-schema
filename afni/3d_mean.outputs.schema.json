{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dMean",
  "description": "Takes the voxel-by-voxel mean of all input datasets; designed to be faster than 3dcalc.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}