{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@NoExt",
  "description": "Tool for removing specified extensions from filenames",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@NoExt"
    },
    "inputfile": {
      "type": "string",
      "description": "Input file name with extension",
      "title": "Input file"
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extensions to be removed",
      "title": "Extensions"
    }
  },
  "required": [
    "@type",
    "inputfile"
  ]
}