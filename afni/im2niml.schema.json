{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "im2niml",
  "description": "Converts the input image(s) to a text-based NIML element and writes the result to stdout.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/im2niml"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "Input image file(s) (e.g. image.jpg)",
      "title": "Input files"
    }
  },
  "required": [
    "@type",
    "input_files"
  ]
}