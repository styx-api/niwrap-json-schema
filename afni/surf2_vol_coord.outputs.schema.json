{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Surf2VolCoord",
  "description": "Relates node indices to coordinates given x y z coordinates and returns the nodes closest to them.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "results_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output results file."
    }
  },
  "required": [
    "root",
    "results_file"
  ]
}