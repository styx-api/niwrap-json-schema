{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@measure_in2out",
  "description": "Compute thickness of mask using in2out method.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "inout_dist": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Volumetric thickness/distance from in to out"
    },
    "in_and_out": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Volumetric distance to inside and outside in 2 volumes"
    },
    "inout_thick": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Unsmoothed thickness mapped to surface nodes"
    },
    "inout_thick_smooth": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Smoothed thickness mapped to surface nodes"
    },
    "maskset_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mask file"
    },
    "maskset_rs": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Resampled mask file"
    },
    "anat_gii": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Surface representation of mask volume"
    },
    "quick_spec": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Simple specification file for surface to use with suma commands"
    }
  },
  "required": [
    "root",
    "inout_dist",
    "in_and_out",
    "inout_thick",
    "inout_thick_smooth",
    "maskset_output",
    "maskset_rs",
    "anat_gii",
    "quick_spec"
  ]
}