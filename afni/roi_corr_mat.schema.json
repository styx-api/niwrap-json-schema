{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@ROI_Corr_Mat",
  "description": "Script to produce an NxN ROI correlation matrix of N ROIs",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@ROI_Corr_Mat"
    },
    "ts_vol": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Time series volume",
      "title": "TimeSeriesVol"
    },
    "roi_vol": {
      "type": "string",
      "x-styx-type": "path",
      "description": "ROI volume",
      "title": "ROIVol"
    },
    "prefix": {
      "type": "string",
      "description": "Use output for a prefix",
      "title": "Output Prefix"
    },
    "roisel": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Force processing of ROI label (integers) listed in ROISEL 1D file",
      "title": "ROISEL"
    },
    "zval": {
      "type": "boolean",
      "description": "Output a zscore version of the correlation matrix",
      "title": "Z-Value Flag",
      "default": false
    },
    "mat_opt": {
      "type": "string",
      "description": "Output matrix in different manners",
      "title": "Matrix Output Option"
    },
    "dirty": {
      "type": "boolean",
      "description": "Keep temporary files",
      "title": "Dirty Flag",
      "default": false
    },
    "keep_tmp": {
      "type": "boolean",
      "description": "Keep temporary files",
      "title": "Keep Temporary Files Flag",
      "default": false
    },
    "echo": {
      "type": "boolean",
      "description": "Set echo (echo all commands to screen)",
      "title": "Echo Flag",
      "default": false
    },
    "verb": {
      "type": "boolean",
      "description": "Verbose flag",
      "title": "Verbose Flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "ts_vol",
    "roi_vol",
    "prefix"
  ]
}