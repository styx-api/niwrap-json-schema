{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3dAcost",
  "description": "Allineate dataset to a base dataset",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/3dAcost"
    },
    "infile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dataset for allineation",
      "title": "Input file"
    },
    "basefile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Base dataset for allineation",
      "title": "Base file"
    },
    "outfile": {
      "type": "string",
      "description": "Prefix for the output dataset",
      "title": "Output file prefix"
    },
    "all_cost": {
      "type": "boolean",
      "description": "Prints all alignment cost metrics",
      "title": "Print all alignment cost metrics",
      "default": false
    }
  },
  "required": [
    "@type",
    "infile",
    "basefile",
    "outfile"
  ]
}