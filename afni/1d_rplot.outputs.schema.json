{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "1dRplot",
  "description": "Program for plotting a 1D file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_plot": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output plot file"
    }
  },
  "required": [
    "root",
    "output_plot"
  ]
}