{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@measure_bb_thick",
  "description": "Compute thickness of mask using ball and box method",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "maxfill": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Thickness/depth dataset"
    },
    "bb_thick": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Volumetric thickness dataset"
    },
    "bb_thick_smooth": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Smoothed volumetric thickness dataset"
    },
    "bb_thick_niml": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Unsmoothed thickness mapped to surface nodes"
    },
    "bb_thick_smooth_niml": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Smoothed thickness mapped to surface nodes"
    },
    "maskset_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Mask dataset"
    },
    "maskset_resampled": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Resampled mask dataset"
    },
    "anat_surface": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Surface representation of mask volume"
    },
    "quick_spec": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Simple specification file for surface to use with suma commands"
    }
  },
  "required": [
    "root",
    "maxfill",
    "bb_thick",
    "bb_thick_smooth",
    "bb_thick_niml",
    "bb_thick_smooth_niml",
    "maskset_output",
    "maskset_resampled",
    "anat_surface",
    "quick_spec"
  ]
}