{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "quickspec",
  "description": "A quick and dirty way of loading a surface into SUMA or command line programs using a spec file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_specfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "The spec file output."
    }
  },
  "required": [
    "root",
    "out_specfile"
  ]
}