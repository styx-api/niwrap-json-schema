{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dVecRGB_to_HSL",
  "description": "Convert a 3-brick RGB (red, green, blue) data set to an HSL (hue, saturation, luminance) one.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_hsl_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output HSL dataset"
    }
  },
  "required": [
    "root",
    "output_hsl_dataset"
  ]
}