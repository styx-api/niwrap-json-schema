{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dtoXdataset",
  "description": "Convert input datasets to the format needed for 3dClustSimX",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_sdat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file in .sdat format"
    }
  },
  "required": [
    "root",
    "output_sdat"
  ]
}