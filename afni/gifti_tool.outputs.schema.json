{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "gifti_tool",
  "description": "Tool for creating, displaying, modifying, or comparing GIFTI datasets.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_gifti": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output GIFTI file"
    }
  },
  "required": [
    "root",
    "output_gifti"
  ]
}