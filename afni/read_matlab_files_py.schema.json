{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "read_matlab_files.py",
  "description": "Describe or convert MATLAB files (.mat) to 1D format",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/read_matlab_files.py"
    },
    "infiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Input MATLAB files to be processed",
      "title": "Input files"
    },
    "prefix": {
      "type": "string",
      "description": "Prefix for output file names",
      "title": "Output file prefix"
    },
    "overwrite": {
      "type": "boolean",
      "description": "Overwrite any existing output files",
      "title": "Overwrite flag",
      "default": false
    },
    "help": {
      "type": "boolean",
      "description": "Show help message",
      "title": "Help flag",
      "default": false
    },
    "history": {
      "type": "boolean",
      "description": "Show revision history",
      "title": "History flag",
      "default": false
    },
    "version": {
      "type": "boolean",
      "description": "Show version number",
      "title": "Version flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "infiles"
  ]
}