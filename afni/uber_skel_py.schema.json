{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uber_skel.py",
  "description": "Sample uber processing program for initializing user and control variables, with options for both GUI and non-GUI modes.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/uber_skel.py"
    },
    "qt_options": {
      "type": "string",
      "description": "Pass PyQt4 options directly to the GUI",
      "title": "Qt Options"
    },
    "no_gui_flag": {
      "type": "boolean",
      "description": "Run without the GUI",
      "title": "No GUI Flag",
      "default": false
    },
    "print_script": {
      "type": "boolean",
      "description": "Print the script",
      "title": "Print Script Flag",
      "default": false
    },
    "save_script": {
      "type": "string",
      "description": "Save the script",
      "title": "Save Script"
    },
    "user_var": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Initialize user variables. Usage: -uvar <name> <value>",
      "title": "User Variable"
    },
    "help_howto_program": {
      "type": "boolean",
      "description": "Show programming comments",
      "title": "Help How to Program Flag",
      "default": false
    },
    "help": {
      "type": "boolean",
      "description": "Show help",
      "title": "Help Flag",
      "default": false
    },
    "help_gui": {
      "type": "boolean",
      "description": "Show help for the GUI",
      "title": "Help GUI Flag",
      "default": false
    },
    "history": {
      "type": "boolean",
      "description": "Show history",
      "title": "History Flag",
      "default": false
    },
    "show_valid_opts": {
      "type": "boolean",
      "description": "Show valid options",
      "title": "Show Valid Options Flag",
      "default": false
    },
    "version": {
      "type": "boolean",
      "description": "Show version",
      "title": "Version Flag",
      "default": false
    }
  },
  "required": [
    "@type"
  ]
}