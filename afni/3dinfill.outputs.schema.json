  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dinfill",
  "description": "A program to fill holes in volumes.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_filled": {
      "type": [
        "string",
        "null"
