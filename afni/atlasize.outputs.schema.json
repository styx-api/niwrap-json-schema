{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@Atlasize",
  "description": "Script to turn a volumetric dataset into an AFNI atlas",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "niml_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Generated NIML file for the atlas"
    }
  },
  "required": [
    "root",
    "niml_file"
  ]
}