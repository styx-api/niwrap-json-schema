{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3drefit",
  "description": "Changes some of the information inside a 3D dataset's header",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file."
    },
    "in_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input file to 3drefit."
    }
  },
  "required": [
    "root",
    "out_file",
    "in_file"
  ]
}