{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dIntracranial",
  "description": "Performs automatic segmentation of intracranial region.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "segmented_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file containing segmented image"
    }
  },
  "required": [
    "root",
    "segmented_image"
  ]
}