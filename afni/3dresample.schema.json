{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3dresample",
  "description": "Resample or reorient an image using AFNI 3dresample command",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/3dresample"
    },
    "in_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input file to 3dresample.",
      "title": "In file"
    },
    "master": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Align dataset grid to a reference file.",
      "title": "Master"
    },
    "orientation": {
      "enum": [
        "AIL",
        "AIR",
        "ASL",
        "ASR",
        "PIL",
        "PIR",
        "PSL",
        "PSR",
        "ALI",
        "ALS",
        "ARI",
        "ARS",
        "PLI",
        "PLS",
        "PRI",
        "PRS",
        "IAL",
        "IAR",
        "IPL",
        "IPR",
        "SAL",
        "SAR",
        "SPL",
        "SPR",
        "ILA",
        "ILP",
        "IRA",
        "IRP",
        "SLA",
        "SLP",
        "SRA",
        "SRP",
        "LAI",
        "LAS",
        "LPI",
        "LPS",
        "RAI",
        "RAS",
        "RPI",
        "RPS",
        "LIA",
        "LIP",
        "LSA",
        "LSP",
        "RIA",
        "RIP",
        "RSA",
        "RSP"
      ],
      "description": "New orientation code.",
      "title": "Orientation"
    },
    "prefix": {
      "type": "string",
      "description": "required prefix for output dataset",
      "title": "Output prefix"
    },
    "outputtype": {
      "enum": [
        "NIFTI",
        "AFNI",
        "NIFTI_GZ"
      ],
      "description": "'nifti' or 'afni' or 'nifti_gz'. Afni output filetype.",
      "title": "Outputtype"
    },
    "resample_mode": {
      "enum": [
        "NN",
        "Li",
        "Cu",
        "Bk"
      ],
      "description": "'nn' or 'li' or 'cu' or 'bk'. Resampling method from set {\"nn\", \"li\", \"cu\", \"bk\"}. these are for \"nearest neighbor\", \"linear\", \"cubic\" and \"blocky\"interpolation, respectively. default is nn.",
      "title": "Resample mode"
    },
    "voxel_size": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "(a float, a float, a float). Resample to new dx, dy and dz.",
      "title": "Voxel size"
    }
  },
  "required": [
    "@type",
    "in_file",
    "prefix"
  ]
}