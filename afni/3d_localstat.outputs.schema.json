{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dLocalstat",
  "description": "This program computes statistics at each voxel, based on a local neighborhood of that voxel",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset"
    }
  },
  "required": [
    "root",
    "outfile"
  ]
}