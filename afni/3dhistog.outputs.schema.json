{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dhistog",
  "description": "Compute histogram of a 3D dataset",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "histogram_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Histogram output when -prefix option is used"
    }
  },
  "required": [
    "root",
    "histogram_output"
  ]
}