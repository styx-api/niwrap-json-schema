{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@TimeDiff",
  "description": "A tool to compare the modification times of two files",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@TimeDiff"
    },
    "file1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First file to compare (e.g., file1.txt)",
      "title": "File 1"
    },
    "file2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Second file to compare (e.g., file2.txt)",
      "title": "File 2"
    }
  },
  "required": [
    "@type",
    "file1",
    "file2"
  ]
}