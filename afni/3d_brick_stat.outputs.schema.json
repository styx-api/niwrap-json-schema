{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dBrickStat",
  "description": "Compute voxel statistics of an input dataset",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "console_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Console output of computed statistics"
    }
  },
  "required": [
    "root",
    "console_output"
  ]
}