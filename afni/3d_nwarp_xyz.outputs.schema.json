{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dNwarpXYZ",
  "description": "Transforms the DICOM xyz coordinates in the input XYZfile.1D based on specified warp.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Warped XYZ coordinates output file"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}