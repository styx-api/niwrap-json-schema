{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "djpeg",
  "description": "Decompress a JPEG file to an image file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output image file"
    }
  },
  "required": [
    "root",
    "output_image"
  ]
}