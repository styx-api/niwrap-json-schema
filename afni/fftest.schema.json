{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fftest",
  "description": "A command line tool for testing purposes",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/fftest"
    },
    "length": {
      "type": "number",
      "description": "Length of the test",
      "title": "Length"
    },
    "num_tests": {
      "type": "number",
      "description": "Number of tests to run",
      "title": "Number of Tests"
    },
    "vector_size": {
      "type": "number",
      "description": "Vector size for the test",
      "title": "Vector Size"
    },
    "quiet_mode": {
      "type": "boolean",
      "description": "Quiet mode",
      "title": "Quiet Mode",
      "default": false
    }
  },
  "required": [
    "@type",
    "length",
    "num_tests",
    "vector_size"
  ]
}