{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "SurfToSurf",
  "description": "Interpolate data from one surface to another",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output file in 1D format"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}