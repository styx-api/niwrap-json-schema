{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@thickness_master",
  "description": "Compute cortical thickness using mask and surface datasets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_bb_dir": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output directory for ball and box method"
    },
    "output_erode_dir": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output directory for erosion method"
    },
    "output_in2out_dir": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output directory for in2out method"
    }
  },
  "required": [
    "root",
    "output_bb_dir",
    "output_erode_dir",
    "output_in2out_dir"
  ]
}