{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "immask",
  "description": "Masks the input image based on specified criteria and produces the output image",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Masked output image"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}