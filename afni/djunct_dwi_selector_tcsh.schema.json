{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@djunct_dwi_selector.tcsh",
  "description": "Selects DWI data and creates a representative image.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@djunct_dwi_selector.tcsh"
    },
    "dwi": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input DWI file",
      "title": "DWI Input"
    },
    "png": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output PNG image",
      "title": "PNG Image"
    },
    "outfile": {
      "type": "string",
      "description": "Path to the output file",
      "title": "Output File"
    }
  },
  "required": [
    "@type",
    "dwi",
    "png",
    "outfile"
  ]
}