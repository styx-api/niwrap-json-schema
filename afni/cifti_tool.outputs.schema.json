{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cifti_tool",
  "description": "Example tool for reading/writing CIFTI-2 datasets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output file for results"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}