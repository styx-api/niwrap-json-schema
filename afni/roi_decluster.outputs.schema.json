{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@ROI_decluster",
  "description": "Script to remove small clusters or standalone voxels from an ROI/atlas dataset",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Final output dataset"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}