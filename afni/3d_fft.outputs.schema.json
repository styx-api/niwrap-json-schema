{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dFFT",
  "description": "Performs the FFT of the input dataset in 3 directions (x, y, z) and produces the output dataset.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset generated by 3dFFT."
    }
  },
  "required": [
    "root",
    "output_dataset"
  ]
}