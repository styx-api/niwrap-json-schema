{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTIStudioFibertoSegments",
  "description": "Convert a DTIStudio Fiber file to a SUMA segment file",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/DTIStudioFibertoSegments"
    },
    "dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dataset file",
      "title": "Dataset file"
    },
    "output_file": {
      "type": "string",
      "description": "Name of the output file (default is rawxyzseg.dat)",
      "title": "Output file"
    },
    "swap_flag": {
      "type": "boolean",
      "description": "Swap bytes in data",
      "title": "Swap bytes flag",
      "default": false
    }
  },
  "required": [
    "@type",
    "dataset"
  ]
}