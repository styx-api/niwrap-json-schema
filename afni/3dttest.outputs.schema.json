{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dttest++",
  "description": "Gosset (Student) t-test of sets of 3D datasets in AFNI",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outFile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Main output dataset"
    },
    "residuals": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output residuals dataset"
    }
  },
  "required": [
    "root",
    "outFile",
    "residuals"
  ]
}