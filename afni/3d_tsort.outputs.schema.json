{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dTsort",
  "description": "Sorts each voxel in a dataset and produces a new dataset.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Main default output of 3dTsort"
    }
  },
  "required": [
    "root",
    "output_dataset"
  ]
}