{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "im2niml",
  "description": "Converts the input image(s) to a text-based NIML element and writes the result to stdout.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "niml_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "NIML element"
    }
  },
  "required": [
    "root",
    "niml_output"
  ]
}