{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "1dAstrip",
  "description": "Strips non-numeric characters from a file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file with only numeric characters."
    }
  },
  "required": [
    "root",
    "outfile"
  ]
}