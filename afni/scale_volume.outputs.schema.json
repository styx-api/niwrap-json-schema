{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@ScaleVolume",
  "description": "A tool to scale the volume of datasets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output scaled dataset"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}