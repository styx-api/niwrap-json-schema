{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cjpeg",
  "description": "Compresses an image file to a JPEG file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The output JPEG file"
    }
  },
  "required": [
    "root",
    "outfile"
  ]
}