{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "nifti_tool",
  "description": "Display, modify, or compare nifti headers",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "The nifti file generated as output."
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}