  "type": "object",
  "title": "SurfLocalstat",
  "description": "Compute local statistics on a surface mesh",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
