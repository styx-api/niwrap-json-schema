{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@isOblique",
  "description": "Determine if a file is oblique or plumb",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@isOblique"
    },
    "infile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input file (e.g., Hello+orig.HEAD)",
      "title": "Input file"
    }
  },
  "required": [
    "@type",
    "infile"
  ]
}