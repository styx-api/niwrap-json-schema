{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@GetAfniDims",
  "description": "A utility tool to return dimensions of AFNI dataset",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@GetAfniDims"
    },
    "input_dset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input AFNI dataset",
      "title": "Input dataset"
    }
  },
  "required": [
    "@type",
    "input_dset"
  ]
}