{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dTfilter",
  "description": "3dTfilter filters the time series in each voxel according to the user-specified filter functions.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filtered output dataset"
    }
  },
  "required": [
    "root",
    "output_dataset"
  ]
}