{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dGenPriors",
  "description": "Produces classification priors based on voxel signatures.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_cprefix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Main classification output"
    },
    "out_pprefix": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Main probability output"
    }
  },
  "required": [
    "root",
    "out_cprefix",
    "out_pprefix"
  ]
}