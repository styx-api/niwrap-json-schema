{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dPAR2AFNI.pl",
  "description": "Convert Philips PAR/REC files to AFNI's BRIK/HEAD, NIfTI, or ANALYZE format",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_files": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Converted output files"
    }
  },
  "required": [
    "root",
    "output_files"
  ]
}