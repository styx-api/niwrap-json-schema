{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dUndump",
  "description": "Assembles a 3D dataset from an ASCII list of coordinates and optionally values.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Main output dataset"
    }
  },
  "required": [
    "root",
    "outfile"
  ]
}