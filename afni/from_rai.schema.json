{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@FromRAI",
  "description": "Changes the RAI coordinates to the specified orientation",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@FromRAI"
    },
    "rai_coordinates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "required": [
    "@type",
    "rai_coordinates"
  ]
}