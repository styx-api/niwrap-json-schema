{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@Center_Distance",
  "description": "Tool to calculate the distance between the centers of two datasets",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@Center_Distance"
    },
    "dset1": {
      "type": "string",
      "x-styx-type": "path",
      "description": "First dataset file (e.g. file1.nii.gz)",
      "title": "Dataset 1"
    },
    "dset2": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Second dataset file (e.g. file2.nii.gz)",
      "title": "Dataset 2"
    }
  },
  "required": [
    "@type",
    "dset1",
    "dset2"
  ]
}