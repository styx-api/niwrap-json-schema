{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dAcost",
  "description": "Allineate dataset to a base dataset",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_head": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output aligned dataset (HEAD file)"
    },
    "output_brik": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output aligned dataset (BRIK file)"
    }
  },
  "required": [
    "root",
    "output_head",
    "output_brik"
  ]
}