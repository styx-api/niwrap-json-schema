{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dQwarp",
  "description": "Computes a nonlinearly warped version of source_dataset to match base_dataset.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "warped_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Warped dataset"
    },
    "warp_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Warp dataset"
    },
    "inverse_warp_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Inverse warp dataset"
    }
  },
  "required": [
    "root",
    "warped_dataset",
    "warp_dataset",
    "inverse_warp_dataset"
  ]
}