{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "make_pq_script.py",
  "description": "Creates a script to compute p-value and q-value curves.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/make_pq_script.py"
    },
    "dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dataset (no sub-brick selectors)",
      "title": "Input dataset"
    },
    "brick_index": {
      "type": "number",
      "description": "Volume sub-brick for specific t-stat",
      "title": "Brick Index"
    },
    "mask": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Mask volume dataset",
      "title": "Mask dataset"
    },
    "out_script": {
      "type": "string",
      "description": "Name for output script to write",
      "title": "Output script"
    }
  },
  "required": [
    "@type",
    "dataset",
    "brick_index",
    "mask",
    "out_script"
  ]
}