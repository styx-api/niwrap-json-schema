{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dConformist",
  "description": "Program to conform a collection of datasets to the same size by zero padding",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_files": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Zero padded output dataset files"
    }
  },
  "required": [
    "root",
    "output_files"
  ]
}