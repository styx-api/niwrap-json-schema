{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "2swap",
  "description": "Swaps byte pairs on the files listed",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/2swap"
    },
    "quiet": {
      "type": "boolean",
      "description": "Work quietly",
      "title": "Quiet flag",
      "default": false
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "string",
        "x-styx-type": "path"
      },
      "description": "Input files",
      "title": "Input files"
    }
  },
  "required": [
    "@type",
    "input_files"
  ]
}