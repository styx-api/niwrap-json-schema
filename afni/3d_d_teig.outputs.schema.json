{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dDTeig",
  "description": "Computes eigenvalues and eigenvectors for an input dataset of tensors",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset with computed eigenvalues, eigenvectors, FA, and MD"
    },
    "output_lambda": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset for eigenvalues"
    },
    "output_eigvec": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset for eigenvectors"
    },
    "output_fa": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset for fractional anisotropy"
    },
    "output_md": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset for mean diffusivity"
    }
  },
  "required": [
    "root",
    "output_dataset",
    "output_lambda",
    "output_eigvec",
    "output_fa",
    "output_md"
  ]
}