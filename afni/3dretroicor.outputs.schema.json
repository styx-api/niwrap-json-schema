{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dretroicor",
  "description": "Performs Retrospective Image Correction for physiological motion effects using a modified RETROICOR algorithm",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "corrected_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Corrected dataset output."
    },
    "output_cardiac_phase": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Cardiac phase output file."
    },
    "output_resp_phase": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Respiratory phase output file."
    }
  },
  "required": [
    "root",
    "corrected_dataset",
    "output_cardiac_phase",
    "output_resp_phase"
  ]
}