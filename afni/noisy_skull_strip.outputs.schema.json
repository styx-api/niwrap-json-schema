{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@NoisySkullStrip",
  "description": "Strips the skull of anatomical datasets with low SNR.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "anat_ns": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Skull stripped version of ANAT"
    },
    "anat_air": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Special mask output - air"
    },
    "anat_skl": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Special mask output - skull"
    },
    "anat_lsp": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Volume used to threshold 'air' out of the volume to be stripped"
    }
  },
  "required": [
    "root",
    "anat_ns",
    "anat_air",
    "anat_skl",
    "anat_lsp"
  ]
}