{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "1dsound",
  "description": "Program to create a sound file from a 1D file (column of numbers).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "The output audio file."
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}