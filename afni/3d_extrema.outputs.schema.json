{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dExtrema",
  "description": "Find local extrema (minima or maxima) in 3D datasets.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_head_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output HEAD file"
    },
    "output_brik_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output BRIK file"
    }
  },
  "required": [
    "root",
    "output_head_file",
    "output_brik_file"
  ]
}