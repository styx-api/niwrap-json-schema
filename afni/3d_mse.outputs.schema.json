{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dMSE",
  "description": "Computes voxelwise multi-scale entropy",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_brik": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset in BRIK format."
    },
    "out_head": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset in HEAD format."
    }
  },
  "required": [
    "root",
    "out_brik",
    "out_head"
  ]
}