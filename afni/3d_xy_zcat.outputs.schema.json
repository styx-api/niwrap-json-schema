{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dXYZcat",
  "description": "Catenates datasets spatially.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_brainfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output concatenated dataset."
    },
    "output_headerfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output concatenated dataset header."
    }
  },
  "required": [
    "root",
    "output_brainfile",
    "output_headerfile"
  ]
}