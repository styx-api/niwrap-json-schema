{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "p2dsetstat",
  "description": "Convert a p-value to a statistic of choice with reference to a specific dataset.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "stat_value": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The converted statistic value."
    }
  },
  "required": [
    "root",
    "stat_value"
  ]
}