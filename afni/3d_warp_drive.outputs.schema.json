{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dWarpDrive",
  "description": "Warp a dataset to match another one (the base) using an affine transformation.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Warped dataset output"
    },
    "output_summary": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Summary of calculations"
    },
    "oned_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with warping parameters"
    },
    "matrix_output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with transformation matrices"
    }
  },
  "required": [
    "root",
    "output_dataset",
    "output_summary",
    "oned_output_file",
    "matrix_output_file"
  ]
}