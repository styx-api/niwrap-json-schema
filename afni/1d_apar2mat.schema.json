{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1dApar2mat",
  "description": "Computes the affine transformation matrix from the set of 3dAllineate parameters.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/1dApar2mat"
    },
    "x_shift": {
      "type": "number",
      "description": "x-shift in mm",
      "title": "X Shift"
    },
    "y_shift": {
      "type": "number",
      "description": "y-shift in mm",
      "title": "Y Shift"
    },
    "z_shift": {
      "type": "number",
      "description": "z-shift in mm",
      "title": "Z Shift"
    },
    "z_angle": {
      "type": "number",
      "description": "z-angle (roll) in degrees",
      "title": "Z Angle"
    },
    "x_angle": {
      "type": "number",
      "description": "x-angle (pitch) in degrees",
      "title": "X Angle"
    },
    "y_angle": {
      "type": "number",
      "description": "y-angle (yaw) in degrees",
      "title": "Y Angle"
    },
    "x_scale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10,
      "description": "x-scale factor in [0.10,10.0]",
      "title": "X Scale"
    },
    "y_scale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10,
      "description": "y-scale factor in [0.10,10.0]",
      "title": "Y Scale"
    },
    "z_scale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10,
      "description": "z-scale factor in [0.10,10.0]",
      "title": "Z Scale"
    },
    "y_x_shear": {
      "type": "number",
      "minimum": -0.3333,
      "maximum": 0.3333,
      "description": "y/x-shear factor in [-0.3333,0.3333]",
      "title": "Y/X Shear"
    },
    "z_x_shear": {
      "type": "number",
      "minimum": -0.3333,
      "maximum": 0.3333,
      "description": "z/x-shear factor in [-0.3333,0.3333]",
      "title": "Z/X Shear"
    },
    "z_y_shear": {
      "type": "number",
      "minimum": -0.3333,
      "maximum": 0.3333,
      "description": "z/y-shear factor in [-0.3333,0.3333]",
      "title": "Z/Y Shear"
    }
  },
  "required": [
    "@type",
    "x_shift",
    "y_shift",
    "z_shift",
    "z_angle",
    "x_angle",
    "y_angle",
    "x_scale",
    "y_scale",
    "z_scale",
    "y_x_shear",
    "z_x_shear",
    "z_y_shear"
  ]
}