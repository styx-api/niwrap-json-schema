{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fat_proc_filter_dwis",
  "description": "Filter out user-found and user-defined bad volumes from DWI data sets.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "filtered_dwi": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filtered 4D DWI dataset."
    },
    "filtered_bvecs": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filtered gradient file matching input format."
    },
    "filtered_bvals": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Filtered b-values file, if provided."
    }
  },
  "required": [
    "root",
    "filtered_dwi",
    "filtered_bvecs",
    "filtered_bvals"
  ]
}