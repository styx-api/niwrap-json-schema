{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@compute_OC_weights",
  "description": "Compute optimal combined weights dataset for multi-echo EPI data.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_oc_weights": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Resulting OC weights dataset"
    }
  },
  "required": [
    "root",
    "output_oc_weights"
  ]
}