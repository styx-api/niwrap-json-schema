{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dThreetoRGB",
  "description": "Converts 3 sub-bricks of input to an RGB-valued dataset.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset_head": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "RGB-valued dataset output"
    },
    "output_dataset_brik": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "RGB-valued dataset output"
    }
  },
  "required": [
    "root",
    "output_dataset_head",
    "output_dataset_brik"
  ]
}