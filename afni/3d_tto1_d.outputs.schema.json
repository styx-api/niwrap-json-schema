{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dTto1D",
  "description": "Collapse a 4D time series to a 1D time series",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output 1D time series file"
    }
  },
  "required": [
    "root",
    "output_file"
  ]
}