{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "1dsvd",
  "description": "Computes SVD of the matrix formed by the 1D file(s) and outputs the result on stdout.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "stdout": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of the SVD computation"
    }
  },
  "required": [
    "root",
    "stdout"
  ]
}