  "type": "object",
  "title": "3dEmpty",
  "description": "Tool to create an 'empty' dataset .HEAD file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": [
        "string",
