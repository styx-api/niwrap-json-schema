{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@ToRAI",
  "description": "Tool to change the ORIENT coordinates to RAI",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@ToRAI"
    },
    "coordinates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "required": [
    "@type",
    "coordinates"
  ]
}