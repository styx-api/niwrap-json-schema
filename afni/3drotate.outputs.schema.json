{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3drotate",
  "description": "Rotates and/or translates all bricks from an AFNI dataset.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_head": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset header file"
    },
    "out_brick": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset brick file"
    }
  },
  "required": [
    "root",
    "out_head",
    "out_brick"
  ]
}