{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "imupsam",
  "description": "Upsamples a 2D image by a specified factor",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_image_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Upsampled image output file"
    }
  },
  "required": [
    "root",
    "output_image_file"
  ]
}