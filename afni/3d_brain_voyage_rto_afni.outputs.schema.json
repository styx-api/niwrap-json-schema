{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dBRAIN_VOYAGERtoAFNI",
  "description": "Converts a BrainVoyager vmr dataset to AFNI's BRIK format based on information from BrainVoyager's website.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_brik_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output BRIK file"
    },
    "output_head_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output HEAD file"
    }
  },
  "required": [
    "root",
    "output_brik_file",
    "output_head_file"
  ]
}