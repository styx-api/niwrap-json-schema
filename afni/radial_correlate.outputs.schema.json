{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@radial_correlate",
  "description": "Check datasets for correlation artifacts",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "corr_volumes": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Directory containing correlation volumes"
    }
  },
  "required": [
    "root",
    "corr_volumes"
  ]
}