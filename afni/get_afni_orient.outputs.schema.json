{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@GetAfniOrient",
  "description": "Returns the orient code of AFNI datasets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_orient_code": {
      "type": "string",
      "x-styx-type": "path",
      "description": "File containing the orientation code"
    }
  },
  "required": [
    "root",
    "output_orient_code"
  ]
}