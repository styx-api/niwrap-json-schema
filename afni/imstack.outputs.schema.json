{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "imstack",
  "description": "Stacks up a set of 2D images into one big file (a la MGH).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_data_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output data file"
    },
    "output_header_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output header file"
    }
  },
  "required": [
    "root",
    "output_data_file",
    "output_header_file"
  ]
}