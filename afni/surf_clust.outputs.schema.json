{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "SurfClust",
  "description": "A program to perform clustering analysis surfaces",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "cluster_table": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Cluster table output"
    },
    "clustered_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Clustered version of input dataset"
    },
    "roi_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "ROI dataset with rank of clusters"
    }
  },
  "required": [
    "root",
    "cluster_table",
    "clustered_dataset",
    "roi_dataset"
  ]
}