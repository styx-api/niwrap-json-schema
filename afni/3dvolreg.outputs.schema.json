{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dvolreg",
  "description": "Register input volumes to a base volume using AFNI 3dvolreg command",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "md1d_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Max displacement output file."
    },
    "oned_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "1d movement parameters output file."
    },
    "oned_matrix_save": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Save the matrix transformation."
    },
    "out_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Registered file."
    }
  },
  "required": [
    "root",
    "md1d_file",
    "oned_file",
    "oned_matrix_save",
    "out_file"
  ]
}