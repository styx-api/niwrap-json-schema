{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "read_matlab_files.py",
  "description": "Describe or convert MATLAB files (.mat) to 1D format",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "converted_1d_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Converted 1D format file"
    }
  },
  "required": [
    "root",
    "converted_1d_file"
  ]
}