{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "help_format",
  "description": "Formats text by converting URLs into HTML hyperlinks",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "formatted_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "The formatted text with hyperlinks"
    }
  },
  "required": [
    "root",
    "formatted_output"
  ]
}