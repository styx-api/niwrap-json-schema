{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "to3d",
  "description": "Creates 3D datasets for use with AFNI from 2D image files",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "headfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output AFNI HEAD file"
    },
    "brikfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output AFNI BRIK file"
    },
    "outfile_outliers": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Outlier count file"
    }
  },
  "required": [
    "root",
    "headfile",
    "brikfile",
    "outfile_outliers"
  ]
}