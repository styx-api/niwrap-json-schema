{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "imreg",
  "description": "Registers each 2D image in 'image_sequence' to 'base_image'",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "registered_images": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Registered images"
    },
    "dx_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Time series dx file"
    },
    "dy_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Time series dy file"
    },
    "phi_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Time series phi file"
    }
  },
  "required": [
    "root",
    "registered_images",
    "dx_file",
    "dy_file",
    "phi_file"
  ]
}