{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dAFNItoNIFTI",
  "description": "Converts an AFNI dataset to a NIfTI-1.1 file.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_nifti": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output NIfTI file."
    }
  },
  "required": [
    "root",
    "output_nifti"
  ]
}