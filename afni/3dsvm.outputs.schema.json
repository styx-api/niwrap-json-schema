{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dsvm",
  "description": "Support vector machine analysis of brain data using the SVM-light package",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_model": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output model file in .1D format."
    },
    "out_alpha": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output alphas file in .1D format."
    },
    "out_bucket": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output bucket file in .1D format."
    },
    "out_predictions": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output predictions file in .1D format."
    }
  },
  "required": [
    "root",
    "out_model",
    "out_alpha",
    "out_bucket",
    "out_predictions"
  ]
}