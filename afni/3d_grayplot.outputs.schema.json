{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dGrayplot",
  "description": "Make a grayplot from a 3D+time dataset, like a carpet plot. Result is saved to a PNG image.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "grayplot_img": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Grayplot image file"
    }
  },
  "required": [
    "root",
    "grayplot_img"
  ]
}