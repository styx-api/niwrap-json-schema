{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dpc",
  "description": "Principal Component Analysis of 3D Datasets",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset file"
    },
    "output_header": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output dataset header file"
    },
    "output_eig": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with computed eigenvalues"
    },
    "output_vec": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with all eigen-timeseries"
    },
    "output_individual_vec": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "File with individual eigenvalue timeseries"
    }
  },
  "required": [
    "root",
    "output_dataset",
    "output_header",
    "output_eig",
    "output_vec",
    "output_individual_vec"
  ]
}