{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dLMEr",
  "description": "Program for Voxelwise Linear Mixed-Effects (LME) Analysis",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file"
    },
    "residuals_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output residuals file"
    }
  },
  "required": [
    "root",
    "output_file",
    "residuals_file"
  ]
}