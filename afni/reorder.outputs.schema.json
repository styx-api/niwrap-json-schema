{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@Reorder",
  "description": "Reorder sub-bricks of a dataset based on event mapping. Works similarly to the Reorder plugin.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Reordered output dataset"
    }
  },
  "required": [
    "root",
    "output_dataset"
  ]
}