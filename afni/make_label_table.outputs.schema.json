{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@MakeLabelTable",
  "description": "Script used to create, modify, and transform label tables",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_labeltable": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output label table file"
    },
    "output_atlas_pointlist": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output atlas point list file"
    },
    "output_csv": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output CSV file from label table"
    },
    "output_niml_atlas": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output NIML file after atlasizing labeled dataset"
    }
  },
  "required": [
    "root",
    "output_labeltable",
    "output_atlas_pointlist",
    "output_csv",
    "output_niml_atlas"
  ]
}