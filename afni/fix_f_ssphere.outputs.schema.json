{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@fix_FSsphere",
  "description": "Tool for fixing errors in FreeSurfer spherical surfaces",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "corrected_surface": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Corrected surface"
    }
  },
  "required": [
    "root",
    "corrected_surface"
  ]
}