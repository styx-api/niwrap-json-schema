{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "timing_tool.py",
  "description": "Tool for manipulating and evaluating stimulus timing files",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_timing_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output timing file as specified"
    },
    "timing_to_1D_output": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output 1D formatted stimulus data"
    }
  },
  "required": [
    "root",
    "output_timing_file",
    "timing_to_1D_output"
  ]
}