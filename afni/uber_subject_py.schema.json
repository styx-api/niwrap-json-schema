{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uber_subject.py",
  "description": "Graphical interface to afni_proc.py",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/uber_subject.py"
    },
    "qt_opts": {
      "type": "string",
      "description": "Pass options to PyQt4",
      "title": "Qt Options"
    },
    "svar": {
      "type": "string",
      "description": "Set subject variable to value",
      "title": "Subject Variable"
    },
    "cvar": {
      "type": "string",
      "description": "Set control variable to value",
      "title": "Control Variable"
    },
    "no_gui": {
      "type": "boolean",
      "description": "Do not open graphical interface",
      "title": "No GUI Flag",
      "default": false
    },
    "print_ap_command": {
      "type": "boolean",
      "description": "Show afni_proc.py script",
      "title": "Print AP Command Flag",
      "default": false
    },
    "save_ap_command": {
      "type": "string",
      "description": "Save afni_proc.py script",
      "title": "Save AP Command"
    },
    "exec_ap_command": {
      "type": "boolean",
      "description": "Run afni_proc.py command",
      "title": "Exec AP Command Flag",
      "default": false
    },
    "exec_proc_script": {
      "type": "boolean",
      "description": "Run proc script",
      "title": "Exec Proc Script Flag",
      "default": false
    },
    "align_cost": {
      "type": "string",
      "description": "Specify cost function for anat/EPI alignment",
      "title": "Alignment Cost Function"
    },
    "align_giant_move": {
      "type": "string",
      "description": "Use -giant_move in AEA.py",
      "title": "Alignment Giant Move"
    },
    "align_opts_aea": {
      "type": "string",
      "description": "Specify extra options for align_epi_anat.py",
      "title": "Alignment Options for AEA"
    },
    "anal_domain": {
      "type": "string",
      "description": "Set data domain (volume/rest)",
      "title": "Data Domain"
    },
    "anal_type": {
      "type": "string",
      "description": "Set analysis type (task/rest)",
      "title": "Analysis Type"
    },
    "anat": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Set anatomical dataset name",
      "title": "Anatomical Dataset"
    },
    "anat_has_skull": {
      "type": "string",
      "description": "Whether anat has skull (yes/no)",
      "title": "Anatomical Dataset Skull"
    },
    "blocks": {
      "type": "string",
      "description": "Set list of processing blocks to apply",
      "title": "Processing Blocks"
    },
    "blur_size": {
      "type": "number",
      "description": "Set blur size in mm",
      "title": "Blur Size"
    },
    "epi": {
      "type": "string",
      "description": "Set list of EPI datasets",
      "title": "EPI Datasets"
    },
    "epi_wildcard": {
      "type": "string",
      "description": "Use wildcard for EPI datasets (yes/no)",
      "title": "EPI Wildcard"
    },
    "gid": {
      "type": "string",
      "description": "Set group ID",
      "title": "Group ID"
    },
    "gltsym": {
      "type": "string",
      "description": "Specify list of symbolic GLTs",
      "title": "Symbolic GLTs"
    },
    "gltsym_label": {
      "type": "string",
      "description": "Set corresponding GLT labels",
      "title": "Symbolic GLT Labels"
    },
    "motion_limit": {
      "type": "number",
      "description": "Set per-TR motion limit in mm",
      "title": "Motion Limit"
    },
    "outlier_limit": {
      "type": "number",
      "description": "Specify outlier limit for censoring",
      "title": "Outlier Limit"
    },
    "regress_GOFORIT": {
      "type": "number",
      "description": "Set GOFORIT level in 3dDeconvolve",
      "title": "Regress GOFORIT"
    },
    "regress_bandpass": {
      "type": "string",
      "description": "Specify bandpass limits to remain after regress",
      "title": "Regress Bandpass"
    },
    "regress_jobs": {
      "type": "number",
      "description": "Number of jobs to use in 3dDeconvolve",
      "title": "Regress Jobs"
    },
    "regress_mot_deriv": {
      "type": "string",
      "description": "Regress motion derivatives (yes/no)",
      "title": "Regress Motion Derivatives"
    },
    "regress_opts_3dD": {
      "type": "string",
      "description": "Specify extra options for 3dDeconvolve",
      "title": "Regress Options 3dD"
    },
    "reml_exec": {
      "type": "string",
      "description": "Run 3dREMLfit (yes/no)",
      "title": "REML Execution"
    },
    "run_clustsim": {
      "type": "string",
      "description": "Run 3dClustSim (yes/no)",
      "title": "Run ClustSim"
    },
    "sid": {
      "type": "string",
      "description": "Set subject ID",
      "title": "Subject ID"
    },
    "stim": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Set list of stim timing files",
      "title": "Stimulus Timing Files"
    },
    "stim_basis": {
      "type": "string",
      "description": "Set basis functions for stim classes",
      "title": "Stim Basis Functions"
    },
    "stim_label": {
      "type": "string",
      "description": "Set stim file labels",
      "title": "Stimulus File Labels"
    },
    "stim_type": {
      "type": "string",
      "description": "Set stim types for stim classes",
      "title": "Stimulus Types"
    },
    "stim_wildcard": {
      "type": "string",
      "description": "Use wildcard for stim files (yes/no)",
      "title": "Stimulus Wildcard"
    },
    "tcat_nfirst": {
      "type": "number",
      "description": "Set number of TRs to remove per run",
      "title": "Number of TRs to Remove"
    },
    "tlrc_base": {
      "type": "string",
      "description": "Specify anat for standard space alignment",
      "title": "Talarach Base"
    },
    "tlrc_ok_maxite": {
      "type": "string",
      "description": "Pass -OK_maxite to @auto_tlrc (yes/no)",
      "title": "Talarach OK Maxite"
    },
    "tlrc_opts_at": {
      "type": "string",
      "description": "Specify extra options for @auto_tlrc",
      "title": "Talarach Options AT"
    },
    "volreg_base": {
      "type": "string",
      "description": "Set volreg base string (first/third/last)",
      "title": "Volume Registration Base"
    },
    "verb": {
      "type": "string",
      "description": "Set verbose level",
      "title": "Verbose Level"
    }
  },
  "required": [
    "@type"
  ]
}