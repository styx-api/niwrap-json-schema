{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nsize",
  "description": "Zero pads an input image to the nearest larger NxN dimensions",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/nsize"
    },
    "image_in": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input image file",
      "title": "Input Image"
    },
    "image_out": {
      "type": "string",
      "description": "Output padded image file",
      "title": "Output Image"
    }
  },
  "required": [
    "@type",
    "image_in",
    "image_out"
  ]
}