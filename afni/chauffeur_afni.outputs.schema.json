{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@chauffeur_afni",
  "description": "Automated QC snapshots generator in AFNI",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "output_image": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Generated montage image"
    },
    "cluster_report": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Clusterization report"
    },
    "whereami_report": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Whereami report for clusterized data"
    }
  },
  "required": [
    "root",
    "output_image",
    "cluster_report",
    "whereami_report"
  ]
}