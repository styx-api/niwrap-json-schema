{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fim2",
  "description": "Functional Imaging Mapping Tool",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "activation_magnitudes": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Activation magnitudes output file"
    },
    "correlation_image": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Correlation image output file"
    },
    "contrast_to_noise_image": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Contrast-to-noise image output file"
    },
    "std_deviation_image": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Standard deviation image output file"
    },
    "ls_fit_coefficients": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Least squares fit coefficients image files"
    },
    "subtracted_references": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Subtracted ortho reference time series images"
    }
  },
  "required": [
    "root",
    "activation_magnitudes",
    "correlation_image",
    "contrast_to_noise_image",
    "std_deviation_image",
    "ls_fit_coefficients",
    "subtracted_references"
  ]
}