{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3dEntropy",
  "description": "Computes entropy for a 3D dataset",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/3dEntropy"
    },
    "zskip": {
      "type": "boolean",
      "description": "Skip 0 values in the entropy computation",
      "title": "Skip zero values flag",
      "default": false
    },
    "input_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dataset (stored as 16 bit shorts)",
      "title": "Input dataset"
    }
  },
  "required": [
    "@type",
    "input_dataset"
  ]
}