{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "@compute_gcor",
  "description": "Compute GCOR, the global correlation",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "corr_vol_brik": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output correlation volume BRIK file"
    },
    "corr_vol_head": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Output correlation volume HEAD file"
    }
  },
  "required": [
    "root",
    "corr_vol_brik",
    "corr_vol_head"
  ]
}