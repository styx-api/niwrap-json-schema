{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dTshift",
  "description": "Shifts voxel time series from input so that separate slices are aligned to the same temporal origin.",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Time-shifted output dataset."
    }
  },
  "required": [
    "root",
    "out_file"
  ]
}