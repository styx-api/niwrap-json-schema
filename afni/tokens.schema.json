{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tokens",
  "description": "Token counting tool",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/tokens"
    },
    "infile": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Specify input file (stdin if none)",
      "title": "Input file"
    },
    "extra_char": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specify extra character to count as valid. Can be used more than once.",
      "title": "Extra character"
    }
  },
  "required": [
    "@type"
  ]
}