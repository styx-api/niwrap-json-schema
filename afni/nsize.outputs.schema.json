{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "nsize",
  "description": "Zero pads an input image to the nearest larger NxN dimensions",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "image_out_file": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Zero padded output image file"
    }
  },
  "required": [
    "root",
    "image_out_file"
  ]
}