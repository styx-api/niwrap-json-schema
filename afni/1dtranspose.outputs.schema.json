{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "1dtranspose",
  "description": "Transpose an AFNI *.1D file (ASCII list of numbers arranged in columns).",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "outfile": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Transposed output file"
    }
  },
  "required": [
    "root",
    "outfile"
  ]
}