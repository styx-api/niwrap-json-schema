{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "file_tool",
  "description": "Program to display or modify sections of a file",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "modified_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "The modified output file"
    }
  },
  "required": [
    "root",
    "modified_file"
  ]
}