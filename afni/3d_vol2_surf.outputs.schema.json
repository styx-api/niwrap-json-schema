{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dVol2Surf",
  "description": "Map data from a volume domain to a surface domain",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "out_1d_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "1D output file"
    },
    "out_niml_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "NIML output file"
    },
    "seg_coords_file": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "Segment coordinates output file"
    }
  },
  "required": [
    "root",
    "out_1d_file",
    "out_niml_file",
    "seg_coords_file"
  ]
}