{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ap_run_simple_rest.tcsh",
  "description": "Run a quick afni_proc.py analysis for QC",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "run_ap_script": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "afni_proc.py command script"
    },
    "proc_script": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "proc script (if AP is run)"
    },
    "proc_results_dir": {
      "type": [
        "string",
        "null"
      ],
      "x-styx-type": "path",
      "description": "proc results directory (if run)"
    }
  },
  "required": [
    "root",
    "run_ap_script",
    "proc_script",
    "proc_results_dir"
  ]
}