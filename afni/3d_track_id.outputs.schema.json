{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "3dTrackID",
  "description": "FACTID-based tractography code for AFNI, part of FATCAT",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "indimap": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of INDIMAP"
    },
    "pairmap": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of PAIRMAP"
    },
    "grid": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Text file output of statistics of WM-ROIs"
    },
    "niml_tract": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Track-like output for viewing in SUMA"
    },
    "niml_dset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Dataset output for use with *.niml.tract"
    },
    "trk": {
      "type": "string",
      "x-styx-type": "path",
      "description": "TrackVis-like output for viewing in TrackVis"
    },
    "pairmap_labeltable": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of PAIRMAP labeltable"
    },
    "roi_labels": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output file of all ROI labels"
    },
    "option_values": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Output of all option values"
    }
  },
  "required": [
    "root",
    "indimap",
    "pairmap",
    "grid",
    "niml_tract",
    "niml_dset",
    "trk",
    "pairmap_labeltable",
    "roi_labels",
    "option_values"
  ]
}