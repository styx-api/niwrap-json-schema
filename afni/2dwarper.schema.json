{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@2dwarper",
  "description": "2D image warping tool",
  "type": "object",
  "properties": {
    "@type": {
      "const": "afni/@2dwarper"
    },
    "input_dataset": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Input dataset (e.g., image to be warped)",
      "title": "Input dataset"
    }
  },
  "required": [
    "@type",
    "input_dataset"
  ]
}