{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "1dcat",
  "description": "Concatenates columns of multiple 1D or TSV/CSV files",
  "properties": {
    "root": {
      "type": "string",
      "x-styx-type": "path"
    },
    "concatenated_output": {
      "type": "string",
      "x-styx-type": "path",
      "description": "Concatenated output in specified format"
    }
  },
  "required": [
    "root",
    "concatenated_output"
  ]
}